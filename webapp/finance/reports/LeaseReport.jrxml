    <parameter name="logoPath" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfIssueDate" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfLessor" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfLessee" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfAssets" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfAcquisitionCost" class="java.lang.String"/>
    <parameter name="FinanceLeasePdfResidual" class="java.lang.String"/>
