<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <!-- ============================================================= -->
    <!-- Lease product terms (STEP L1)                                 -->
    <!-- ============================================================= -->
    <form name="EditFinancialProductLease" type="single" target="updateFinancialProductLease" default-map-name="financialProductLease">
        <alt-target use-when="financialProductLease==null" target="createFinancialProductLease"/>
        <field name="productId"><hidden value="${productId}"/></field>
        <field use-when="financialProductLease!=null" name="leaseClassEnumId" title="${uiLabelMap.FinanceLeaseClass}">
            <display-entity entity-name="Enumeration" key-field-name="enumId" description="${description}"/>
        </field>
        <field use-when="financialProductLease==null" name="leaseClassEnumId"><ignored/></field>
        <field name="defaultMonthlyRateFactor" title="${uiLabelMap.FinanceLeaseMonthlyRateFactor}"><text size="12"/></field>
        <field name="defaultCalcInterestRate" title="${uiLabelMap.FinanceLeaseCalcInterestRate}"><text size="12"/></field>
        <field name="paymentTimingEnumId" title="${uiLabelMap.FinanceLeasePaymentTiming}">
            <drop-down allow-empty="false">
                <entity-options entity-name="Enumeration" key-field-name="enumId" description="${description}">
                    <entity-constraint name="enumTypeId" value="LEASE_PAY_TIMING"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="residualValueRate" title="${uiLabelMap.FinanceLeaseResidualValueRate}"><text size="12"/></field>
        <field name="revenueMethodEnumId" title="${uiLabelMap.FinanceLeaseRevenueMethod}">
            <drop-down allow-empty="false">
                <entity-options entity-name="Enumeration" key-field-name="enumId" description="${description}">
                    <entity-constraint name="enumTypeId" value="LEASE_REV_METHOD"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="taxable" title="${uiLabelMap.FinanceLeaseTaxable}">
            <drop-down allow-empty="false" no-current-selected-key="Y">
                <option key="Y" description="${uiLabelMap.CommonY}"/>
                <option key="N" description="${uiLabelMap.CommonN}"/>
            </drop-down>
        </field>
        <field name="submitButton" title="${uiLabelMap.CommonSave}"><submit button-type="button"/></field>
    </form>

    <grid name="ListFinancialProductLeaseAssetTypes" list-name="allowedAssetTypes" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}">
            <display-entity entity-name="FixedAssetType" description="${description} [${fixedAssetTypeId}]"/>
        </field>
        <field name="removeLink" title=" " widget-style="buttontext">
            <hyperlink description="${uiLabelMap.CommonRemove}" target="removeFinancialProductLeaseAssetType" link-type="hidden-form" also-hidden="false">
                <parameter param-name="productId"/>
                <parameter param-name="fixedAssetTypeId"/>
            </hyperlink>
        </field>
    </grid>

    <form name="AddFinancialProductLeaseAssetType" type="single" target="addFinancialProductLeaseAssetType">
        <field name="productId"><hidden value="${productId}"/></field>
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}">
            <drop-down allow-empty="false">
                <entity-options entity-name="FixedAssetType" key-field-name="fixedAssetTypeId" description="${description} [${fixedAssetTypeId}]">
                    <entity-order-by field-name="description"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="addButton" title="${uiLabelMap.CommonAdd}"><submit button-type="button"/></field>
    </form>

    <!-- ============================================================= -->
    <!-- Lease application                                             -->
    <!-- ============================================================= -->
    <form name="FindLeaseApplications" type="single" target="FindLeaseApplication" default-entity-name="LeaseApplication">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}"><text-find/></field>
        <field name="applicantPartyId" title="${uiLabelMap.FinanceLesseePartyId}"><lookup target-form-name="LookupPartyName"/></field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FinancialProductAndType" key-field-name="productId" description="${productName} [${productId}]">
                    <entity-constraint name="parentTypeId" value="LEASE"/>
                    <entity-order-by field-name="productId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}">
            <drop-down allow-empty="true">
                <entity-options key-field-name="statusId" description="${description}" entity-name="StatusItem">
                    <entity-constraint name="statusTypeId" value="LEASE_APP_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}"><submit button-type="button"/></field>
    </form>

    <grid name="ListLeaseApplications" list-name="listIt" paginate-target="FindLeaseApplication"
            default-entity-name="LeaseApplication" separate-columns="true"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="LeaseApplication"/>
                <field-map field-name="orderBy" from-field="parameters.sortField"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}" widget-style="buttontext" sort-field="true">
            <hyperlink description="${leaseApplicationId}" target="ManageLeaseApplication" also-hidden="false">
                <parameter param-name="leaseApplicationId"/>
            </hyperlink>
        </field>
        <field name="applicantPartyId" title="${uiLabelMap.FinanceLesseePartyId}" sort-field="true">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}" sort-field="true">
            <display-entity entity-name="Product" description="${productName} [${productId}]"/>
        </field>
        <field name="requestedTermMonths" title="${uiLabelMap.FinanceRequestedTermMonths}"><display/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}" sort-field="true"><display-entity entity-name="StatusItem"/></field>
        <field name="applicationDate" title="${uiLabelMap.FinanceApplicationDate}" sort-field="true"><display/></field>
    </grid>

    <form name="EditLeaseApplication" type="single" target="updateLeaseApplication" default-map-name="leaseApplication">
        <alt-target use-when="leaseApplication==null" target="createLeaseApplication"/>
        <field use-when="leaseApplication!=null" name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}"><display/></field>
        <field use-when="leaseApplication!=null" name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}">
            <drop-down allow-empty="false">
                <entity-options entity-name="FinancialProductAndType" key-field-name="productId" description="${productName} [${productId}]">
                    <entity-constraint name="parentTypeId" value="LEASE"/>
                    <entity-order-by field-name="productId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="applicantPartyId" title="${uiLabelMap.FinanceLesseePartyId}" required-field="true"><lookup target-form-name="LookupPartyName"/></field>
        <field name="applicantPartyId_display" entry-name="applicantPartyId" title=" ">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName}"/>
        </field>
        <field name="currencyUomId" title="${uiLabelMap.FinanceCurrencyUomId}" tooltip="${uiLabelMap.FinanceCurrencyDefaultsToProduct}">
            <drop-down allow-empty="true">
                <entity-options key-field-name="uomId" description="${abbreviation} - ${description}" entity-name="Uom">
                    <entity-constraint name="uomTypeId" value="CURRENCY_MEASURE"/>
                    <entity-order-by field-name="abbreviation"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="requestedTermMonths" title="${uiLabelMap.FinanceRequestedTermMonths}" required-field="true"><text size="10"/></field>
        <field name="purpose" title="${uiLabelMap.FinancePurpose}"><textarea cols="60" rows="3"/></field>
        <field name="comments" title="${uiLabelMap.FinanceComments}"><textarea cols="60" rows="2"/></field>
        <field name="submitButton" title="${uiLabelMap.CommonSave}"
                use-when="${leaseApplication == null || leaseApplication.statusId == 'LEASEAPP_RECEIVED'}"><submit button-type="button"/></field>
    </form>

    <form name="ChangeLeaseApplicationStatus" type="single" target="setLeaseApplicationStatus" default-map-name="leaseApplication">
        <field name="leaseApplicationId"><hidden/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}">
            <drop-down allow-empty="false" current-description="">
                <entity-options key-field-name="statusIdTo" description="${transitionName}" entity-name="StatusValidChange">
                    <entity-constraint name="statusId" env-name="leaseApplication.statusId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="changeStatusButton" title="${uiLabelMap.FinanceChangeStatus}"><submit button-type="button"/></field>
    </form>

    <!-- Header of the manage screen -->
    <form name="ViewLeaseApplicationHeader" type="single" default-map-name="leaseApplication">
        <field name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}"><display/></field>
        <field name="applicantPartyId" title="${uiLabelMap.FinanceLesseePartyId}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}">
            <display-entity entity-name="Product" description="${productName} [${productId}]"/>
        </field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field name="requestedTermMonths" title="${uiLabelMap.FinanceRequestedTermMonths}"><display/></field>
        <field name="estimatedTotalCost" entry-name="estimatedTotalCost" title="${uiLabelMap.FinanceLeaseEstimatedTotalCost}">
            <display type="currency" currency="${leaseApplication.currencyUomId}"/>
        </field>
    </form>

    <!-- Requested assets -->
    <grid name="ListLeaseApplicationAssets" list-name="assets" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="assetSeqId" title="${uiLabelMap.FinanceLeaseAssetSeqId}"><display/></field>
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}"><display-entity entity-name="FixedAssetType"/></field>
        <field name="assetName" title="${uiLabelMap.FinanceLeaseAssetName}"><display/></field>
        <field name="quantity" title="${uiLabelMap.FinanceLeaseAssetQuantity}"><display/></field>
        <field name="estimatedAcquisitionCost" title="${uiLabelMap.FinanceLeaseEstimatedAcquisitionCost}">
            <display type="currency" currency="${leaseApplication.currencyUomId}"/>
        </field>
        <field name="supplierPartyId" title="${uiLabelMap.FinanceLeaseSupplierPartyId}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="removeLink" title=" " widget-style="buttontext" use-when="${leaseApplication.statusId == 'LEASEAPP_RECEIVED'}">
            <hyperlink description="${uiLabelMap.CommonRemove}" target="removeLeaseApplicationAsset" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="assetSeqId"/>
            </hyperlink>
        </field>
    </grid>

    <form name="AddLeaseApplicationAsset" type="single" target="createLeaseApplicationAsset">
        <field name="leaseApplicationId"><hidden value="${leaseApplicationId}"/></field>
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}">
            <drop-down allow-empty="false">
                <list-options list-name="assetTypeOptions" key-name="fixedAssetTypeId" description="${description} [${fixedAssetTypeId}]"/>
            </drop-down>
        </field>
        <field name="assetName" title="${uiLabelMap.FinanceLeaseAssetName}" required-field="true"><text size="40"/></field>
        <field name="quantity" title="${uiLabelMap.FinanceLeaseAssetQuantity}"><text size="8" default-value="1"/></field>
        <field name="estimatedAcquisitionCost" title="${uiLabelMap.FinanceLeaseEstimatedAcquisitionCost}" required-field="true"><text size="20"/></field>
        <field name="supplierPartyId" title="${uiLabelMap.FinanceLeaseSupplierPartyId}"><lookup target-form-name="LookupPartyName"/></field>
        <field name="addButton" title="${uiLabelMap.CommonAdd}"><submit button-type="button"/></field>
    </form>

    <!-- Underwriting of the lease application (common review) -->
    <form name="EditLeaseUnderwriting" type="single" target="updateLeaseUnderwriting" default-map-name="leaseUnderwriting">
        <alt-target use-when="leaseUnderwriting==null" target="createLeaseUnderwriting"/>
        <field name="leaseApplicationId"><hidden value="${leaseApplicationId}"/></field>
        <field use-when="leaseUnderwriting!=null" name="loanUnderwritingId" title="${uiLabelMap.FinanceUnderwritingId}"><display/></field>
        <field use-when="leaseUnderwriting!=null" name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field use-when="leaseUnderwriting!=null" name="decision" title="${uiLabelMap.FinanceDecision}"><display/></field>
        <field use-when="leaseUnderwriting!=null" name="reviewDate" title="${uiLabelMap.FinanceReviewDate}"><display/></field>
        <field name="creditScore" title="${uiLabelMap.FinanceCreditScore}"><text size="10"/></field>
        <field name="approvedPrincipalAmount" title="${uiLabelMap.FinanceLeaseApprovedAcquisitionCost}"><text size="20" default-value="${estimatedTotalCost}"/></field>
        <field name="comments" title="${uiLabelMap.FinanceComments}"><textarea cols="60" rows="3"/></field>
        <field name="submitButton" title="${uiLabelMap.CommonSave}"
                use-when="${leaseUnderwriting == null || leaseUnderwriting.statusId == 'LOANUW_IN_REVIEW'}"><submit button-type="button"/></field>
        <field name="approveUnderwritingLink" title=" " widget-style="buttontext"
                use-when="${leaseUnderwriting != null &amp;&amp; leaseUnderwriting.statusId == 'LOANUW_IN_REVIEW'}">
            <hyperlink description="${uiLabelMap.FinanceApproveUnderwriting}" target="setLeaseUnderwritingStatus" link-type="hidden-form" also-hidden="false">
                <parameter param-name="loanUnderwritingId" from-field="leaseUnderwriting.loanUnderwritingId"/>
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="statusId" value="LOANUW_APPROVED"/>
            </hyperlink>
        </field>
        <field name="rejectUnderwritingLink" title=" " widget-style="buttontext"
                use-when="${leaseUnderwriting != null &amp;&amp; leaseUnderwriting.statusId == 'LOANUW_IN_REVIEW'}">
            <hyperlink description="${uiLabelMap.FinanceRejectUnderwriting}" target="setLeaseUnderwritingStatus" link-type="hidden-form" also-hidden="false">
                <parameter param-name="loanUnderwritingId" from-field="leaseUnderwriting.loanUnderwritingId"/>
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="statusId" value="LOANUW_REJECTED"/>
            </hyperlink>
        </field>
    </form>

    <!-- ============================================================= -->
    <!-- STEP L2: lease quotes                                         -->
    <!-- ============================================================= -->
    <form name="GenerateLeaseQuote" type="single" target="createLeaseQuote">
        <field name="leaseApplicationId"><hidden value="${leaseApplicationId}"/></field>
        <field name="termMonths" title="${uiLabelMap.FinanceTermMonths}"><text size="10" default-value="${leaseApplication.requestedTermMonths}"/></field>
        <field name="monthlyRateFactor" title="${uiLabelMap.FinanceLeaseMonthlyRateFactor}" tooltip="${uiLabelMap.FinanceLeaseQuoteRateTooltip}"><text size="12"/></field>
        <field name="calcInterestRate" title="${uiLabelMap.FinanceLeaseCalcInterestRate}"><text size="12"/></field>
        <field name="residualValue" title="${uiLabelMap.FinanceLeaseResidualValue}" tooltip="${uiLabelMap.FinanceLeaseResidualDefaultTooltip}"><text size="20"/></field>
        <field name="paymentTimingEnumId" title="${uiLabelMap.FinanceLeasePaymentTiming}">
            <drop-down allow-empty="true">
                <entity-options entity-name="Enumeration" key-field-name="enumId" description="${description}">
                    <entity-constraint name="enumTypeId" value="LEASE_PAY_TIMING"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="leaseStartDate" title="${uiLabelMap.FinanceLeaseExpectedStartDate}"><date-time type="date"/></field>
        <field name="submitButton" title="${uiLabelMap.FinanceGenerateQuote}"><submit button-type="button"/></field>
    </form>

    <grid name="ListLeaseQuotes" list-name="quotes" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="leaseQuoteId" title="${uiLabelMap.FinanceLeaseQuoteId}" widget-style="buttontext">
            <hyperlink description="${leaseQuoteId}" target="ViewLeaseQuote" also-hidden="false">
                <parameter param-name="leaseQuoteId"/>
            </hyperlink>
        </field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field name="calcMethodEnumId" title="${uiLabelMap.FinanceLeaseCalcMethod}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="termMonths" title="${uiLabelMap.FinanceTermMonths}"><display/></field>
        <field name="monthlyLeaseAmount" title="${uiLabelMap.FinanceLeaseMonthlyAmount}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="calcInterestRate" title="${uiLabelMap.FinanceLeasePdfCalcRate}"><display/></field>
        <field name="createdDate" title="${uiLabelMap.FinanceCreatedDate}"><display/></field>
        <field name="presentLink" title=" " widget-style="buttontext" use-when="${statusId == 'LEASEQT_CREATED'}">
            <hyperlink description="${uiLabelMap.FinanceLeaseQuotePresent}" target="setLeaseQuoteStatus" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseQuoteId"/>
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="statusId" value="LEASEQT_PRESENTED"/>
            </hyperlink>
        </field>
        <field name="acceptLink" title=" " widget-style="buttontext" use-when="${statusId == 'LEASEQT_PRESENTED'}">
            <hyperlink description="${uiLabelMap.FinanceLeaseQuoteAccept}" target="setLeaseQuoteStatus" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseQuoteId"/>
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="statusId" value="LEASEQT_ACCEPTED"/>
            </hyperlink>
        </field>
        <field name="rejectLink" title=" " widget-style="buttontext" use-when="${statusId == 'LEASEQT_PRESENTED'}">
            <hyperlink description="${uiLabelMap.FinanceLeaseQuoteReject}" target="setLeaseQuoteStatus" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseQuoteId"/>
                <parameter param-name="leaseApplicationId"/>
                <parameter param-name="statusId" value="LEASEQT_REJECTED"/>
            </hyperlink>
        </field>
        <field name="contractLink" title=" " widget-style="buttontext" use-when="${statusId == 'LEASEQT_ACCEPTED' &amp;&amp; applicationApproved}">
            <hyperlink description="${uiLabelMap.FinanceLeaseCreateAgreement}" target="createLeaseAgreement" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseQuoteId"/>
                <parameter param-name="leaseApplicationId"/>
            </hyperlink>
        </field>
    </grid>

    <!-- Shared header for quote and agreement terms -->
    <form name="ViewLeaseQuoteHeader" type="single" default-map-name="leaseQuote">
        <field name="leaseQuoteId" title="${uiLabelMap.FinanceLeaseQuoteId}"><display/></field>
        <field name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}">
            <hyperlink description="${leaseQuote.leaseApplicationId}" target="ManageLeaseApplication" also-hidden="false">
                <parameter param-name="leaseApplicationId" from-field="leaseQuote.leaseApplicationId"/>
            </hyperlink>
        </field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field name="calcMethodEnumId" title="${uiLabelMap.FinanceLeaseCalcMethod}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="residualValue" title="${uiLabelMap.FinanceLeaseResidualValue}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="termMonths" title="${uiLabelMap.FinanceTermMonths}"><display/></field>
        <field name="paymentTimingEnumId" title="${uiLabelMap.FinanceLeasePaymentTiming}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="monthlyLeaseAmount" title="${uiLabelMap.FinanceLeaseMonthlyAmount}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="monthlyRateFactor" title="${uiLabelMap.FinanceLeasePdfRateFactor}"><display/></field>
        <field name="calcInterestRate" title="${uiLabelMap.FinanceLeasePdfCalcRate}"><display/></field>
        <field name="totalLeaseAmount" title="${uiLabelMap.FinanceLeaseTotalAmount}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="totalInterestAmount" title="${uiLabelMap.FinanceLeaseTotalInterest}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="taxRate" title="${uiLabelMap.FinanceLeaseTaxRate}"><display/></field>
        <field name="totalTaxAmount" title="${uiLabelMap.FinanceLeaseTotalTax}"><display type="currency" currency="${leaseQuote.currencyUomId}"/></field>
        <field name="leaseStartDate" title="${uiLabelMap.FinanceLeaseExpectedStartDate}"><display type="date"/></field>
        <field name="firstPaymentDate" title="${uiLabelMap.FinanceFirstPaymentDate}"><display type="date"/></field>
        <field name="createdDate" title="${uiLabelMap.FinanceCreatedDate}"><display/></field>
    </form>

    <grid name="ListLeaseAssetLines" list-name="assetLines" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="assetSeqId" title="${uiLabelMap.FinanceLeaseAssetSeqId}"><display/></field>
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}"><display-entity entity-name="FixedAssetType"/></field>
        <field name="assetName" title="${uiLabelMap.FinanceLeaseAssetName}"><display/></field>
        <field name="quantity" title="${uiLabelMap.FinanceLeaseAssetQuantity}"><display/></field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="supplierPartyId" title="${uiLabelMap.FinanceLeaseSupplierPartyId}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="fixedAssetId" title="${uiLabelMap.FinanceLeaseFixedAssetId}" use-when="${showFixedAsset == true}"><display/></field>
    </grid>

    <grid name="ListLeasePaymentSchedule" list-name="scheduleRows" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="installmentNumber" title="${uiLabelMap.FinanceInstallmentNumber}"><display/></field>
        <field name="dueDate" title="${uiLabelMap.FinanceDueDate}"><display type="date"/></field>
        <field name="periodFromDate" title="${uiLabelMap.FinanceLeasePeriodFrom}"><display type="date"/></field>
        <field name="periodThruDate" title="${uiLabelMap.FinanceLeasePeriodThru}"><display type="date"/></field>
        <field name="leaseAmount" title="${uiLabelMap.FinanceLeaseAmount}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="taxAmount" title="${uiLabelMap.FinanceLeaseTaxAmount}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="principalPortion" title="${uiLabelMap.FinanceLeasePrincipalPortion}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="interestPortion" title="${uiLabelMap.FinanceLeaseInterestPortion}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="remainingPrincipal" title="${uiLabelMap.FinanceLeaseRemainingPrincipal}"><display type="currency" currency="${currencyUomId}"/></field>
    </grid>

    <!-- ============================================================= -->
    <!-- STEP L2: lease agreements                                     -->
    <!-- ============================================================= -->
    <form name="FindLeaseAgreements" type="single" target="FindLeaseAgreement" default-entity-name="LeaseAgreement">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="leaseAgreementId" title="${uiLabelMap.FinanceLeaseAgreementId}"><text-find/></field>
        <field name="lesseePartyId" title="${uiLabelMap.FinanceLesseePartyId}"><lookup target-form-name="LookupPartyName"/></field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}">
            <drop-down allow-empty="true">
                <entity-options entity-name="FinancialProductAndType" key-field-name="productId" description="${productName} [${productId}]">
                    <entity-constraint name="parentTypeId" value="LEASE"/>
                    <entity-order-by field-name="productId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}">
            <drop-down allow-empty="true">
                <entity-options key-field-name="statusId" description="${description}" entity-name="StatusItem">
                    <entity-constraint name="statusTypeId" value="LEASE_AGR_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton" title="${uiLabelMap.CommonFind}"><submit button-type="button"/></field>
    </form>

    <grid name="ListLeaseAgreements" list-name="listIt" paginate-target="FindLeaseAgreement"
            default-entity-name="LeaseAgreement" separate-columns="true"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="LeaseAgreement"/>
                <field-map field-name="orderBy" from-field="parameters.sortField"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
        </actions>
        <field name="leaseAgreementId" title="${uiLabelMap.FinanceLeaseAgreementId}" widget-style="buttontext" sort-field="true">
            <hyperlink description="${leaseAgreementId}" target="ManageLeaseAgreement" also-hidden="false">
                <parameter param-name="leaseAgreementId"/>
            </hyperlink>
        </field>
        <field name="lesseePartyId" title="${uiLabelMap.FinanceLesseePartyId}" sort-field="true">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}" sort-field="true">
            <display-entity entity-name="Product" description="${productName} [${productId}]"/>
        </field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="monthlyLeaseAmount" title="${uiLabelMap.FinanceLeaseMonthlyAmount}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="termMonths" title="${uiLabelMap.FinanceTermMonths}"><display/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}" sort-field="true"><display-entity entity-name="StatusItem"/></field>
        <field name="agreementDate" title="${uiLabelMap.FinanceLeaseAgreementDate}" sort-field="true"><display type="date"/></field>
    </grid>

    <form name="ViewLeaseAgreementHeader" type="single" default-map-name="leaseAgreement">
        <field name="leaseAgreementId" title="${uiLabelMap.FinanceLeaseAgreementId}"><display/></field>
        <field name="financeContractId" title="${uiLabelMap.FinanceContractId}"><display/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem"/></field>
        <field name="lesseePartyId" title="${uiLabelMap.FinanceLesseePartyId}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="organizationPartyId" title="${uiLabelMap.FinanceLeaseLessor}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="productId" title="${uiLabelMap.FinanceProductId}">
            <display-entity entity-name="Product" description="${productName} [${productId}]"/>
        </field>
        <field name="leaseClassEnumId" title="${uiLabelMap.FinanceLeaseClass}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="revenueMethodEnumId" title="${uiLabelMap.FinanceLeaseRevenueMethod}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="leaseApplicationId" title="${uiLabelMap.FinanceLeaseApplicationId}">
            <hyperlink description="${leaseAgreement.leaseApplicationId}" target="ManageLeaseApplication" also-hidden="false">
                <parameter param-name="leaseApplicationId" from-field="leaseAgreement.leaseApplicationId"/>
            </hyperlink>
        </field>
        <field name="leaseQuoteId" title="${uiLabelMap.FinanceLeaseQuoteId}">
            <hyperlink description="${leaseAgreement.leaseQuoteId}" target="ViewLeaseQuote" also-hidden="false">
                <parameter param-name="leaseQuoteId" from-field="leaseAgreement.leaseQuoteId"/>
            </hyperlink>
        </field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="residualValue" title="${uiLabelMap.FinanceLeaseResidualValue}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="termMonths" title="${uiLabelMap.FinanceTermMonths}"><display/></field>
        <field name="paymentTimingEnumId" title="${uiLabelMap.FinanceLeasePaymentTiming}"><display-entity entity-name="Enumeration" key-field-name="enumId"/></field>
        <field name="monthlyLeaseAmount" title="${uiLabelMap.FinanceLeaseMonthlyAmount}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="calcInterestRate" title="${uiLabelMap.FinanceLeasePdfCalcRate}"><display/></field>
        <field name="totalLeaseAmount" title="${uiLabelMap.FinanceLeaseTotalAmount}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="totalInterestAmount" title="${uiLabelMap.FinanceLeaseTotalInterest}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="totalTaxAmount" title="${uiLabelMap.FinanceLeaseTotalTax}"><display type="currency" currency="${leaseAgreement.currencyUomId}"/></field>
        <field name="agreementDate" title="${uiLabelMap.FinanceLeaseAgreementDate}"><display type="date"/></field>
        <field name="leaseStartDate" title="${uiLabelMap.FinanceLeaseStartDate}"><display type="date"/></field>
        <field name="leaseEndDate" title="${uiLabelMap.FinanceLeaseEndDate}"><display type="date"/></field>
    </form>

    <!-- ============================================================= -->
    <!-- STEP L3: agreement assets (purchase / payment) and acceptance -->
    <!-- ============================================================= -->
    <grid name="ListLeaseAgreementAssets" list-name="assetLines" paginate="false"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <field name="assetSeqId" title="${uiLabelMap.FinanceLeaseAssetSeqId}"><display/></field>
        <field name="fixedAssetTypeId" title="${uiLabelMap.FinanceLeaseAssetType}"><display-entity entity-name="FixedAssetType"/></field>
        <field name="assetName" title="${uiLabelMap.FinanceLeaseAssetName}"><display/></field>
        <field name="quantity" title="${uiLabelMap.FinanceLeaseAssetQuantity}"><display/></field>
        <field name="acquisitionCost" title="${uiLabelMap.FinanceLeaseAcquisitionCost}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="supplierPartyId" title="${uiLabelMap.FinanceLeaseSupplierPartyId}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="assetStatusId" title="${uiLabelMap.FinanceStatus}"><display-entity entity-name="StatusItem" key-field-name="statusId"/></field>
        <field name="fixedAssetId" title="${uiLabelMap.FinanceLeaseFixedAssetId}"><display/></field>
        <field name="invoiceId" title="${uiLabelMap.FinanceLeasePurchaseInvoice}"><display/></field>
        <field name="paymentId" title="${uiLabelMap.FinanceLeaseSupplierPayment}"><display/></field>
        <field name="purchaseLink" title=" " widget-style="buttontext" use-when="${canPurchase == true}">
            <hyperlink description="${uiLabelMap.FinanceLeaseRecordPurchase}" target="recordLeaseAssetPurchase" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseAgreementId"/>
                <parameter param-name="assetSeqId"/>
            </hyperlink>
        </field>
        <field name="payLink" title=" " widget-style="buttontext" use-when="${canPay == true}">
            <hyperlink description="${uiLabelMap.FinanceLeasePaySupplier}" target="payLeaseAssetPurchase" link-type="hidden-form" also-hidden="false">
                <parameter param-name="leaseAgreementId"/>
                <parameter param-name="assetSeqId"/>
            </hyperlink>
        </field>
    </grid>

    <form name="AcceptLeaseAgreement" type="single" target="acceptLeaseAgreement">
        <field name="leaseAgreementId"><hidden value="${leaseAgreement.leaseAgreementId}"/></field>
        <field name="acceptanceDate" title="${uiLabelMap.FinanceLeaseAcceptanceDate}" required-field="true"><date-time type="date"/></field>
        <field name="acceptedByPartyId" title="${uiLabelMap.FinanceLeaseAcceptedBy}" tooltip="${uiLabelMap.FinanceLeaseAcceptedByTooltip}"><lookup target-form-name="LookupPartyName"/></field>
        <field name="comments" title="${uiLabelMap.FinanceComments}"><textarea cols="60" rows="2"/></field>
        <field name="submitButton" title="${uiLabelMap.FinanceLeaseAccept}"><submit button-type="button"/></field>
    </form>

    <form name="ViewLeaseAcceptance" type="single" default-map-name="leaseAcceptance">
        <field name="acceptanceDate" title="${uiLabelMap.FinanceLeaseAcceptanceDate}"><display type="date"/></field>
        <field name="acceptedByPartyId" title="${uiLabelMap.FinanceLeaseAcceptedBy}">
            <display-entity entity-name="PartyNameView" key-field-name="partyId"
                    description="${firstName} ${middleName} ${lastName} ${groupName} [${partyId}]"/>
        </field>
        <field name="scheduleRevisionNumber" title="${uiLabelMap.FinanceScheduleRevision}"><display/></field>
        <field name="startAcctgTransId" title="${uiLabelMap.FinanceLeaseStartAcctgTrans}"><display/></field>
        <field name="comments" title="${uiLabelMap.FinanceComments}"><display/></field>
    </form>

</forms>