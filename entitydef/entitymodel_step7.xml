<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Finance Component Entity Model - STEP 7 (Prepayment, Loan Modification)</title>
    <description>
        Prepayment (full or partial with term / payment reduction) and loan
        condition modification (interest rate / term). Both re-amortize the
        remaining agreement schedule as a new revision, leaving the original
        snapshot immutable.
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- LoanPrepayment: a full or partial prepayment event.        -->
    <!-- ========================================================= -->
    <entity entity-name="LoanPrepayment" package-name="org.apache.ofbiz.finance.agreement"
            title="Loan Prepayment">
        <field name="loanPrepaymentId" type="id"><description>primary sequenced ID</description></field>
        <field name="loanAgreementId" type="id"></field>
        <field name="prepaymentTypeEnumId" type="id"><description>PREPAY_FULL / PREPAY_PART_TERM / PREPAY_PART_AMOUNT</description></field>
        <field name="prepaymentDate" type="date-time"></field>
        <field name="principalAmount" type="currency-amount"><description>principal amount prepaid</description></field>
        <field name="penaltyAmount" type="currency-amount"><description>prepayment fee charged</description></field>
        <field name="paymentId" type="id"><description>optional link to the settlement Payment</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="loanPrepaymentId"/>
        <relation type="one" fk-name="LOANPREP_AGR" rel-entity-name="LoanAgreement">
            <key-map field-name="loanAgreementId"/>
        </relation>
        <relation type="one" fk-name="LOANPREP_TYPE" rel-entity-name="Enumeration">
            <key-map field-name="prepaymentTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LOANPREP_PAY" rel-entity-name="Payment">
            <key-map field-name="paymentId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- LoanModification: a condition change to an active loan.    -->
    <!-- ========================================================= -->
    <entity entity-name="LoanModification" package-name="org.apache.ofbiz.finance.agreement"
            title="Loan Modification">
        <field name="loanModificationId" type="id"><description>primary sequenced ID</description></field>
        <field name="loanAgreementId" type="id"></field>
        <field name="modificationDate" type="date-time"></field>
        <field name="effectiveDate" type="date-time"><description>when the new terms take effect</description></field>
        <field name="modificationTypeEnumId" type="id"><description>MOD_RATE / MOD_TERM</description></field>
        <field name="oldAnnualInterestRate" type="fixed-point"></field>
        <field name="newAnnualInterestRate" type="fixed-point"></field>
        <field name="oldTermMonths" type="numeric"></field>
        <field name="newTermMonths" type="numeric"></field>
        <field name="reason" type="description"></field>
        <field name="comments" type="comment"></field>
        <prim-key field="loanModificationId"/>
        <relation type="one" fk-name="LOANMOD_AGR" rel-entity-name="LoanAgreement">
            <key-map field-name="loanAgreementId"/>
        </relation>
        <relation type="one" fk-name="LOANMOD_TYPE" rel-entity-name="Enumeration">
            <key-map field-name="modificationTypeEnumId" rel-field-name="enumId"/>
        </relation>
    </entity>

</entitymodel>
