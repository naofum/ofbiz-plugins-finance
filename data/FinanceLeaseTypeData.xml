    Lease layer seed data (STEP L1): lease product types, lease terms
    enumerations and the lease application status workflow.
    NOTE: id fields are VARCHAR(20); keep every id <= 20 characters.
-->
<entity-engine-xml>
    <!-- ============ Lease product types ============ -->
    <FinancialProductType financialProductTypeId="LEASE" hasTable="N" description="Lease (root)"/>
    <FinancialProductType financialProductTypeId="LEASE_FIN_TRANSFER" parentTypeId="LEASE" hasTable="N" description="Finance lease - ownership transfer"/>
    <FinancialProductType financialProductTypeId="LEASE_FIN_NONTRANS" parentTypeId="LEASE" hasTable="N" description="Finance lease - no ownership transfer"/>
    <FinancialProductType financialProductTypeId="LEASE_OPERATING" parentTypeId="LEASE" hasTable="N" description="Operating lease (later step)"/>

    <!-- ============ Lease class (derived from the product type) ============ -->
    <EnumerationType description="Lease Class" enumTypeId="LEASE_CLASS" hasTable="N"/>
    <Enumeration description="Finance lease - ownership transfer (所有権移転)" enumCode="FIN_TRANSFER" enumId="LEASE_CLS_FIN_TRANS" sequenceId="01" enumTypeId="LEASE_CLASS"/>
    <Enumeration description="Finance lease - no ownership transfer (所有権移転外)" enumCode="FIN_NON_TRANSFER" enumId="LEASE_CLS_FIN_NONTR" sequenceId="02" enumTypeId="LEASE_CLASS"/>
    <Enumeration description="Operating lease (オペレーティング)" enumCode="OPERATING" enumId="LEASE_CLS_OPERATING" sequenceId="03" enumTypeId="LEASE_CLASS"/>

    <!-- ============ Payment timing ============ -->
    <EnumerationType description="Lease Payment Timing" enumTypeId="LEASE_PAY_TIMING" hasTable="N"/>
    <Enumeration description="In advance (前払)" enumCode="ADVANCE" enumId="LEASE_PAY_ADVANCE" sequenceId="01" enumTypeId="LEASE_PAY_TIMING"/>
    <Enumeration description="In arrears (後払)" enumCode="ARREARS" enumId="LEASE_PAY_ARREARS" sequenceId="02" enumTypeId="LEASE_PAY_TIMING"/>

    <!-- ============ Revenue recognition method ============ -->
    <!-- Only method 1 is implemented. Method 3 (interest only) is added with its strategy. -->
    <EnumerationType description="Lease Revenue Method" enumTypeId="LEASE_REV_METHOD" hasTable="N"/>
    <Enumeration description="Sales and cost of sales at lease start (第1法)" enumCode="AT_START" enumId="LEASE_REV_AT_START" sequenceId="01" enumTypeId="LEASE_REV_METHOD"/>

    <!-- ============ Lease application status ============ -->
    <StatusType description="Lease Application" hasTable="N" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Received" sequenceId="01" statusCode="RECEIVED" statusId="LEASEAPP_RECEIVED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Submitted for review" sequenceId="02" statusCode="SUBMITTED" statusId="LEASEAPP_SUBMITTED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Approved" sequenceId="03" statusCode="APPROVED" statusId="LEASEAPP_APPROVED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Rejected" sequenceId="04" statusCode="REJECTED" statusId="LEASEAPP_REJECTED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Contracted" sequenceId="05" statusCode="CONTRACTED" statusId="LEASEAPP_CONTRACTED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusItem description="Cancelled" sequenceId="06" statusCode="CANCELLED" statusId="LEASEAPP_CANCELLED" statusTypeId="LEASE_APP_STATUS"/>
    <StatusValidChange statusId="LEASEAPP_RECEIVED" statusIdTo="LEASEAPP_SUBMITTED" transitionName="Submit for review"/>
    <StatusValidChange statusId="LEASEAPP_RECEIVED" statusIdTo="LEASEAPP_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="LEASEAPP_SUBMITTED" statusIdTo="LEASEAPP_APPROVED" transitionName="Approve"/>
    <StatusValidChange statusId="LEASEAPP_SUBMITTED" statusIdTo="LEASEAPP_REJECTED" transitionName="Reject"/>
    <StatusValidChange statusId="LEASEAPP_SUBMITTED" statusIdTo="LEASEAPP_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="LEASEAPP_APPROVED" statusIdTo="LEASEAPP_CONTRACTED" transitionName="Contract"/>
    <StatusValidChange statusId="LEASEAPP_APPROVED" statusIdTo="LEASEAPP_REJECTED" transitionName="Reject"/>

    <!-- ============ STEP L2: calculation method ============ -->
    <EnumerationType description="Lease Calculation Method" enumTypeId="LEASE_CALC_METHOD" hasTable="N"/>
    <Enumeration description="Monthly rate factor (月額リース料率)" enumCode="RATE_FACTOR" enumId="LEASE_CALC_RATE_FCTR" sequenceId="01" enumTypeId="LEASE_CALC_METHOD"/>
    <Enumeration description="Calculation interest rate (計算利子率)" enumCode="INTEREST_RATE" enumId="LEASE_CALC_INT_RATE" sequenceId="02" enumTypeId="LEASE_CALC_METHOD"/>

    <!-- ============ STEP L2: lease quote status ============ -->
    <StatusType description="Lease Quote" hasTable="N" statusTypeId="LEASE_QUOTE_STATUS"/>
    <StatusItem description="Created" sequenceId="01" statusCode="CREATED" statusId="LEASEQT_CREATED" statusTypeId="LEASE_QUOTE_STATUS"/>
    <StatusItem description="Presented" sequenceId="02" statusCode="PRESENTED" statusId="LEASEQT_PRESENTED" statusTypeId="LEASE_QUOTE_STATUS"/>
    <StatusItem description="Accepted" sequenceId="03" statusCode="ACCEPTED" statusId="LEASEQT_ACCEPTED" statusTypeId="LEASE_QUOTE_STATUS"/>
    <StatusItem description="Rejected" sequenceId="04" statusCode="REJECTED" statusId="LEASEQT_REJECTED" statusTypeId="LEASE_QUOTE_STATUS"/>
    <StatusValidChange statusId="LEASEQT_CREATED" statusIdTo="LEASEQT_PRESENTED" transitionName="Present"/>
    <StatusValidChange statusId="LEASEQT_PRESENTED" statusIdTo="LEASEQT_ACCEPTED" transitionName="Accept"/>
    <StatusValidChange statusId="LEASEQT_PRESENTED" statusIdTo="LEASEQT_REJECTED" transitionName="Reject"/>

    <!-- ============ STEP L2: lease agreement status ============ -->
    <!-- CONTRACTED -> ACTIVE is added with the lease start (STEP L3), ACTIVE -> COMPLETED in STEP L7. -->
    <StatusType description="Lease Agreement" hasTable="N" statusTypeId="LEASE_AGR_STATUS"/>
    <StatusItem description="Contracted (awaiting acceptance)" sequenceId="01" statusCode="CONTRACTED" statusId="LEASEAGR_CONTRACTED" statusTypeId="LEASE_AGR_STATUS"/>
    <StatusItem description="Active" sequenceId="02" statusCode="ACTIVE" statusId="LEASEAGR_ACTIVE" statusTypeId="LEASE_AGR_STATUS"/>
    <StatusItem description="Completed" sequenceId="03" statusCode="COMPLETED" statusId="LEASEAGR_COMPLETED" statusTypeId="LEASE_AGR_STATUS"/>
    <StatusItem description="Cancelled" sequenceId="04" statusCode="CANCELLED" statusId="LEASEAGR_CANCELLED" statusTypeId="LEASE_AGR_STATUS"/>
    <StatusValidChange statusId="LEASEAGR_CONTRACTED" statusIdTo="LEASEAGR_CANCELLED" transitionName="Cancel"/>

    <!-- ============ STEP L3: lease start (acceptance) ============ -->
    <!-- Only the acceptance service (acceptLeaseAgreement) performs this transition. -->
    <StatusValidChange statusId="LEASEAGR_CONTRACTED" statusIdTo="LEASEAGR_ACTIVE" transitionName="Start (acceptance)"/>

    <StatusType description="Lease Asset" hasTable="N" statusTypeId="LEASE_ASSET_STATUS"/>
    <StatusItem description="Pending purchase" sequenceId="01" statusCode="PENDING" statusId="LSAST_PENDING" statusTypeId="LEASE_ASSET_STATUS"/>
    <StatusItem description="Purchased" sequenceId="02" statusCode="PURCHASED" statusId="LSAST_PURCHASED" statusTypeId="LEASE_ASSET_STATUS"/>
    <StatusItem description="Leased" sequenceId="03" statusCode="LEASED" statusId="LSAST_LEASED" statusTypeId="LEASE_ASSET_STATUS"/>
    <StatusItem description="Returned" sequenceId="04" statusCode="RETURNED" statusId="LSAST_RETURNED" statusTypeId="LEASE_ASSET_STATUS"/>
    <StatusItem description="Transferred" sequenceId="05" statusCode="TRANSFERRED" statusId="LSAST_TRANSFERRED" statusTypeId="LEASE_ASSET_STATUS"/>

    <!-- ============ STEP L3: lease GL account types and accounts ============ -->
    <!-- Organization mappings (GlAccountTypeDefault / GlAccountOrganization) are demo data. -->
    <GlAccountType description="Lease investment asset (finance lease, no ownership transfer)" glAccountTypeId="LEASE_INVESTMENT" hasTable="N" parentTypeId="CURRENT_ASSET"/>
    <GlAccountType description="Lease receivable (finance lease, ownership transfer)" glAccountTypeId="LEASE_RECEIVABLE" hasTable="N" parentTypeId="CURRENT_ASSET"/>
    <GlAccountType description="Lease asset suspense (purchased, not yet started)" glAccountTypeId="LEASE_ASSET_SUSPENSE" hasTable="N" parentTypeId="CURRENT_ASSET"/>
    <GlAccountType description="Deferred lease profit" glAccountTypeId="LEASE_DEFER_PROFIT" hasTable="N"/>
    <GlAccountType description="Lease sales" glAccountTypeId="LEASE_SALES" hasTable="N" parentTypeId="SALES_ACCOUNT"/>
    <GlAccountType description="Lease cost of sales" glAccountTypeId="LEASE_COST_OF_SALES" hasTable="N" parentTypeId="COGS_ACCOUNT"/>
    <GlAccountType description="Provision to deferred lease profit" glAccountTypeId="LEASE_DEFER_PROV" hasTable="N"/>
    <GlAccount glAccountId="128500" accountCode="128500" glAccountClassId="CURRENT_ASSET" glAccountTypeId="LEASE_INVESTMENT" glResourceTypeId="MONEY" accountName="LEASE INVESTMENT ASSET"/>
    <GlAccount glAccountId="128600" accountCode="128600" glAccountClassId="CURRENT_ASSET" glAccountTypeId="LEASE_RECEIVABLE" glResourceTypeId="MONEY" accountName="LEASE RECEIVABLE"/>
    <GlAccount glAccountId="147500" accountCode="147500" glAccountClassId="CURRENT_ASSET" glAccountTypeId="LEASE_ASSET_SUSPENSE" glResourceTypeId="MONEY" accountName="LEASE ASSET SUSPENSE"/>
    <GlAccount glAccountId="128700" accountCode="128700" glAccountClassId="CONTRA_ASSET" glAccountTypeId="LEASE_DEFER_PROFIT" glResourceTypeId="MONEY" accountName="DEFERRED LEASE PROFIT"/>
    <GlAccount glAccountId="403500" accountCode="403500" glAccountClassId="REVENUE" glAccountTypeId="LEASE_SALES" glResourceTypeId="MONEY" accountName="LEASE SALES"/>
    <GlAccount glAccountId="503500" accountCode="503500" glAccountClassId="COGS_EXPENSE" glAccountTypeId="LEASE_COST_OF_SALES" glResourceTypeId="MONEY" accountName="LEASE COST OF SALES"/>
    <GlAccount glAccountId="503600" accountCode="503600" glAccountClassId="COGS_EXPENSE" glAccountTypeId="LEASE_DEFER_PROV" glResourceTypeId="MONEY" accountName="PROVISION TO DEFERRED LEASE PROFIT"/>
</entity-engine-xml>