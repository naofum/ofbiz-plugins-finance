<entity-engine-xml>
    <!-- Invoice item type for loan principal portion.
         Interest portion reuses the core INV_INTRST_CHRG item type. -->
    <InvoiceItemType description="Loan Principal Repayment" hasTable="N" invoiceItemTypeId="LOAN_PRINCIPAL"/>

    <!-- Map the loan item types to the SALES_INVOICE so GL posting can resolve them.
         (GL account assignment can be configured per organization later.) -->
    <InvoiceItemTypeMap invoiceTypeId="SALES_INVOICE" invoiceItemMapKey="LOAN_PRINCIPAL" invoiceItemTypeId="LOAN_PRINCIPAL"/>
</entity-engine-xml>
