<screens xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Screen" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Screen http://ofbiz.apache.org/dtds/widget-screen.xsd">

    <!-- Lease terms of a lease product (STEP L1) -->
    <screen name="EditFinancialProductLease">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceLeaseTerms"/>
                <set field="headerItem" value="Products"/>
                <set field="productId" from-field="parameters.productId"/>
                <entity-one entity-name="FinancialProduct" value-field="financialProduct"/>
                <entity-one entity-name="FinancialProductLease" value-field="financialProductLease"/>
                <entity-one entity-name="FinancialProductType" value-field="financialProductType" auto-field-map="false">
                    <field-map field-name="financialProductTypeId" from-field="financialProduct.financialProductTypeId"/>
                </entity-one>
                <entity-condition entity-name="FinancialProductLeaseAssetType" list="allowedAssetTypes">
                    <condition-expr field-name="productId" from-field="productId"/>
                    <order-by field-name="fixedAssetTypeId"/>
                </entity-condition>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><not><if-empty field="financialProduct"/></not></condition>
                            <widgets>
                                <include-menu name="FinancialProductTabBar" location="component://finance/widget/FinanceMenus.xml"/>
                                <screenlet title="${uiLabelMap.FinanceLeaseTerms} - ${productId}">
                                    <include-form name="EditFinancialProductLease" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <section>
                                    <condition><not><if-empty field="financialProductLease"/></not></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseAllowedAssetTypes}">
                                            <label style="h3" text="${uiLabelMap.FinanceLeaseAllowedAssetTypesNote}"/>
                                            <include-form name="AddFinancialProductLeaseAssetType" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <include-grid name="ListFinancialProductLeaseAssetTypes" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                            </widgets>
                            <fail-widgets>
                                <label text="${uiLabelMap.FinanceRecordNotFound}"/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease application search -->
    <screen name="FindLeaseApplication">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceFindLeaseApplications"/>
                <set field="headerItem" value="LeaseApplications"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="${uiLabelMap.FinanceFindLeaseApplications}">
                            <include-form name="FindLeaseApplications" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                        <screenlet title="${uiLabelMap.FinanceLeaseApplications}">
                            <container style="button-bar">
                                <link target="EditLeaseApplication" text="${uiLabelMap.FinanceNewLeaseApplication}" style="buttontext create"/>
                            </container>
                            <include-grid name="ListLeaseApplications" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease application create / edit / status -->
    <screen name="EditLeaseApplication">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceEditLeaseApplication"/>
                <set field="headerItem" value="LeaseApplications"/>
                <set field="leaseApplicationId" from-field="parameters.leaseApplicationId"/>
                <entity-one entity-name="LeaseApplication" value-field="leaseApplication"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><not><if-empty field="leaseApplication"/></not></condition>
                            <widgets>
                                <include-menu name="LeaseApplicationTabBar" location="component://finance/widget/FinanceMenus.xml"/>
                            </widgets>
                        </section>
                        <screenlet title="${uiLabelMap.FinanceEditLeaseApplication}">
                            <include-form name="EditLeaseApplication" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                        <section>
                            <condition><not><if-empty field="leaseApplication"/></not></condition>
                            <widgets>
                                <screenlet title="${uiLabelMap.FinanceChangeStatus}">
                                    <include-form name="ChangeLeaseApplicationStatus" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                            </widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease application: requested assets and underwriting -->
    <screen name="ManageLeaseApplication">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceLeaseApplication"/>
                <set field="headerItem" value="LeaseApplications"/>
                <script location="component://finance/groovyScripts/lease/PrepareLeaseApplication.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><not><if-empty field="leaseApplication"/></not></condition>
                            <widgets>
                                <include-menu name="LeaseApplicationTabBar" location="component://finance/widget/FinanceMenus.xml"/>
                                <screenlet title="${uiLabelMap.FinanceLeaseApplication}">
                                    <include-form name="ViewLeaseApplicationHeader" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <screenlet title="${uiLabelMap.FinanceLeaseRequestedAssets}">
                                    <section>
                                        <condition><if-compare field="leaseApplication.statusId" operator="equals" value="LEASEAPP_RECEIVED"/></condition>
                                        <widgets>
                                            <include-form name="AddLeaseApplicationAsset" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </widgets>
                                    </section>
                                    <include-grid name="ListLeaseApplicationAssets" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <screenlet title="${uiLabelMap.FinanceLoanUnderwriting}">
                                    <include-form name="EditLeaseUnderwriting" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <section>
                                    <condition>
                                        <or>
                                            <if-compare field="leaseApplication.statusId" operator="equals" value="LEASEAPP_RECEIVED"/>
                                            <if-compare field="leaseApplication.statusId" operator="equals" value="LEASEAPP_SUBMITTED"/>
                                            <if-compare field="leaseApplication.statusId" operator="equals" value="LEASEAPP_APPROVED"/>
                                        </or>
                                    </condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceGenerateQuote}">
                                            <include-form name="GenerateLeaseQuote" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                                <screenlet title="${uiLabelMap.FinanceLeaseQuotes}">
                                    <section>
                                        <condition><not><if-empty field="leaseAgreement"/></not></condition>
                                        <widgets>
                                            <container style="button-bar">
                                                <link target="ManageLeaseAgreement" text="${uiLabelMap.FinanceLeaseAgreement} ${leaseAgreement.leaseAgreementId}" style="buttontext">
                                                    <parameter param-name="leaseAgreementId" from-field="leaseAgreement.leaseAgreementId"/>
                                                </link>
                                            </container>
                                        </widgets>
                                    </section>
                                    <include-grid name="ListLeaseQuotes" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                            </widgets>
                            <fail-widgets>
                                <label text="${uiLabelMap.FinanceLeaseApplicationNotFound}"/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease quote: header, assets, quote payment schedule (STEP L2) -->
    <screen name="ViewLeaseQuote">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceLeaseQuote"/>
                <set field="headerItem" value="LeaseApplications"/>
                <script location="component://finance/groovyScripts/lease/PrepareLeaseQuote.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><not><if-empty field="leaseQuote"/></not></condition>
                            <widgets>
                                <container style="button-bar">
                                    <link target="PrintLeaseQuote.pdf" text="${uiLabelMap.FinanceLeasePrintQuotePdf}" style="buttontext" target-window="_blank">
                                        <parameter param-name="leaseQuoteId" from-field="leaseQuote.leaseQuoteId"/>
                                    </link>
                                </container>
                                <screenlet title="${uiLabelMap.FinanceLeaseQuote}">
                                    <include-form name="ViewLeaseQuoteHeader" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <screenlet title="${uiLabelMap.FinanceLeaseAssets}">
                                    <include-grid name="ListLeaseAssetLines" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <screenlet title="${uiLabelMap.FinanceLeasePaymentSchedule}">
                                    <include-grid name="ListLeasePaymentSchedule" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <section>
                                    <condition><not><if-empty field="componentLines"/></not></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseComponents}">
                                            <include-grid name="ListLeaseQuoteComponents" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                            </widgets>
                            <fail-widgets>
                                <label text="${uiLabelMap.FinanceRecordNotFound}"/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease agreement search (STEP L2) -->
    <screen name="FindLeaseAgreement">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceFindLeaseAgreements"/>
                <set field="headerItem" value="LeaseAgreements"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <screenlet title="${uiLabelMap.FinanceFindLeaseAgreements}">
                            <include-form name="FindLeaseAgreements" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                        <screenlet title="${uiLabelMap.FinanceLeaseRunMonthlyBatch}">
                            <include-form name="RunLeaseMonthlyAccountingBatch" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                        <screenlet title="${uiLabelMap.FinanceLeaseAgreements}">
                            <include-grid name="ListLeaseAgreements" location="component://finance/widget/FinanceLeaseForms.xml"/>
                        </screenlet>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Lease agreement: header, assets, confirmed payment schedule (STEP L2) -->
    <screen name="ManageLeaseAgreement">
        <section>
            <actions>
                <set field="titleProperty" value="FinanceLeaseAgreement"/>
                <set field="headerItem" value="LeaseAgreements"/>
                <script location="component://finance/groovyScripts/lease/PrepareLeaseAgreement.groovy"/>
            </actions>
            <widgets>
                <decorator-screen name="main-decorator" location="${parameters.mainDecoratorLocation}">
                    <decorator-section name="body">
                        <section>
                            <condition><not><if-empty field="leaseAgreement"/></not></condition>
                            <widgets>
                                <container style="button-bar">
                                    <link target="PrintLeaseAgreement.pdf" text="${uiLabelMap.FinanceLeasePrintAgreementPdf}" style="buttontext" target-window="_blank">
                                        <parameter param-name="leaseAgreementId" from-field="leaseAgreement.leaseAgreementId"/>
                                    </link>
                                    <!-- STEP L8: acceptance certificate / expiry notice -->
                                    <section>
                                        <condition><not><if-empty field="leaseAcceptance"/></not></condition>
                                        <widgets>
                                            <link target="PrintLeaseDocument.pdf" text="${uiLabelMap.FinanceLeasePrintAcceptance}" style="buttontext" target-window="_blank">
                                                <parameter param-name="leaseAgreementId" from-field="leaseAgreement.leaseAgreementId"/>
                                                <parameter param-name="documentType" value="ACCEPTANCE"/>
                                            </link>
                                        </widgets>
                                    </section>
                                    <section>
                                        <condition><not><if-empty field="expiryNotice"/></not></condition>
                                        <widgets>
                                            <link target="PrintLeaseDocument.pdf" text="${uiLabelMap.FinanceLeasePrintExpiryNotice}" style="buttontext" target-window="_blank">
                                                <parameter param-name="leaseAgreementId" from-field="leaseAgreement.leaseAgreementId"/>
                                                <parameter param-name="documentType" value="EXPIRY"/>
                                            </link>
                                        </widgets>
                                    </section>
                                    <link target="FinanceCustomerSummary" text="${uiLabelMap.FinanceCustomerSummary}" style="buttontext">
                                        <parameter param-name="customerPartyId" from-field="leaseAgreement.lesseePartyId"/>
                                    </link>
                                    <link target="FinanceContractParties" text="${uiLabelMap.FinanceContractParties}" style="buttontext">
                                        <parameter param-name="financeContractId" from-field="leaseAgreement.financeContractId"/>
                                    </link>
                                </container>
                                <screenlet title="${uiLabelMap.FinanceLeaseAgreement}">
                                    <include-form name="ViewLeaseAgreementHeader" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                    <section>
                                        <condition><if-compare field="canCancel" operator="equals" value="true" type="Boolean"/></condition>
                                        <widgets>
                                            <container style="button-bar">
                                                <link target="setLeaseAgreementStatus" text="${uiLabelMap.FinanceLeaseCancelAgreement}" style="buttontext"
                                                        link-type="hidden-form" request-confirmation="true" confirmation-message="${uiLabelMap.FinanceLeaseCancelAgreementConfirm}">
                                                    <parameter param-name="leaseAgreementId" from-field="leaseAgreement.leaseAgreementId"/>
                                                    <parameter param-name="statusId" value="LEASEAGR_CANCELLED"/>
                                                </link>
                                            </container>
                                        </widgets>
                                    </section>
                                </screenlet>
                                <screenlet title="${uiLabelMap.FinanceLeaseAssets}">
                                    <include-grid name="ListLeaseAgreementAssets" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <section>
                                    <condition><not><if-empty field="leaseAcceptance"/></not></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseAcceptance}">
                                            <include-form name="ViewLeaseAcceptance" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                                <section>
                                    <condition><if-compare field="canAccept" operator="equals" value="true" type="Boolean"/></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseAcceptance}">
                                            <include-form name="AcceptLeaseAgreement" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                                <screenlet title="${uiLabelMap.FinanceLeaseConfirmedSchedule} (${uiLabelMap.FinanceScheduleRevision} ${scheduleRevisionNumber})">
                                    <include-grid name="ListLeasePaymentSchedule" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                </screenlet>
                                <section>
                                    <condition><not><if-empty field="componentLines"/></not></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseComponents}">
                                            <include-grid name="ListLeaseAgreementComponents" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                                <!-- STEP L4: billing, deferred profit release, payments -->
                                <section>
                                    <condition><not><if-empty field="leaseAcceptance"/></not></condition>
                                    <widgets>
                                        <screenlet title="${uiLabelMap.FinanceLeaseBalance}">
                                            <include-form name="ViewLeaseBalance" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <section>
                                            <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                            <widgets>
                                                <screenlet title="${uiLabelMap.FinanceLeaseBillInstallment}">
                                                    <include-form name="CreateLeaseInstallmentInvoice" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </screenlet>
                                                <screenlet title="${uiLabelMap.FinanceLeaseRecognizeProfit}">
                                                    <include-form name="RecognizeLeaseProfit" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </screenlet>
                                                <screenlet title="${uiLabelMap.FinanceLeaseReceivePayment}">
                                                    <include-form name="ReceiveLeasePayment" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </screenlet>
                                            </widgets>
                                        </section>
                                        <screenlet title="${uiLabelMap.FinanceLeaseInvoices}">
                                            <include-grid name="ListLeaseInstallmentInvoices" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <screenlet title="${uiLabelMap.FinanceLeaseProfitRecognitions}">
                                            <include-grid name="ListLeaseProfitRecognitions" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L12: depreciation of operating lease assets -->
                                        <section>
                                            <condition><if-compare field="isOperating" operator="equals" value="true" type="Boolean"/></condition>
                                            <widgets>
                                                <screenlet title="${uiLabelMap.FinanceLeaseDepreciation}">
                                                    <section>
                                                        <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                                        <widgets>
                                                            <include-form name="DepreciateLeaseAssets" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                        </widgets>
                                                    </section>
                                                    <include-grid name="ListLeaseAssetDepreciation" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </screenlet>
                                            </widgets>
                                        </section>
                                        <screenlet title="${uiLabelMap.FinanceLeasePaymentReceipts}">
                                            <include-grid name="ListLeasePaymentReceipts" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L6: delinquency, late fee, dunning -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseDelinquency}">
                                            <include-grid name="ListLeaseDelinquencies" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <section>
                                                <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="RunLeaseLateFeeAccrual" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseLateFeeAccruals" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <screenlet title="${uiLabelMap.FinanceDunningNotices}">
                                            <include-form name="CreateLeaseDunningNotice" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <include-grid name="ListLeaseDunningNotices" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <screenlet title="${uiLabelMap.FinanceDelinquencyActions}">
                                            <include-grid name="ListLeaseDelinquencyActions" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L7: expiry and tasks -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseExpiry}">
                                            <section>
                                                <condition><if-compare field="canIssueNotice" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="IssueLeaseExpiryNotice" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                                <fail-widgets>
                                                    <label text="${uiLabelMap.FinanceLeaseExpiryNoticeDate}: ${expiryNotice.noticeDate}"/>
                                                </fail-widgets>
                                            </section>
                                            <section>
                                                <condition><if-compare field="canTransfer" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="TransferLeaseOwnership" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <section>
                                                <condition><not><if-empty field="returnedAssets"/></not></condition>
                                                <widgets>
                                                    <include-form name="DisposeLeaseAsset" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <section>
                                                <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="CompleteLeaseAgreement" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseAssetSettlements" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L15: change of terms -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseModification}">
                                            <section>
                                                <condition><if-compare field="canModify" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="CalculateLeaseModification" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                    <section>
                                                        <condition><not><if-empty field="modificationQuote"/></not></condition>
                                                        <widgets>
                                                            <include-form name="ViewLeaseModificationQuote" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                        </widgets>
                                                    </section>
                                                    <include-form name="CreateLeaseModification" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseModifications" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L14: early termination -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseTermination}">
                                            <section>
                                                <condition><not><if-empty field="leaseTermination"/></not></condition>
                                                <widgets>
                                                    <include-form name="ViewLeaseTermination" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                                <fail-widgets>
                                                    <section>
                                                        <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                                        <widgets>
                                                            <include-form name="CalculateLeaseTermination" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                            <section>
                                                                <condition><not><if-empty field="terminationQuote"/></not></condition>
                                                                <widgets>
                                                                    <include-form name="ViewLeaseTerminationQuote" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                                </widgets>
                                                            </section>
                                                            <include-form name="TerminateLeaseAgreement" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                        </widgets>
                                                    </section>
                                                </fail-widgets>
                                            </section>
                                        </screenlet>
                                        <!-- STEP L13: re-lease -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseReLease}">
                                            <section>
                                                <condition><if-compare field="canCreateReLease" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="CreateLeaseReLease" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseReLeases" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                        <!-- STEP L11: maintenance -->
                                        <screenlet title="${uiLabelMap.FinanceLeaseMaintenance}">
                                            <include-form name="ViewLeaseMaintSummary" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <section>
                                                <condition><if-compare field="canAddMaintPlan" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="CreateLeaseMaintPlan" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseMaintPlans" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <section>
                                                <condition><if-compare field="isActive" operator="equals" value="true" type="Boolean"/></condition>
                                                <widgets>
                                                    <include-form name="RunLeaseMaintScheduleBatch" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                    <include-form name="CreateLeaseMaintenance" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                            <include-grid name="ListLeaseMaintRecords" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                            <section>
                                                <condition><not><if-empty field="scheduledMaintRecords"/></not></condition>
                                                <widgets>
                                                    <include-form name="CompleteLeaseMaintenance" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                                </widgets>
                                            </section>
                                        </screenlet>
                                        <screenlet title="${uiLabelMap.FinanceContractTasks}">
                                            <include-grid name="ListFinanceContractTasks" location="component://finance/widget/FinanceLeaseForms.xml"/>
                                        </screenlet>
                                    </widgets>
                                </section>
                            </widgets>
                            <fail-widgets>
                                <label text="${uiLabelMap.FinanceRecordNotFound}"/>
                            </fail-widgets>
                        </section>
                    </decorator-section>
                </decorator-screen>
            </widgets>
        </section>
    </screen>

    <!-- Leases nearing expiry and the expiry task batch (STEP L7) -->
