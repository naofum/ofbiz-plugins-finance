<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Finance Component Entity Model - Lease layer STEP L1-L2 (products, applications, quotes, agreements)</title>
    <description>
        Lease products extend FinancialProduct 1:1 with lease-specific terms
        (FinancialProductLease). Leased assets reuse the core FixedAsset /
        FixedAssetType. A LeaseApplication is the lease-only application; the
        requested assets are LeaseApplicationAsset rows. Underwriting is the
        common review (LoanUnderwriting with applicationTypeId=LEASE).
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- Lease product terms (1:1 with FinancialProduct)           -->
    <!-- ========================================================= -->
    <entity entity-name="FinancialProductLease" package-name="org.apache.ofbiz.finance.lease"
            title="Financial Product - lease terms">
        <field name="productId" type="id"><description>FK to FinancialProduct (1:1); the product type must be under LEASE</description></field>
        <field name="leaseClassEnumId" type="id"><description>LEASE_CLASS: finance transfer / finance non-transfer / operating; derived from the product type</description></field>
        <field name="defaultMonthlyRateFactor" type="fixed-point"><description>default monthly lease rate factor (monthly lease amount / acquisition cost, e.g. 0.018000)</description></field>
        <field name="defaultCalcInterestRate" type="fixed-point"><description>default annual calculation interest rate of the lessor (e.g. 0.030000)</description></field>
        <field name="paymentTimingEnumId" type="id"><description>LEASE_PAY_TIMING: ADVANCE (first payment at start) / ARREARS</description></field>
        <field name="residualValueRate" type="fixed-point"><description>estimated residual value / acquisition cost (0 to 1); non-transfer default 0</description></field>
        <field name="revenueMethodEnumId" type="id"><description>LEASE_REV_METHOD: revenue recognition method; initially LEASE_REV_AT_START</description></field>
        <field name="taxable" type="indicator"><description>Y when lease payments are subject to consumption tax (default Y)</description></field>
        <field name="taxTimingEnumId" type="id"><description>LEASE_TAX_TIMING: taxable sale per installment or lump sum at the lease start (STEP L5); empty = lease.tax.timing</description></field>
        <prim-key field="productId"/>
        <relation type="one" fk-name="FINPRODLS_PROD" rel-entity-name="FinancialProduct">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="FINPRODLS_CLASS" title="LeaseClass" rel-entity-name="Enumeration">
            <key-map field-name="leaseClassEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="FINPRODLS_TIMING" title="PaymentTiming" rel-entity-name="Enumeration">
            <key-map field-name="paymentTimingEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="FINPRODLS_REVMTH" title="RevenueMethod" rel-entity-name="Enumeration">
            <key-map field-name="revenueMethodEnumId" rel-field-name="enumId"/>
        </relation>
    </entity>

    <!-- Asset types a lease product may finance (no rows = any type) -->
    <entity entity-name="FinancialProductLeaseAssetType" package-name="org.apache.ofbiz.finance.lease"
            title="Lease product - allowed asset type">
        <field name="productId" type="id"></field>
        <field name="fixedAssetTypeId" type="id"></field>
        <prim-key field="productId"/>
        <prim-key field="fixedAssetTypeId"/>
        <relation type="one" fk-name="FINPRODLSAT_PROD" rel-entity-name="FinancialProductLease">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="FINPRODLSAT_TYPE" rel-entity-name="FixedAssetType">
            <key-map field-name="fixedAssetTypeId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- LeaseApplication: a lease application from a lessee       -->
    <!-- ========================================================= -->
    <entity entity-name="LeaseApplication" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Application">
        <field name="leaseApplicationId" type="id"><description>primary sequenced ID</description></field>
        <field name="productId" type="id"><description>applied-for lease product (FinancialProductLease)</description></field>
        <field name="applicantPartyId" type="id"><description>prospective lessee (person or organization)</description></field>
        <field name="statusId" type="id"><description>LEASE_APP_STATUS; changed only by setLeaseApplicationStatus</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="requestedTermMonths" type="numeric"></field>
        <field name="applicationDate" type="date-time"></field>
        <field name="purpose" type="description"></field>
        <field name="comments" type="comment"></field>
        <prim-key field="leaseApplicationId"/>
        <relation type="one" fk-name="LEASEAPP_PROD" rel-entity-name="FinancialProductLease">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPP_PARTY" rel-entity-name="Party">
            <key-map field-name="applicantPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPP_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPP_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <relation type="many" rel-entity-name="LeaseApplicationAsset">
            <key-map field-name="leaseApplicationId"/>
        </relation>
    </entity>

    <!-- Status history of a lease application -->
    <entity entity-name="LeaseApplicationStatus" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Application Status History">
        <field name="leaseApplicationId" type="id"></field>
        <field name="statusId" type="id"></field>
        <field name="statusDate" type="date-time"></field>
        <field name="changeByUserLoginId" type="id-vlong"></field>
        <prim-key field="leaseApplicationId"/>
        <prim-key field="statusId"/>
        <prim-key field="statusDate"/>
        <relation type="one" fk-name="LEASEAPPST_APP" rel-entity-name="LeaseApplication">
            <key-map field-name="leaseApplicationId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPPST_ST" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </entity>

    <!-- Requested asset of a lease application (application 1:N) -->
    <entity entity-name="LeaseApplicationAsset" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Application - requested asset">
        <field name="leaseApplicationId" type="id"></field>
        <field name="assetSeqId" type="id"><description>line number within the application (00001, 00002, ...)</description></field>
        <field name="fixedAssetTypeId" type="id"></field>
        <field name="assetName" type="name"></field>
        <field name="quantity" type="fixed-point"></field>
        <field name="estimatedAcquisitionCost" type="currency-amount"><description>estimated acquisition cost of the line (all units, tax excluded), in the application currency</description></field>
        <field name="supplierPartyId" type="id"><description>dealer / supplier the lessor buys the asset from</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="leaseApplicationId"/>
        <prim-key field="assetSeqId"/>
        <relation type="one" fk-name="LEASEAPPAS_APP" rel-entity-name="LeaseApplication">
            <key-map field-name="leaseApplicationId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPPAS_TYPE" rel-entity-name="FixedAssetType">
            <key-map field-name="fixedAssetTypeId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPPAS_SUPP" title="Supplier" rel-entity-name="Party">
            <key-map field-name="supplierPartyId" rel-field-name="partyId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L2: lease quote (immutable after creation)           -->
    <!-- ========================================================= -->
    <entity entity-name="LeaseQuote" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Quote">
        <field name="leaseQuoteId" type="id"><description>primary sequenced ID</description></field>
        <field name="leaseApplicationId" type="id"></field>
        <field name="statusId" type="id"><description>LEASE_QUOTE_STATUS; changed only by setLeaseQuoteStatus</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="calcMethodEnumId" type="id"><description>LEASE_CALC_METHOD: rate factor or calculation interest rate</description></field>
        <field name="acquisitionCost" type="currency-amount"><description>sum of the quoted asset acquisition costs (tax excluded)</description></field>
        <field name="residualValue" type="currency-amount"><description>estimated residual value at the end of the term</description></field>
        <field name="termMonths" type="numeric"></field>
        <field name="paymentTimingEnumId" type="id"><description>LEASE_PAY_TIMING</description></field>
        <field name="monthlyLeaseAmount" type="currency-amount"><description>monthly lease payment (tax excluded)</description></field>
        <field name="monthlyRateFactor" type="fixed-point"><description>monthly lease amount / acquisition cost</description></field>
        <field name="calcInterestRate" type="fixed-point"><description>annual nominal calculation interest rate of the lessor (given or solved)</description></field>
        <field name="totalLeaseAmount" type="currency-amount"><description>sum of the lease payments (tax excluded)</description></field>
        <field name="totalInterestAmount" type="currency-amount"><description>total interest equivalent = total lease amount - (acquisition cost - residual value)</description></field>
        <field name="taxRate" type="fixed-point"><description>consumption tax rate used for display (0 when not taxable)</description></field>
        <field name="totalTaxAmount" type="currency-amount"></field>
        <field name="leaseStartDate" type="date-time"><description>expected lease start date (fixed at acceptance in STEP L3)</description></field>
        <field name="firstPaymentDate" type="date-time"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseQuoteId"/>
        <relation type="one" fk-name="LEASEQT_APP" rel-entity-name="LeaseApplication">
            <key-map field-name="leaseApplicationId"/>
        </relation>
        <relation type="one" fk-name="LEASEQT_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="one" fk-name="LEASEQT_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <relation type="one" fk-name="LEASEQT_METHOD" title="CalcMethod" rel-entity-name="Enumeration">
            <key-map field-name="calcMethodEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LEASEQT_TIMING" title="PaymentTiming" rel-entity-name="Enumeration">
            <key-map field-name="paymentTimingEnumId" rel-field-name="enumId"/>
        </relation>
    </entity>

    <!-- Asset lines fixed by the quote (copied from the requested assets) -->
    <entity entity-name="LeaseQuoteAsset" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Quote - asset">
        <field name="leaseQuoteId" type="id"></field>
        <field name="assetSeqId" type="id"></field>
        <field name="fixedAssetTypeId" type="id"></field>
        <field name="assetName" type="name"></field>
        <field name="quantity" type="fixed-point"></field>
        <field name="acquisitionCost" type="currency-amount"><description>acquisition cost of the line (all units, tax excluded)</description></field>
        <field name="supplierPartyId" type="id"></field>
        <prim-key field="leaseQuoteId"/>
        <prim-key field="assetSeqId"/>
        <relation type="one" fk-name="LEASEQTAS_QT" rel-entity-name="LeaseQuote">
            <key-map field-name="leaseQuoteId"/>
        </relation>
        <relation type="one" fk-name="LEASEQTAS_TYPE" rel-entity-name="FixedAssetType">
            <key-map field-name="fixedAssetTypeId"/>
        </relation>
        <relation type="one" fk-name="LEASEQTAS_SUPP" title="Supplier" rel-entity-name="Party">
            <key-map field-name="supplierPartyId" rel-field-name="partyId"/>
        </relation>
    </entity>

    <!-- Quote lease payment schedule -->
    <entity entity-name="LeasePaymentSchedule" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Quote - payment schedule">
        <field name="leaseQuoteId" type="id"></field>
        <field name="installmentNumber" type="numeric"></field>
        <field name="dueDate" type="date-time"><description>payment due date (business-day adjusted)</description></field>
        <field name="periodFromDate" type="date-time"><description>first day of the lease period covered by the payment</description></field>
        <field name="periodThruDate" type="date-time"><description>last day of the lease period covered by the payment</description></field>
        <field name="leaseAmount" type="currency-amount"><description>lease payment (tax excluded)</description></field>
        <field name="principalPortion" type="currency-amount"><description>principal recovery (interest method)</description></field>
        <field name="interestPortion" type="currency-amount"><description>interest equivalent (interest method)</description></field>
        <field name="taxAmount" type="currency-amount"></field>
        <field name="remainingPrincipal" type="currency-amount"><description>principal outstanding after the payment (ends at the residual value)</description></field>
        <prim-key field="leaseQuoteId"/>
        <prim-key field="installmentNumber"/>
        <relation type="one" fk-name="LEASEPS_QT" rel-entity-name="LeaseQuote">
            <key-map field-name="leaseQuoteId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L2: lease agreement (1:1 FinanceContract)            -->
    <!-- ========================================================= -->
    <entity entity-name="LeaseAgreement" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Agreement">
        <field name="leaseAgreementId" type="id"><description>primary sequenced ID</description></field>
        <field name="financeContractId" type="id"><description>common contract ledger row (contractTypeId=LEASE, 1:1)</description></field>
        <field name="leaseApplicationId" type="id"></field>
        <field name="leaseQuoteId" type="id"><description>accepted quote; one agreement per quote</description></field>
        <field name="statusId" type="id"><description>LEASE_AGR_STATUS; changed only by the lease status services</description></field>
        <field name="organizationPartyId" type="id"><description>lessor organization</description></field>
        <field name="lesseePartyId" type="id"></field>
        <field name="supplierPartyId" type="id"><description>supplier when all assets come from one supplier</description></field>
        <field name="productId" type="id"></field>
        <field name="currencyUomId" type="id"></field>
        <field name="leaseClassEnumId" type="id"></field>
        <field name="revenueMethodEnumId" type="id"></field>
        <field name="paymentTimingEnumId" type="id"></field>
        <field name="calcMethodEnumId" type="id"></field>
        <field name="acquisitionCost" type="currency-amount"></field>
        <field name="residualValue" type="currency-amount"></field>
        <field name="termMonths" type="numeric"></field>
        <field name="monthlyLeaseAmount" type="currency-amount"></field>
        <field name="monthlyRateFactor" type="fixed-point"></field>
        <field name="calcInterestRate" type="fixed-point"></field>
        <field name="totalLeaseAmount" type="currency-amount"></field>
        <field name="totalInterestAmount" type="currency-amount"></field>
        <field name="taxRate" type="fixed-point"></field>
        <field name="totalTaxAmount" type="currency-amount"></field>
        <field name="agreementDate" type="date-time"></field>
        <field name="firstPaymentDate" type="date-time"><description>provisional until the lease start (STEP L3)</description></field>
        <field name="leaseStartDate" type="date-time"><description>acceptance date = lease start (set in STEP L3)</description></field>
        <field name="leaseEndDate" type="date-time"><description>set in STEP L3</description></field>
        <field name="taxTimingEnumId" type="id"><description>LEASE_TAX_TIMING fixed at the lease start (STEP L5)</description></field>
        <field name="taxAuthPartyId" type="id"><description>tax authority of the rate fixed at the lease start (empty = no core tax authority)</description></field>
        <field name="taxAuthGeoId" type="id"></field>
        <field name="taxAuthorityRateSeqId" type="id"><description>core TaxAuthorityRateProduct of the fixed rate</description></field>
        <field name="completedDate" type="date-time"><description>date the lease was completed by return / ownership transfer (STEP L7)</description></field>
        <prim-key field="leaseAgreementId"/>
        <relation type="one" fk-name="LEASEAGR_FINCTR" rel-entity-name="FinanceContract">
            <key-map field-name="financeContractId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_APP" rel-entity-name="LeaseApplication">
            <key-map field-name="leaseApplicationId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_QT" rel-entity-name="LeaseQuote">
            <key-map field-name="leaseQuoteId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_ORG" title="Organization" rel-entity-name="Party">
            <key-map field-name="organizationPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_LESSEE" title="Lessee" rel-entity-name="Party">
            <key-map field-name="lesseePartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one-nofk" title="Supplier" rel-entity-name="Party">
            <key-map field-name="supplierPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_PROD" rel-entity-name="FinancialProductLease">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGR_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <index name="LEASEAGR_QT_UQ" unique="true">
            <index-field name="leaseQuoteId"/>
        </index>
        <index name="LEASEAGR_FINCTR_UQ" unique="true">
            <index-field name="financeContractId"/>
        </index>
    </entity>

    <!-- Confirmed lease payment schedule (billing reads only this) -->
    <entity entity-name="LeaseAgreementPaymentSchedule" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Agreement - confirmed payment schedule">
        <field name="leaseAgreementId" type="id"></field>
        <field name="scheduleRevisionNumber" type="numeric"></field>
        <field name="installmentNumber" type="numeric"></field>
        <field name="leaseQuoteId" type="id"><description>source quote of the revision</description></field>
        <field name="dueDate" type="date-time"></field>
        <field name="periodFromDate" type="date-time"></field>
        <field name="periodThruDate" type="date-time"></field>
        <field name="leaseAmount" type="currency-amount"></field>
        <field name="principalPortion" type="currency-amount"></field>
        <field name="interestPortion" type="currency-amount"></field>
        <field name="taxAmount" type="currency-amount"></field>
        <field name="remainingPrincipal" type="currency-amount"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="scheduleRevisionNumber"/>
        <prim-key field="installmentNumber"/>
        <relation type="one" fk-name="LEASEAPS_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEAPS_QT" rel-entity-name="LeaseQuote">
            <key-map field-name="leaseQuoteId"/>
        </relation>
    </entity>

    <!-- Assets of the agreement (FixedAsset linked at purchase / acceptance, STEP L3) -->
    <entity entity-name="LeaseAgreementAsset" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Agreement - asset">
        <field name="leaseAgreementId" type="id"></field>
        <field name="assetSeqId" type="id"></field>
        <field name="fixedAssetTypeId" type="id"></field>
        <field name="assetName" type="name"></field>
        <field name="quantity" type="fixed-point"></field>
        <field name="acquisitionCost" type="currency-amount"></field>
        <field name="supplierPartyId" type="id"></field>
        <field name="fixedAssetId" type="id"><description>core FixedAsset owned by the lessor (STEP L3)</description></field>
        <field name="assetStatusId" type="id"><description>LEASE_ASSET_STATUS: pending purchase / purchased / leased / returned / transferred (STEP L3)</description></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="assetSeqId"/>
        <relation type="one" fk-name="LEASEAGRAS_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRAS_TYPE" rel-entity-name="FixedAssetType">
            <key-map field-name="fixedAssetTypeId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRAS_SUPP" title="Supplier" rel-entity-name="Party">
            <key-map field-name="supplierPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRAS_FA" rel-entity-name="FixedAsset">
            <key-map field-name="fixedAssetId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRAS_STTS" rel-entity-name="StatusItem">
            <key-map field-name="assetStatusId" rel-field-name="statusId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L3: purchase of the leased assets and acceptance     -->
    <!-- ========================================================= -->
    <entity entity-name="LeaseAssetPurchase" package-name="org.apache.ofbiz.finance.lease"
            title="Lease asset purchase from the supplier">
        <field name="leaseAgreementId" type="id"></field>
        <field name="assetSeqId" type="id"></field>
        <field name="supplierPartyId" type="id"></field>
        <field name="invoiceId" type="id"><description>core purchase invoice of the supplier</description></field>
        <field name="supplierInvoiceRef" type="short-varchar"><description>supplier's invoice number</description></field>
        <field name="purchaseDate" type="date-time"></field>
        <field name="amount" type="currency-amount"><description>acquisition cost (tax excluded) = the agreement asset line</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="fixedAssetId" type="id"></field>
        <field name="paymentId" type="id"><description>core vendor payment applied to the purchase invoice</description></field>
        <field name="paidDate" type="date-time"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="assetSeqId"/>
        <relation type="one" fk-name="LEASEPUR_ASSET" rel-entity-name="LeaseAgreementAsset">
            <key-map field-name="leaseAgreementId"/>
            <key-map field-name="assetSeqId"/>
        </relation>
        <relation type="one" fk-name="LEASEPUR_SUPP" title="Supplier" rel-entity-name="Party">
            <key-map field-name="supplierPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEPUR_INV" rel-entity-name="Invoice">
            <key-map field-name="invoiceId"/>
        </relation>
        <relation type="one" fk-name="LEASEPUR_PMT" rel-entity-name="Payment">
            <key-map field-name="paymentId"/>
        </relation>
        <relation type="one" fk-name="LEASEPUR_FA" rel-entity-name="FixedAsset">
            <key-map field-name="fixedAssetId"/>
        </relation>
    </entity>

    <!-- Acceptance by the lessee = lease start (one per agreement) -->
    <entity entity-name="LeaseAcceptance" package-name="org.apache.ofbiz.finance.lease"
            title="Lease acceptance (lease start)">
        <field name="leaseAgreementId" type="id"></field>
        <field name="acceptanceDate" type="date-time"><description>acceptance date = lease start date</description></field>
        <field name="acceptedByPartyId" type="id"></field>
        <field name="comments" type="comment"></field>
        <field name="scheduleRevisionNumber" type="numeric"><description>revision of the confirmed schedule dated from the lease start</description></field>
        <field name="startAcctgTransId" type="id"><description>lease start entries (revenue method)</description></field>
        <field name="startTaxAcctgTransId" type="id"><description>lump-sum consumption tax at the lease start (STEP L5, LEASE_TAX_AT_START only)</description></field>
        <field name="receiptPrintedDate" type="date-time"><description>when the acceptance certificate was issued (STEP L8)</description></field>
        <field name="createdByUserLogin" type="id-vlong"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseAgreementId"/>
        <relation type="one" fk-name="LEASEACC_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEACC_PARTY" title="AcceptedBy" rel-entity-name="Party">
            <key-map field-name="acceptedByPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASEACC_TRANS" rel-entity-name="AcctgTrans">
            <key-map field-name="startAcctgTransId" rel-field-name="acctgTransId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L4: billing, deferred profit release, payments       -->
    <!-- ========================================================= -->
    <!-- One sales invoice per installment of the confirmed schedule -->
    <entity entity-name="LeaseInstallmentInvoice" package-name="org.apache.ofbiz.finance.lease"
            title="Lease installment to Invoice link">
        <field name="leaseAgreementId" type="id"></field>
        <field name="installmentNumber" type="numeric"></field>
        <field name="scheduleRevisionNumber" type="numeric"><description>revision of the confirmed schedule that was billed</description></field>
        <field name="invoiceId" type="id"><description>core SALES_INVOICE (READY)</description></field>
        <field name="dueDate" type="date-time"></field>
        <field name="leaseAmount" type="currency-amount"><description>lease payment billed (tax excluded)</description></field>
        <field name="principalPortion" type="currency-amount"></field>
        <field name="interestPortion" type="currency-amount"></field>
        <field name="taxAmount" type="currency-amount"></field>
        <field name="componentAmount" type="currency-amount"><description>STEP L9: total of the billed payment components (tax excluded)</description></field>
        <field name="componentTaxAmount" type="currency-amount"><description>STEP L9: total consumption tax of the billed payment components</description></field>
        <field name="billedAmount" type="currency-amount"><description>lease amount + tax + components + component tax</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="installmentNumber"/>
        <relation type="one" fk-name="LEASEII_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEII_INV" rel-entity-name="Invoice">
            <key-map field-name="invoiceId"/>
        </relation>
        <index name="LEASEII_INV_UQ" unique="true">
            <index-field name="invoiceId"/>
        </index>
    </entity>

    <!-- Release of the deferred lease profit (method 1), one row per recognized period -->
    <entity entity-name="LeaseProfitRecognition" package-name="org.apache.ofbiz.finance.lease"
            title="Lease deferred profit recognition">
        <field name="leaseProfitRecognitionId" col-name="LEASE_PROFIT_RECOG_ID" type="id"><description>primary sequenced ID</description></field>
        <field name="leaseAgreementId" type="id"></field>
        <field name="fromDate" type="date-time"><description>first day recognized (day start)</description></field>
        <field name="thruDate" type="date-time"><description>last day recognized (day start, inclusive)</description></field>
        <field name="amount" type="currency-amount"><description>interest equivalent recognized in the period</description></field>
        <field name="cumulativeAmount" type="currency-amount"><description>cumulative recognized through thruDate</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="acctgTransId" type="id"><description>Dr deferred lease profit / Cr deferred profit release (none when 0)</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseProfitRecognitionId"/>
        <relation type="one" fk-name="LEASEPRC_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEPRC_TRANS" rel-entity-name="AcctgTrans">
            <key-map field-name="acctgTransId"/>
        </relation>
        <index name="LEASEPRC_FROM_UQ" unique="true">
            <index-field name="leaseAgreementId"/>
            <index-field name="fromDate"/>
        </index>
    </entity>

    <!-- Customer payment received for a lease agreement (core Payment, applied to lease invoices) -->
    <entity entity-name="LeasePaymentReceipt" package-name="org.apache.ofbiz.finance.lease"
            title="Lease payment receipt">
        <field name="leasePaymentReceiptId" type="id"></field>
        <field name="leaseAgreementId" type="id"></field>
        <field name="paymentId" type="id"></field>
        <field name="invoiceId" type="id"><description>invoice given by the caller (empty = applied to open invoices oldest first)</description></field>
        <field name="amount" type="currency-amount"></field>
        <field name="currencyUomId" type="id"></field>
        <field name="receiptDate" type="date-time"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leasePaymentReceiptId"/>
        <relation type="one" fk-name="LEASEPR_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEPR_PAY" rel-entity-name="Payment">
            <key-map field-name="paymentId"/>
        </relation>
        <relation type="one-nofk" rel-entity-name="Invoice">
            <key-map field-name="invoiceId"/>
        </relation>
        <index name="LEASEPR_PAY_UQ" unique="true">
            <index-field name="paymentId"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L7: expiry (notice, return, disposal, transfer)       -->
    <!-- ========================================================= -->
    <!-- Expiry notice to the lessee (one per agreement; the PDF is STEP L8) -->
    <entity entity-name="LeaseExpiryNotice" package-name="org.apache.ofbiz.finance.lease"
            title="Lease expiry notice">
        <field name="leaseAgreementId" type="id"></field>
        <field name="noticeDate" type="date-time"></field>
        <field name="leaseEndDate" type="date-time"><description>lease end date the notice refers to</description></field>
        <field name="comments" type="comment"></field>
        <field name="createdByUserLogin" type="id-vlong"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseAgreementId"/>
        <relation type="one" fk-name="LEASEEXN_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
    </entity>

    <!-- End of the lease of one asset: return (no transfer) or ownership transfer, and disposal -->
    <entity entity-name="LeaseAssetSettlement" package-name="org.apache.ofbiz.finance.lease"
            title="Lease asset settlement at expiry">
        <field name="leaseAgreementId" type="id"></field>
        <field name="assetSeqId" type="id"></field>
        <field name="residualValue" type="currency-amount"><description>residual value of the asset (agreement residual allocated by acquisition cost)</description></field>
        <field name="returnDate" type="date-time"><description>return / pickup date (no ownership transfer)</description></field>
        <field name="returnComments" type="comment"></field>
        <field name="transferDate" type="date-time"><description>ownership transfer date (transfer leases)</description></field>
        <field name="disposalTypeEnumId" type="id"><description>LEASE_DISPOSAL_TYPE (sale / scrap); transfer = sale to the lessee</description></field>
        <field name="disposalDate" type="date-time"></field>
        <field name="disposalPartyId" type="id"><description>buyer (sale) or the lessee (transfer)</description></field>
        <field name="proceedsAmount" type="currency-amount"><description>sale / transfer price (tax excluded)</description></field>
        <field name="gainLossAmount" type="currency-amount"><description>proceeds - residual (positive = gain)</description></field>
        <field name="acctgTransId" type="id"><description>settlement of the residual value (none when residual and proceeds are 0)</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="assetSeqId"/>
        <relation type="one" fk-name="LEASESTL_ASSET" rel-entity-name="LeaseAgreementAsset">
            <key-map field-name="leaseAgreementId"/>
            <key-map field-name="assetSeqId"/>
        </relation>
        <relation type="one" fk-name="LEASESTL_DTYPE" rel-entity-name="Enumeration">
            <key-map field-name="disposalTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one-nofk" title="Disposal" rel-entity-name="Party">
            <key-map field-name="disposalPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LEASESTL_TRANS" rel-entity-name="AcctgTrans">
            <key-map field-name="acctgTransId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L9: lease payment components (維持管理費用相当額)       -->
    <!-- Cost parts of the lease payment other than principal and  -->
    <!-- the interest equivalent: property tax equivalent,         -->
    <!-- insurance, maintenance. A component has a level monthly    -->
    <!-- amount, a consumption-tax classification (4 kinds) and a   -->
    <!-- revenue treatment (separate / included in method 1 sales). -->
    <!-- ========================================================= -->

    <!-- Component definition on a quote (one row per component) -->
    <entity entity-name="LeaseQuoteComponent" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Quote - payment component definition">
        <field name="leaseQuoteId" type="id"></field>
        <field name="componentSeqId" type="id"><description>line number within the quote (00001, 00002, ...)</description></field>
        <field name="componentTypeEnumId" type="id"><description>LEASE_COMPONENT_TYPE: property tax / insurance / maintenance / other</description></field>
        <field name="description" type="description"></field>
        <field name="monthlyAmount" type="currency-amount"><description>level monthly component amount (tax excluded)</description></field>
        <field name="taxClassEnumId" type="id"><description>LEASE_TAX_CLASS: taxable / exempt / non-taxable / zero-rated (免税)</description></field>
        <field name="revenueTreatmentEnumId" type="id"><description>LEASE_CMP_REVENUE: separate revenue (区分, default) or included in the method-1 sales (含める)</description></field>
        <field name="totalAmount" type="currency-amount"><description>monthly amount x term (tax excluded)</description></field>
        <field name="totalTaxAmount" type="currency-amount"></field>
        <prim-key field="leaseQuoteId"/>
        <prim-key field="componentSeqId"/>
        <relation type="one" fk-name="LEASEQTCMP_QT" rel-entity-name="LeaseQuote">
            <key-map field-name="leaseQuoteId"/>
        </relation>
        <relation type="one" fk-name="LEASEQTCMP_TYPE" title="ComponentType" rel-entity-name="Enumeration">
            <key-map field-name="componentTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LEASEQTCMP_TAXCL" title="TaxClass" rel-entity-name="Enumeration">
            <key-map field-name="taxClassEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LEASEQTCMP_REV" title="RevenueTreatment" rel-entity-name="Enumeration">
            <key-map field-name="revenueTreatmentEnumId" rel-field-name="enumId"/>
        </relation>
    </entity>

    <!-- Per-installment component amount of a quote schedule row -->
    <entity entity-name="LeasePaymentScheduleComp" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Quote - payment schedule component amount">
        <field name="leaseQuoteId" type="id"></field>
        <field name="installmentNumber" type="numeric"></field>
        <field name="componentSeqId" type="id"></field>
        <field name="componentTypeEnumId" type="id"></field>
        <field name="amount" type="currency-amount"><description>component amount of the installment (tax excluded)</description></field>
        <field name="taxAmount" type="currency-amount"></field>
        <field name="taxClassEnumId" type="id"></field>
        <field name="revenueTreatmentEnumId" type="id"></field>
        <prim-key field="leaseQuoteId"/>
        <prim-key field="installmentNumber"/>
        <prim-key field="componentSeqId"/>
        <relation type="one" fk-name="LEASEPSCMP_PS" rel-entity-name="LeasePaymentSchedule">
            <key-map field-name="leaseQuoteId"/>
            <key-map field-name="installmentNumber"/>
        </relation>
        <relation type="one" fk-name="LEASEPSCMP_CMP" rel-entity-name="LeaseQuoteComponent">
            <key-map field-name="leaseQuoteId"/>
            <key-map field-name="componentSeqId"/>
        </relation>
    </entity>

    <!-- Component definition on an agreement (snapshot of the quote) -->
    <entity entity-name="LeaseAgreementComponent" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Agreement - payment component definition">
        <field name="leaseAgreementId" type="id"></field>
        <field name="componentSeqId" type="id"></field>
        <field name="componentTypeEnumId" type="id"></field>
        <field name="description" type="description"></field>
        <field name="monthlyAmount" type="currency-amount"></field>
        <field name="taxClassEnumId" type="id"></field>
        <field name="revenueTreatmentEnumId" type="id"></field>
        <field name="totalAmount" type="currency-amount"></field>
        <field name="totalTaxAmount" type="currency-amount"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="componentSeqId"/>
        <relation type="one" fk-name="LEASEAGRCMP_AGR" rel-entity-name="LeaseAgreement">
            <key-map field-name="leaseAgreementId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRCMP_TYPE" title="ComponentType" rel-entity-name="Enumeration">
            <key-map field-name="componentTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRCMP_TAXCL" title="TaxClass" rel-entity-name="Enumeration">
            <key-map field-name="taxClassEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="LEASEAGRCMP_REV" title="RevenueTreatment" rel-entity-name="Enumeration">
            <key-map field-name="revenueTreatmentEnumId" rel-field-name="enumId"/>
        </relation>
    </entity>

    <!-- Per-installment component amount of a confirmed schedule row -->
    <entity entity-name="LeaseAgrPaySchedComp" package-name="org.apache.ofbiz.finance.lease"
            title="Lease Agreement - confirmed payment schedule component amount">
        <field name="leaseAgreementId" type="id"></field>
        <field name="scheduleRevisionNumber" type="numeric"></field>
        <field name="installmentNumber" type="numeric"></field>
        <field name="componentSeqId" type="id"></field>
        <field name="componentTypeEnumId" type="id"></field>
        <field name="amount" type="currency-amount"></field>
        <field name="taxAmount" type="currency-amount"></field>
        <field name="taxClassEnumId" type="id"></field>
        <field name="revenueTreatmentEnumId" type="id"></field>
        <prim-key field="leaseAgreementId"/>
        <prim-key field="scheduleRevisionNumber"/>
        <prim-key field="installmentNumber"/>
        <prim-key field="componentSeqId"/>
        <relation type="one" fk-name="LEASEAPSCMP_PS" rel-entity-name="LeaseAgreementPaymentSchedule">
            <key-map field-name="leaseAgreementId"/>
            <key-map field-name="scheduleRevisionNumber"/>
            <key-map field-name="installmentNumber"/>
        </relation>
        <relation type="one" fk-name="LEASEAPSCMP_CMP" rel-entity-name="LeaseAgreementComponent">
            <key-map field-name="leaseAgreementId"/>
            <key-map field-name="componentSeqId"/>
        </relation>
    </entity>
</entitymodel>