<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Finance - STEP 7 Services (Prepayment, Loan Modification)</description>
    <vendor>OFBiz Finance</vendor>
    <version>1.0</version>

    <!-- ============================================================= -->
    <!-- Prepayment                                                    -->
    <!-- ============================================================= -->
    <service name="createLoanPrepayment" engine="java"
            location="org.apache.ofbiz.finance.loan.FinancePrepaymentServices" invoke="createLoanPrepayment" auth="true">
        <description>Make a full or partial prepayment and re-amortize the remaining schedule</description>
        <permission-service service-name="financePaymentPermission" main-action="CREATE"/>
        <attribute name="loanAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="prepaymentTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="true"><description>required for partial prepayment</description></attribute>
        <attribute name="prepaymentDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="paymentMethodTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="loanPrepaymentId" type="String" mode="OUT" optional="true"/>
        <attribute name="paymentId" type="String" mode="OUT" optional="true"/>
        <attribute name="penaltyAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="remainingPrincipal" type="BigDecimal" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- Loan modification                                             -->
    <!-- ============================================================= -->
    <service name="createLoanModification" engine="java"
            location="org.apache.ofbiz.finance.loan.FinancePrepaymentServices" invoke="createLoanModification" auth="true">
        <description>Change the interest rate and/or term and re-amortize the remaining schedule</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="loanAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="newAnnualInterestRate" type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="newTermMonths" type="Long" mode="IN" optional="true"/>
        <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="loanModificationId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- STEP L15a: reversal of mistaken operations (取消, FINANCE_ADMIN) -->
    <service name="reverseLoanAgreement" engine="java"
            location="org.apache.ofbiz.finance.loan.LoanReversalServices" invoke="reverseLoanAgreement" auth="true">
        <description>Reverse a mistaken contract activation when nothing was processed after it (billing, accrual, prepayment,
            change of terms, delinquency): LOANAGR_CANCELLED, the loan account cancelled, the liens released, the application back
            to LOANAPP_APPROVED (a new quote is needed: one agreement per quote).</description>
        <permission-service service-name="financeAdminPermission" main-action="UPDATE"/>
        <attribute name="loanAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="false"/>
        <attribute name="financeReversalId" type="String" mode="OUT" optional="true"/>
    </service>
    <service name="reverseLoanPrepayment" engine="java"
            location="org.apache.ofbiz.finance.loan.LoanReversalServices" invoke="reverseLoanPrepayment" auth="true">
        <description>Reverse the latest prepayment when nothing was processed after it: void the settlement payment, reverse the
            fee entry, restore the previous schedule as a new revision (partial) or reopen the agreement (full).</description>
        <permission-service service-name="financeAdminPermission" main-action="UPDATE"/>
        <attribute name="loanPrepaymentId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="false"/>
        <attribute name="financeReversalId" type="String" mode="OUT" optional="true"/>
    </service>
    <service name="reverseLoanModification" engine="java"
            location="org.apache.ofbiz.finance.loan.LoanReversalServices" invoke="reverseLoanModification" auth="true">
        <description>Reverse the latest change of terms when nothing was processed after it: restore the previous rate / term and
            the previous schedule as a new revision.</description>
        <permission-service service-name="financeAdminPermission" main-action="UPDATE"/>
        <attribute name="loanModificationId" type="String" mode="IN" optional="false"/>
        <attribute name="reason" type="String" mode="IN" optional="false"/>
        <attribute name="financeReversalId" type="String" mode="OUT" optional="true"/>
        <attribute name="scheduleRevisionNumber" type="Long" mode="OUT" optional="true"/>
    </service>

</services>