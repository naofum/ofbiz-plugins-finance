<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Finance - Lease layer STEP L1 services (lease products, applications, requested assets)</description>
    <vendor>OFBiz Finance</vendor>
    <version>1.0</version>

    <!-- ============================================================= -->
    <!-- Lease product terms                                           -->
    <!-- ============================================================= -->
    <service name="createFinancialProductLease" default-entity-name="FinancialProductLease" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseProductServices.groovy" invoke="createFinancialProductLease" auth="true">
        <description>Add lease terms to a FinancialProduct whose type is under LEASE. The lease class is derived from the product type.</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="updateFinancialProductLease" default-entity-name="FinancialProductLease" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseProductServices.groovy" invoke="updateFinancialProductLease" auth="true">
        <description>Update the lease terms of a lease product (the lease class must stay consistent with the product type)</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="deleteFinancialProductLease" default-entity-name="FinancialProductLease" engine="entity-auto" invoke="delete" auth="true">
        <description>Delete lease terms (fails while applications or asset type rows reference them)</description>
        <permission-service service-name="financeGenericPermission" main-action="DELETE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>
    <service name="addFinancialProductLeaseAssetType" default-entity-name="FinancialProductLeaseAssetType" engine="entity-auto" invoke="create" auth="true">
        <description>Allow an asset type for a lease product</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>
    <service name="removeFinancialProductLeaseAssetType" default-entity-name="FinancialProductLeaseAssetType" engine="entity-auto" invoke="delete" auth="true">
        <description>Remove an allowed asset type from a lease product</description>
        <permission-service service-name="financeGenericPermission" main-action="DELETE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <!-- ============================================================= -->
    <!-- Lease application                                             -->
    <!-- ============================================================= -->
    <service name="createLeaseApplication" default-entity-name="LeaseApplication" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="createLeaseApplication" auth="true">
        <description>Create a lease application in LEASEAPP_RECEIVED status for a lease product</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true">
            <exclude field-name="statusId"/>
        </auto-attributes>
        <override name="productId" optional="false"/>
        <override name="applicantPartyId" optional="false"/>
        <override name="requestedTermMonths" optional="false"/>
    </service>
    <service name="updateLeaseApplication" default-entity-name="LeaseApplication" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="updateLeaseApplication" auth="true">
        <description>Update a lease application only while it is LEASEAPP_RECEIVED</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true">
            <exclude field-name="statusId"/>
        </auto-attributes>
    </service>
    <service name="deleteLeaseApplication" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="deleteLeaseApplication" auth="true">
        <description>Delete a LEASEAPP_RECEIVED application without underwriting, with its requested assets and status history</description>
        <permission-service service-name="financeGenericPermission" main-action="DELETE"/>
        <attribute name="leaseApplicationId" type="String" mode="IN" optional="false"/>
    </service>
    <service name="setLeaseApplicationStatus" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="setLeaseApplicationStatus" auth="true">
        <description>Change the status of a lease application (StatusValidChange), record history; approval requires requested assets</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="leaseApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
        <attribute name="oldStatusId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- Requested assets (only while LEASEAPP_RECEIVED)               -->
    <!-- ============================================================= -->
    <service name="createLeaseApplicationAsset" default-entity-name="LeaseApplicationAsset" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="createLeaseApplicationAsset" auth="true">
        <description>Add a requested asset to a received lease application</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="INOUT" optional="true"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
        <override name="leaseApplicationId" optional="false"/>
        <override name="fixedAssetTypeId" optional="false"/>
        <override name="assetName" optional="false"/>
        <override name="estimatedAcquisitionCost" optional="false"/>
    </service>
    <service name="updateLeaseApplicationAsset" default-entity-name="LeaseApplicationAsset" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="updateLeaseApplicationAsset" auth="true">
        <description>Update a requested asset of a received lease application</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>
    <service name="removeLeaseApplicationAsset" default-entity-name="LeaseApplicationAsset" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="removeLeaseApplicationAsset" auth="true">
        <description>Remove a requested asset from a received lease application</description>
        <permission-service service-name="financeGenericPermission" main-action="DELETE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <!-- ============================================================= -->
    <!-- Underwriting (common review, applicationTypeId=LEASE)         -->
    <!-- ============================================================= -->
    <service name="createLeaseUnderwriting" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="createLeaseUnderwriting" auth="true">
        <description>Create a common underwriting (LOANUW_IN_REVIEW) for a lease application.
            Approval / rejection uses the common setLoanUnderwritingStatus service.</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <attribute name="leaseApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="creditScore" type="Long" mode="IN" optional="true"/>
        <attribute name="approvedPrincipalAmount" type="BigDecimal" mode="IN" optional="true"><description>approved acquisition cost</description></attribute>
        <attribute name="reviewerPartyId" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="loanUnderwritingId" type="String" mode="OUT" optional="false"/>
    </service>
    <service name="financeValidateLeaseUnderwritingApproval" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseApplicationServices.groovy" invoke="validateLeaseUnderwritingApproval" auth="true">
        <description>Approval validator for LEASE underwritings (registered as underwriting.approval.validator.LEASE):
            the lease application must exist and have at least one requested asset</description>
        <attribute name="applicationId" type="String" mode="IN" optional="false"/>
        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP L2: lease quote                                          -->
    <!-- ============================================================= -->
    <service name="createLeaseQuote" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseQuoteServices.groovy" invoke="createLeaseQuote" auth="true">
        <description>Calculate the lease payment and create an immutable lease quote with its asset lines
            and quote payment schedule. Acquisition cost = sum of the requested assets.</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <attribute name="leaseApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="termMonths" type="Long" mode="IN" optional="true"><description>defaults to the requested term</description></attribute>
        <attribute name="monthlyRateFactor" type="BigDecimal" mode="IN" optional="true"><description>rate factor method; exclusive with calcInterestRate</description></attribute>
        <attribute name="calcInterestRate" type="BigDecimal" mode="IN" optional="true"><description>interest rate method (annual); exclusive with monthlyRateFactor</description></attribute>
        <attribute name="residualValue" type="BigDecimal" mode="IN" optional="true"><description>defaults to acquisition cost x product residual value rate</description></attribute>
        <attribute name="paymentTimingEnumId" type="String" mode="IN" optional="true"><description>defaults to the product payment timing</description></attribute>
        <attribute name="leaseStartDate" type="Timestamp" mode="IN" optional="true"><description>expected lease start; defaults to today</description></attribute>
        <attribute name="leaseQuoteId" type="String" mode="OUT" optional="false"/>
    </service>
    <service name="setLeaseQuoteStatus" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseQuoteServices.groovy" invoke="setLeaseQuoteStatus" auth="true">
        <description>Change the status of a lease quote (StatusValidChange); only one accepted quote per application</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="leaseQuoteId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
        <attribute name="oldStatusId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP L2: lease agreement                                      -->
    <!-- ============================================================= -->
    <service name="createLeaseAgreement" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseQuoteServices.groovy" invoke="createLeaseAgreement" auth="true">
        <description>Create a lease agreement (LEASEAGR_CONTRACTED) from an approved application, accepted quote and
            approved LEASE underwriting; register the FinanceContract (LEASE) and snapshot the payment schedule and assets</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <attribute name="leaseQuoteId" type="String" mode="IN" optional="false"/>
        <attribute name="organizationPartyId" type="String" mode="IN" optional="true"><description>lessor organization; defaults to Company</description></attribute>
        <attribute name="agreementDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="leaseApplicationId" type="String" mode="IN" optional="true"><description>passed through for the UI redirect</description></attribute>
        <attribute name="leaseAgreementId" type="String" mode="OUT" optional="false"/>
        <attribute name="financeContractId" type="String" mode="OUT" optional="false"/>
    </service>
    <service name="setLeaseAgreementStatus" engine="groovy"
            location="component://finance/groovyScripts/lease/LeaseQuoteServices.groovy" invoke="setLeaseAgreementStatus" auth="true">
        <description>Change the status of a lease agreement (StatusValidChange) and project it onto FinanceContract.
            CONTRACTED -> ACTIVE is rejected here (acceptLeaseAgreement only); cancellation is rejected once an asset is purchased.</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="statusId" type="String" mode="IN" optional="false"/>
        <attribute name="oldStatusId" type="String" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP L3: asset purchase, supplier payment, acceptance (start) -->
    <!-- ============================================================= -->
    <service name="recordLeaseAssetPurchase" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAcquisitionServices" invoke="recordLeaseAssetPurchase" auth="true">
        <description>Record the purchase of one agreement asset: supplier purchase invoice (READY; core GL
            Dr lease asset suspense / Cr accounts payable), lessor-owned FixedAsset and the link to the agreement asset</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="assetSeqId" type="String" mode="IN" optional="false"/>
        <attribute name="supplierPartyId" type="String" mode="IN" optional="true"><description>defaults to the supplier of the asset line</description></attribute>
        <attribute name="supplierInvoiceRef" type="String" mode="IN" optional="true"/>
        <attribute name="purchaseDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="invoiceId" type="String" mode="OUT" optional="false"/>
        <attribute name="fixedAssetId" type="String" mode="OUT" optional="false"/>
    </service>
    <service name="payLeaseAssetPurchase" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAcquisitionServices" invoke="payLeaseAssetPurchase" auth="true">
        <description>Pay the supplier invoice of a purchased lease asset with a core vendor payment (core GL for the payment and its application)</description>
        <permission-service service-name="financePaymentPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="assetSeqId" type="String" mode="IN" optional="false"/>
        <attribute name="paymentMethodTypeId" type="String" mode="IN" optional="true"><description>defaults to EFT_ACCOUNT</description></attribute>
        <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="paymentId" type="String" mode="OUT" optional="false"/>
    </service>
    <service name="acceptLeaseAgreement" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAcquisitionServices" invoke="acceptLeaseAgreement" auth="true">
        <description>Record the lessee's acceptance: the acceptance date becomes the lease start, the confirmed schedule is
            re-dated as a new revision, the agreement becomes LEASEAGR_ACTIVE and the start entries are posted once (idempotent)</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="acceptanceDate" type="Timestamp" mode="IN" optional="true"><description>defaults to today</description></attribute>
        <attribute name="acceptedByPartyId" type="String" mode="IN" optional="true"><description>defaults to the lessee</description></attribute>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="acctgTransId" type="String" mode="OUT" optional="true"/>
        <attribute name="taxAcctgTransId" type="String" mode="OUT" optional="true"><description>lump-sum consumption tax at the start (STEP L5)</description></attribute>
        <attribute name="scheduleRevisionNumber" type="Long" mode="OUT" optional="true"/>
        <attribute name="created" type="Boolean" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- STEP L4: billing, deferred profit release, batch, payments    -->
    <!-- ============================================================= -->
    <service name="createLeaseInstallmentInvoice" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAccountingServices" invoke="createLeaseInstallmentInvoice" auth="true">
        <description>Bill one installment of the confirmed lease payment schedule (ACTIVE agreement, due by today):
            SALES_INVOICE (READY) with the lease payment (credits the lease investment / receivable) and the consumption tax
            (credits tax received); the core debits accounts receivable. Idempotent per installment.</description>
        <permission-service service-name="financeBillingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="installmentNumber" type="Long" mode="IN" optional="false"/>
        <attribute name="invoiceId" type="String" mode="OUT" optional="true"/>
        <attribute name="billedAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="invoiceCreated" type="Boolean" mode="OUT" optional="true"/>
    </service>
    <service name="recognizeLeaseProfit" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAccountingServices" invoke="recognizeLeaseProfit" auth="true">
        <description>Release the deferred lease profit earned (interest method) from the day after the last recognition
            through the recognition date, one record and one transaction per calendar month
            (Dr deferred lease profit / Cr deferred lease profit release). Re-running creates nothing twice.</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="recognitionDate" type="Timestamp" mode="IN" optional="true"><description>defaults to today</description></attribute>
        <attribute name="leaseProfitRecognitionId" type="String" mode="OUT" optional="true"/>
        <attribute name="recognizedAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="cumulativeAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="createdCount" type="Long" mode="OUT" optional="true"/>
    </service>
    <service name="runLeaseMonthlyAccountingBatch" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAccountingServices" invoke="runLeaseMonthlyAccountingBatch" auth="true">
        <description>For every ACTIVE lease (or the given one): bill the installments due through the processing date in
            due-date order, then release the deferred lease profit through the processing date</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="processingDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="true"/>
        <attribute name="processedAgreementCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="createdInvoiceCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="createdRecognitionCount" type="Long" mode="OUT" optional="true"/>
    </service>
    <service name="receiveLeasePayment" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAccountingServices" invoke="receiveLeasePayment" auth="true">
        <description>Receive a customer payment (PMNT_RECEIVED) for an ACTIVE lease and apply it to the given lease invoice,
            or to the open lease invoices oldest due first; the amount may not exceed the open amount</description>
        <permission-service service-name="financePaymentPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="invoiceId" type="String" mode="IN" optional="true"/>
        <attribute name="amount" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="paymentMethodTypeId" type="String" mode="IN" optional="true"><description>defaults to EFT_ACCOUNT</description></attribute>
        <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="paymentId" type="String" mode="OUT" optional="true"/>
        <attribute name="leasePaymentReceiptId" type="String" mode="OUT" optional="true"/>
        <attribute name="appliedInvoiceCount" type="Long" mode="OUT" optional="true"/>
    </service>
    <service name="getLeaseAgreementBalance" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseAccountingServices" invoke="getLeaseAgreementBalance" auth="true">
        <description>Collection status of a lease from the valid payment applications on its invoices
            (tax, then interest, then principal) and the deferred profit recognized</description>
        <permission-service service-name="financeGenericPermission" main-action="VIEW"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="billedCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="billedLeaseAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="billedTaxAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="billedAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="appliedAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="unpaidBilledAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="collectedTaxAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="collectedInterestAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="collectedPrincipalAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="outstandingPrincipal" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="unbilledLeaseAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="recognizedProfitAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="deferredProfitBalance" type="BigDecimal" mode="OUT" optional="true"/>
    </service>
    <!-- ============================================================= -->
    <!-- STEP L7: expiry (tasks, notice, return, disposal, transfer)   -->
    <!-- ============================================================= -->
    <service name="runLeaseExpiryBatch" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="runLeaseExpiryBatch" auth="true">
        <description>For ACTIVE leases ending within monthsAhead months: expiry notice task; after the lease end, a return
            task per asset (no transfer) or an ownership transfer task once every installment is settled (transfer). Idempotent.</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <attribute name="processingDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="monthsAhead" type="Long" mode="IN" optional="true"><description>defaults to lease.expiry.notice.months</description></attribute>
        <attribute name="assigneePartyId" type="String" mode="IN" optional="true"/>
        <attribute name="processedAgreementCount" type="Long" mode="OUT" optional="true"/>
        <attribute name="createdTaskCount" type="Long" mode="OUT" optional="true"/>
    </service>
    <service name="issueLeaseExpiryNotice" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="issueLeaseExpiryNotice" auth="true">
        <description>Record the expiry notice to the lessee (one per agreement) and complete the notice task</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="noticeDate" type="Timestamp" mode="INOUT" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="workEffortId" type="String" mode="OUT" optional="true"/>
    </service>
    <service name="returnLeaseAsset" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="returnLeaseAsset" auth="true">
        <description>Record the return of an asset (no ownership transfer, on or after the lease end); completes the return
            task, creates the disposal task and completes the agreement when every asset is back and everything is settled</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="assetSeqId" type="String" mode="IN" optional="false"/>
        <attribute name="returnDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="assigneePartyId" type="String" mode="IN" optional="true"><description>assignee of the disposal task</description></attribute>
        <attribute name="agreementCompleted" type="Boolean" mode="OUT" optional="true"/>
    </service>
    <service name="disposeLeaseAsset" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="disposeLeaseAsset" auth="true">
        <description>Record the sale / scrap of a returned asset and settle its residual value (gain / loss); completes the disposal task</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="assetSeqId" type="String" mode="IN" optional="false"/>
        <attribute name="disposalTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="disposalDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="proceedsAmount" type="BigDecimal" mode="IN" optional="true"><description>sale price (tax excluded); 0 for scrap</description></attribute>
        <attribute name="disposalPartyId" type="String" mode="IN" optional="true"><description>buyer</description></attribute>
        <attribute name="acctgTransId" type="String" mode="OUT" optional="true"/>
        <attribute name="gainLossAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="workEffortId" type="String" mode="OUT" optional="true"/>
    </service>
    <service name="transferLeaseOwnership" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="transferLeaseOwnership" auth="true">
        <description>Transfer the ownership of the assets of a transfer lease to the lessee after the final payment; settles the
            residual with the transfer price, updates FixedAsset.partyId, completes the task and the agreement</description>
        <permission-service service-name="financeAccountingPermission" main-action="CREATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="transferDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="transferPrice" type="BigDecimal" mode="IN" optional="true"><description>defaults to the residual value</description></attribute>
        <attribute name="acctgTransIds" type="List" mode="OUT" optional="true"/>
        <attribute name="agreementCompleted" type="Boolean" mode="OUT" optional="true"/>
    </service>
    <service name="completeLeaseAgreement" engine="java"
            location="org.apache.ofbiz.finance.lease.LeaseExpiryServices" invoke="completeLeaseAgreement" auth="true">
        <description>Complete a lease (LEASEAGR_COMPLETED) when every asset is returned / disposed / transferred and every
            installment is billed and settled (e.g. after the last payment arrives); releases the deferred profit through the end</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="leaseAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="completionDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="agreementCompleted" type="Boolean" mode="OUT" optional="true"/>
    </service>
</services>