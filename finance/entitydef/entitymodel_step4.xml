<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Finance Component Entity Model - STEP 4 (Collateral / Secured Loans)</title>
    <description>
        Collateral (pledged asset) management for secured loans such as mortgages.
        Collateral is declared at application time, valued during underwriting and
        linked to a loan agreement (lien) at contract time. Optionally references a
        core FixedAsset (e.g. real estate) using a hybrid modeling approach.
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- CollateralType: classification of a pledged asset         -->
    <!-- ========================================================= -->
    <entity entity-name="CollateralType" package-name="org.apache.ofbiz.finance.collateral"
            title="Collateral Type">
        <field name="collateralTypeId" type="id"><description>e.g. REAL_ESTATE, VEHICLE, DEPOSIT, SECURITIES</description></field>
        <field name="parentTypeId" type="id"><description>for hierarchical types</description></field>
        <field name="hasTable" type="indicator"></field>
        <field name="description" type="description"></field>
        <prim-key field="collateralTypeId"/>
        <relation type="one" title="Parent" fk-name="COLLTYPE_PAR" rel-entity-name="CollateralType">
            <key-map field-name="parentTypeId" rel-field-name="collateralTypeId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- Collateral: a pledged asset (hybrid: optional FixedAsset) -->
    <!-- ========================================================= -->
    <entity entity-name="Collateral" package-name="org.apache.ofbiz.finance.collateral"
            title="Collateral (pledged asset)">
        <field name="collateralId" type="id"><description>primary sequenced ID</description></field>
        <field name="collateralTypeId" type="id"></field>
        <field name="ownerPartyId" type="id"><description>party that owns/pledges the collateral</description></field>
        <field name="fixedAssetId" type="id"><description>optional link to a core FixedAsset (e.g. real estate)</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="description" type="description"></field>
        <field name="statusId" type="id"><description>FK to StatusItem (COLLATERAL_STATUS)</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="collateralId"/>
        <relation type="one" fk-name="COLL_TYPE" rel-entity-name="CollateralType">
            <key-map field-name="collateralTypeId"/>
        </relation>
        <relation type="one" fk-name="COLL_OWNER" rel-entity-name="Party">
            <key-map field-name="ownerPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="COLL_FXDASST" rel-entity-name="FixedAsset">
            <key-map field-name="fixedAssetId"/>
        </relation>
        <relation type="one" fk-name="COLL_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <relation type="one" fk-name="COLL_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- LoanApplicationCollateral: collateral declared on a       -->
    <!-- loan application (stage 1 of the secured loan flow).      -->
    <!-- ========================================================= -->
    <entity entity-name="LoanApplicationCollateral" package-name="org.apache.ofbiz.finance.application"
            title="Loan Application Collateral Declaration">
        <field name="loanApplicationId" type="id"></field>
        <field name="collateralId" type="id"></field>
        <field name="declaredValueAmount" type="currency-amount"><description>value declared by the applicant (optional)</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="loanApplicationId"/>
        <prim-key field="collateralId"/>
        <relation type="one" fk-name="LOANAPPCOL_APP" rel-entity-name="LoanApplication">
            <key-map field-name="loanApplicationId"/>
        </relation>
        <relation type="one" fk-name="LOANAPPCOL_COL" rel-entity-name="Collateral">
            <key-map field-name="collateralId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- CollateralValuation: appraisal history for a collateral   -->
    <!-- (stage 2 of the secured loan flow, used by underwriting). -->
    <!-- ========================================================= -->
    <entity entity-name="CollateralValuation" package-name="org.apache.ofbiz.finance.collateral"
            title="Collateral Valuation (appraisal)">
        <field name="collateralValuationId" type="id"><description>primary sequenced ID</description></field>
        <field name="collateralId" type="id"></field>
        <field name="valuationDate" type="date-time"></field>
        <field name="appraisedValueAmount" type="currency-amount"></field>
        <field name="currencyUomId" type="id"></field>
        <field name="valuationMethodEnumId" type="id"></field>
        <field name="appraiserPartyId" type="id"><description>party who performed the appraisal</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="collateralValuationId"/>
        <relation type="one" fk-name="COLLVAL_COL" rel-entity-name="Collateral">
            <key-map field-name="collateralId"/>
        </relation>
        <relation type="one" fk-name="COLLVAL_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <relation type="one" fk-name="COLLVAL_ENUM" rel-entity-name="Enumeration">
            <key-map field-name="valuationMethodEnumId" rel-field-name="enumId"/>
        </relation>
        <relation type="one" fk-name="COLLVAL_APPR" rel-entity-name="Party">
            <key-map field-name="appraiserPartyId" rel-field-name="partyId"/>
        </relation>
        <index name="COLLVAL_DATE_UQ" unique="true">
            <index-field name="collateralId"/>
            <index-field name="valuationDate"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- LoanCollateral: lien that links a collateral to a loan    -->
    <!-- agreement (stage 3 of the secured loan flow).             -->
    <!-- ========================================================= -->
    <entity entity-name="LoanCollateral" package-name="org.apache.ofbiz.finance.agreement"
            title="Loan Collateral Assignment (lien)">
        <field name="loanAgreementId" type="id"></field>
        <field name="collateralId" type="id"></field>
        <field name="fromDate" type="date-time"><description>lien start (contract date)</description></field>
        <field name="thruDate" type="date-time"><description>null while the lien is active</description></field>
        <field name="assignedValueAmount" type="currency-amount"><description>appraised value assigned to this agreement</description></field>
        <field name="lienDescription" type="long-varchar"><description>registration / lien perfection reference</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="loanAgreementId"/>
        <prim-key field="collateralId"/>
        <relation type="one" fk-name="LOANCOL_AGR" rel-entity-name="LoanAgreement">
            <key-map field-name="loanAgreementId"/>
        </relation>
        <relation type="one" fk-name="LOANCOL_COL" rel-entity-name="Collateral">
            <key-map field-name="collateralId"/>
        </relation>
    </entity>

</entitymodel>
