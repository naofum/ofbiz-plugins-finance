<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

    <description>Finance Component Site Configuration File</description>

    <!-- Register the generic JasperReports view handler (provided by the
         jasperreports plugin) so finance reports can render to PDF. -->
    <handler name="jasperreports" type="view"
            class="org.apache.ofbiz.jasperreports.webapp.view.JasperReportsViewHandler"/>

    <!-- Request Mappings -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- Entity lookups (party selector used by the loan application form) -->
    <request-map uri="LookupPartyName">
        <security auth="true" https="true"/>
        <response name="success" type="view" value="LookupPartyName"/>
    </request-map>

    <request-map uri="FindLoanApplication">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindLoanApplication"/>
    </request-map>
    <request-map uri="EditLoanApplication">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="EditLoanApplication"/>
    </request-map>

    <request-map uri="createLoanApplication">
        <security https="true" auth="true"/>
        <event type="service" invoke="createLoanApplication"/>
        <response name="success" type="request-redirect" value="EditLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="view" value="EditLoanApplication"/>
    </request-map>
    <request-map uri="updateLoanApplication">
        <security https="true" auth="true"/>
        <event type="service" invoke="updateLoanApplication"/>
        <response name="success" type="request-redirect" value="EditLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="view" value="EditLoanApplication"/>
    </request-map>
    <request-map uri="setLoanApplicationStatus">
        <security https="true" auth="true"/>
        <event type="service" invoke="setLoanApplicationStatus"/>
        <response name="success" type="request-redirect" value="EditLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="EditLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>

    <!-- STEP 2: Quote / Underwriting / Agreement -->
    <request-map uri="ManageLoanApplication">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="ManageLoanApplication"/>
    </request-map>
    <request-map uri="ViewLoanQuote">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="ViewLoanQuote"/>
    </request-map>

    <!-- Loan quote PDF: prepare data via the entity engine (Groovy event),
         then render through the JasperReports view handler. The ".pdf" uri
         suffix follows the OFBiz convention for binary PDF responses so the
         browser opens it as a document rather than a page. -->
    <request-map uri="PrintLoanQuote.pdf">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://finance/groovyScripts/PrepareLoanQuoteReport.groovy"/>
        <response name="success" type="view" value="LoanQuotePdf"/>
        <response name="error" type="view" value="ViewLoanQuote"/>
    </request-map>
    <request-map uri="createLoanQuote">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://finance/groovyScripts/CreateLoanQuoteFromUi.groovy"/>
        <response name="success" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>
    <request-map uri="setLoanQuoteStatus">
        <security https="true" auth="true"/>
        <event type="service" invoke="setLoanQuoteStatus"/>
        <response name="success" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>
    <request-map uri="createLoanUnderwriting">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://finance/groovyScripts/SaveLoanUnderwritingFromUi.groovy"/>
        <response name="success" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>
    <request-map uri="updateLoanUnderwriting">
        <security https="true" auth="true"/>
        <event type="groovy" path="component://finance/groovyScripts/SaveLoanUnderwritingFromUi.groovy"/>
        <response name="success" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>
    <request-map uri="setLoanUnderwritingStatus">
        <security https="true" auth="true"/>
        <event type="service" invoke="setLoanUnderwritingStatus"/>
        <response name="success" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>
    <request-map uri="createLoanAgreement">
        <security https="true" auth="true"/>
        <event type="service" invoke="createLoanAgreement"/>
        <response name="success" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanApplication">
            <redirect-parameter name="loanApplicationId"/>
        </response>
    </request-map>

    <!-- STEP 3: Accounting / Billing / Payment -->
    <request-map uri="FindLoanAgreement">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="FindLoanAgreement"/>
    </request-map>
    <request-map uri="ManageLoanAgreement">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="ManageLoanAgreement"/>
    </request-map>
    <request-map uri="runLoanMonthlyAccountingBatch">
        <security https="true" auth="true"/>
        <event type="service" invoke="runLoanMonthlyAccountingBatch"/>
        <response name="success" type="request-redirect" value="FindLoanAgreement"/>
        <response name="error" type="request-redirect" value="FindLoanAgreement"/>
    </request-map>
    <request-map uri="runMonthlyInterestAccrual">
        <security https="true" auth="true"/>
        <event type="service" invoke="runMonthlyInterestAccrual"/>
        <response name="success" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
    </request-map>
    <request-map uri="createLoanInstallmentInvoice">
        <security https="true" auth="true"/>
        <event type="service" invoke="createLoanInstallmentInvoice"/>
        <response name="success" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
    </request-map>
    <request-map uri="receiveLoanPayment">
        <security https="true" auth="true"/>
        <event type="service" invoke="receiveLoanPayment"/>
        <response name="success" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
        <response name="error" type="request-redirect" value="ManageLoanAgreement">
            <redirect-parameter name="loanAgreementId"/>
        </response>
    </request-map>

    <!-- View Mappings -->
    <view-map name="main" type="screen" page="component://finance/widget/FinanceScreens.xml#FindLoanApplication"/>
    <view-map name="LookupPartyName" type="screen" page="component://party/widget/partymgr/LookupScreens.xml#LookupPartyName"/>
    <view-map name="FindLoanApplication" type="screen" page="component://finance/widget/FinanceScreens.xml#FindLoanApplication"/>
    <view-map name="EditLoanApplication" type="screen" page="component://finance/widget/FinanceScreens.xml#EditLoanApplication"/>
    <view-map name="ManageLoanApplication" type="screen" page="component://finance/widget/FinanceStep2Screens.xml#ManageLoanApplication"/>
    <view-map name="ViewLoanQuote" type="screen" page="component://finance/widget/FinanceStep2Screens.xml#ViewLoanQuote"/>
    <!-- Loan quote PDF rendered by the JasperReports view handler. -->
    <view-map name="LoanQuotePdf" type="jasperreports"
            page="component://finance/webapp/finance/reports/LoanQuoteReport.jrxml"
            content-type="application/pdf"/>
    <view-map name="FindLoanAgreement" type="screen" page="component://finance/widget/FinanceStep3Screens.xml#FindLoanAgreement"/>
    <view-map name="ManageLoanAgreement" type="screen" page="component://finance/widget/FinanceStep3Screens.xml#ManageLoanAgreement"/>
</site-conf>
