<entity-engine-xml>
    <!-- Common contract ledger types (STEP L0) -->
    <FinanceContractType contractTypeId="LOAN" description="Loan Agreement"/>
    <FinanceContractType contractTypeId="LEASE" description="Lease Agreement"/>

    <!-- Projected common contract status. Maintained by the loan / lease
         status services; never changed directly through CRUD. -->
    <StatusType description="Finance Contract" hasTable="N" statusTypeId="FINANCE_CTR_STATUS"/>
    <StatusItem description="Contracted" sequenceId="01" statusCode="CONTRACTED" statusId="FINCTR_CONTRACTED" statusTypeId="FINANCE_CTR_STATUS"/>
    <StatusItem description="Active" sequenceId="02" statusCode="ACTIVE" statusId="FINCTR_ACTIVE" statusTypeId="FINANCE_CTR_STATUS"/>
    <StatusItem description="Completed" sequenceId="03" statusCode="COMPLETED" statusId="FINCTR_COMPLETED" statusTypeId="FINANCE_CTR_STATUS"/>
    <StatusItem description="Cancelled" sequenceId="04" statusCode="CANCELLED" statusId="FINCTR_CANCELLED" statusTypeId="FINANCE_CTR_STATUS"/>

    <!-- STEP L7: work types of contract tasks (core WorkEffort, FinanceContractWorkEffort) -->
    <EnumerationType description="Finance Work Type" enumTypeId="FINANCE_WORK_TYPE" hasTable="N"/>
    <Enumeration description="Lease expiry notice (満了通知)" enumCode="EXPIRY_NOTICE" enumId="FINWE_EXPIRY_NOTICE" sequenceId="01" enumTypeId="FINANCE_WORK_TYPE"/>
    <Enumeration description="Asset return / pickup (返還引取り)" enumCode="ASSET_RETURN" enumId="FINWE_ASSET_RETURN" sequenceId="02" enumTypeId="FINANCE_WORK_TYPE"/>
    <Enumeration description="Asset disposal (物件処分)" enumCode="ASSET_DISPOSAL" enumId="FINWE_ASSET_DISPOSAL" sequenceId="03" enumTypeId="FINANCE_WORK_TYPE"/>
    <Enumeration description="Ownership transfer (所有権移転)" enumCode="OWNERSHIP_TRANS" enumId="FINWE_OWN_TRANSFER" sequenceId="04" enumTypeId="FINANCE_WORK_TYPE"/>
    <!-- STEP L11 -->
    <Enumeration description="Maintenance work (保守作業)" enumCode="MAINTENANCE" enumId="FINWE_MAINTENANCE" sequenceId="05" enumTypeId="FINANCE_WORK_TYPE"/>
    <Enumeration description="Other contract task (その他)" enumCode="OTHER" enumId="FINWE_OTHER" sequenceId="99" enumTypeId="FINANCE_WORK_TYPE"/>

    <!-- STEP L10a: roles of a party in a finance contract (FinanceContractParty).
         Only roles under FIN_CTR_ROLE are accepted. -->
    <RoleType description="Finance contract role" hasTable="N" roleTypeId="FIN_CTR_ROLE"/>
    <RoleType description="Borrower (借主)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_BORROWER"/>
    <RoleType description="Lender (貸主)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_LENDER"/>
    <RoleType description="Lessee (借手)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_LESSEE"/>
    <RoleType description="Lessor (貸手)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_LESSOR"/>
    <RoleType description="Guarantor (保証人)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_GUARANTOR"/>
    <RoleType description="Syndicate participant (協調参加者)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_PARTICIPANT"/>
    <RoleType description="Arranger / agent (幹事)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_ARRANGER"/>
    <RoleType description="Head lessor of a sublease (元リースの貸手)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_HEAD_LESSOR"/>
    <RoleType description="Vendor / dealer (販売店)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_VENDOR"/>
    <RoleType description="Recourse party (リコース先)" hasTable="N" parentTypeId="FIN_CTR_ROLE" roleTypeId="FIN_RECOURSE"/>
    <!-- STEP L15a: reversal of a mistaken operation (FinanceReversal). Only FINANCE_ADMIN may reverse. -->
    <EnumerationType description="Finance Reversal Type" enumTypeId="FINANCE_REV_TYPE" hasTable="N"/>
    <Enumeration description="Lease acceptance (検収の取消)" enumCode="LEASE_ACCEPT" enumId="FINREV_LEASE_ACCEPT" sequenceId="01" enumTypeId="FINANCE_REV_TYPE"/>
    <Enumeration description="Lease early termination (中途解約の取消)" enumCode="LEASE_TERM" enumId="FINREV_LEASE_TERM" sequenceId="02" enumTypeId="FINANCE_REV_TYPE"/>
    <Enumeration description="Lease change of terms (条件変更の取消)" enumCode="LEASE_MOD" enumId="FINREV_LEASE_MOD" sequenceId="03" enumTypeId="FINANCE_REV_TYPE"/>
    <Enumeration description="Loan agreement activation (契約・有効化の取消)" enumCode="LOAN_ACTIVATE" enumId="FINREV_LOAN_ACTIVATE" sequenceId="11" enumTypeId="FINANCE_REV_TYPE"/>
    <Enumeration description="Loan prepayment (繰上返済の取消)" enumCode="LOAN_PREPAY" enumId="FINREV_LOAN_PREPAY" sequenceId="12" enumTypeId="FINANCE_REV_TYPE"/>
    <Enumeration description="Loan change of terms (条件変更の取消)" enumCode="LOAN_MOD" enumId="FINREV_LOAN_MOD" sequenceId="13" enumTypeId="FINANCE_REV_TYPE"/>
</entity-engine-xml>
