<entity-engine-xml>
    <!-- ============ Financial product types ============ -->
    <FinancialProductType financialProductTypeId="LOAN" hasTable="N" description="Loan (root)"/>
    <FinancialProductType financialProductTypeId="PERSONAL_UNSECURED" parentTypeId="LOAN" hasTable="N" description="Personal unsecured loan"/>
    <FinancialProductType financialProductTypeId="SECURED" parentTypeId="LOAN" hasTable="N" description="Secured loan"/>
    <FinancialProductType financialProductTypeId="BUSINESS" parentTypeId="LOAN" hasTable="N" description="Business loan"/>

    <!-- ============ Loan application status ============ -->
    <StatusType description="Loan Application" hasTable="N" statusTypeId="LOAN_APP_STATUS"/>
    <StatusItem description="Received" sequenceId="01" statusCode="RECEIVED" statusId="LOANAPP_RECEIVED" statusTypeId="LOAN_APP_STATUS"/>
    <StatusItem description="Submitted for review" sequenceId="02" statusCode="SUBMITTED" statusId="LOANAPP_SUBMITTED" statusTypeId="LOAN_APP_STATUS"/>
    <StatusItem description="Cancelled" sequenceId="03" statusCode="CANCELLED" statusId="LOANAPP_CANCELLED" statusTypeId="LOAN_APP_STATUS"/>
    <StatusItem description="Rejected" sequenceId="04" statusCode="REJECTED" statusId="LOANAPP_REJECTED" statusTypeId="LOAN_APP_STATUS"/>

    <!-- Allowed status transitions for a loan application -->
    <StatusValidChange statusId="LOANAPP_RECEIVED" statusIdTo="LOANAPP_SUBMITTED" transitionName="Submit for review"/>
    <StatusValidChange statusId="LOANAPP_RECEIVED" statusIdTo="LOANAPP_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="LOANAPP_SUBMITTED" statusIdTo="LOANAPP_REJECTED" transitionName="Reject"/>
    <StatusValidChange statusId="LOANAPP_SUBMITTED" statusIdTo="LOANAPP_CANCELLED" transitionName="Cancel"/>
</entity-engine-xml>
