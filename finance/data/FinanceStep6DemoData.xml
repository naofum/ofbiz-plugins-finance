    <FinancialProductDelinquency productId="DEMO_LOANPROD1" delinquencyLevelEnumId="DELINQ_D1" minDaysPastDue="1" maxDaysPastDue="30" dunningLevelEnumId="DUN_L1" writeoffFlag="N" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="DEMO_LOANPROD1" delinquencyLevelEnumId="DELINQ_D2" minDaysPastDue="31" maxDaysPastDue="60" dunningLevelEnumId="DUN_L2" writeoffFlag="N" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="DEMO_LOANPROD1" delinquencyLevelEnumId="DELINQ_D3" minDaysPastDue="61" maxDaysPastDue="90" dunningLevelEnumId="DUN_L3" writeoffFlag="Y" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="DEMO_LOANPROD1" delinquencyLevelEnumId="DELINQ_D4" minDaysPastDue="91" dunningLevelEnumId="DUN_L4" writeoffFlag="Y" legalActionFlag="Y"/>
</entity-engine-xml>
