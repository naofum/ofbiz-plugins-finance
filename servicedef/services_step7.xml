<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Finance - STEP 7 Services (Prepayment, Loan Modification)</description>
    <vendor>OFBiz Finance</vendor>
    <version>1.0</version>

    <!-- ============================================================= -->
    <!-- Prepayment                                                    -->
    <!-- ============================================================= -->
    <service name="createLoanPrepayment" engine="java"
            location="org.apache.ofbiz.finance.accounting.FinancePrepaymentServices" invoke="createLoanPrepayment" auth="true">
        <description>Make a full or partial prepayment and re-amortize the remaining schedule</description>
        <permission-service service-name="financePaymentPermission" main-action="CREATE"/>
        <attribute name="loanAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="prepaymentTypeEnumId" type="String" mode="IN" optional="false"/>
        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="true"><description>required for partial prepayment</description></attribute>
        <attribute name="prepaymentDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="paymentMethodTypeId" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="loanPrepaymentId" type="String" mode="OUT" optional="true"/>
        <attribute name="paymentId" type="String" mode="OUT" optional="true"/>
        <attribute name="penaltyAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="remainingPrincipal" type="BigDecimal" mode="OUT" optional="true"/>
    </service>

    <!-- ============================================================= -->
    <!-- Loan modification                                             -->
    <!-- ============================================================= -->
    <service name="createLoanModification" engine="java"
            location="org.apache.ofbiz.finance.accounting.FinancePrepaymentServices" invoke="createLoanModification" auth="true">
        <description>Change the interest rate and/or term and re-amortize the remaining schedule</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="loanAgreementId" type="String" mode="IN" optional="false"/>
        <attribute name="newAnnualInterestRate" type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="newTermMonths" type="Long" mode="IN" optional="true"/>
        <attribute name="effectiveDate" type="Timestamp" mode="IN" optional="true"/>
        <attribute name="reason" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
        <attribute name="loanModificationId" type="String" mode="OUT" optional="true"/>
    </service>

</services>
