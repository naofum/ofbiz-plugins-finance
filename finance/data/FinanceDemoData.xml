    Demo data for the finance plugin: a sample borrower, a loan product
    (core Product + FinancialProduct, method B) and a received loan
    application. Enough to exercise the quote / schedule / PDF flow in a UI.
    Depends on finance seed (FinancialProductType PERSONAL_UNSECURED) and the
    standard currency Uom (JPY).
-->
<entity-engine-xml>
    <!-- Borrower party (person) -->
    <Party partyId="DEMO_BORROWER1" partyTypeId="PERSON"/>
    <Person partyId="DEMO_BORROWER1" firstName="花子" lastName="融資"/>

    <!-- A loan product: core Product + FinancialProduct (method B) -->
    <Product productId="DEMO_LOANPROD1" productTypeId="SERVICE"
            internalName="Demo Personal Loan" productName="個人向け無担保ローン（デモ）"/>
    <FinancialProduct productId="DEMO_LOANPROD1" financialProductTypeId="PERSONAL_UNSECURED"
            currencyUomId="JPY" minPrincipalAmount="10000" maxPrincipalAmount="1000000"
            minTermMonths="1" maxTermMonths="60" defaultAnnualInterestRate="0.150000" requiresCollateral="N"
            lateFeeAnnualRate="0.146000"/>

    <!-- A received loan application ready for quoting -->
    <LoanApplication loanApplicationId="DEMO_LOANAPP1" productId="DEMO_LOANPROD1"
            applicantPartyId="DEMO_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="JPY"
            requestedPrincipalAmount="300000" requestedTermMonths="12"
            purpose="Demo application for loan quote PDF"/>
</entity-engine-xml>
