    <Enumeration description="Full Prepayment (全額繰上返済)" enumCode="FULL" enumId="PREPAY_FULL" sequenceId="01" enumTypeId="LOAN_PREPAY_TYPE"/>
    <Enumeration description="Partial - Term Reduction (期間短縮)" enumCode="PARTIAL_TERM" enumId="PREPAY_PART_TERM" sequenceId="02" enumTypeId="LOAN_PREPAY_TYPE"/>
    <Enumeration description="Partial - Payment Reduction (返済額軽減)" enumCode="PARTIAL_AMOUNT" enumId="PREPAY_PART_AMOUNT" sequenceId="03" enumTypeId="LOAN_PREPAY_TYPE"/>

    <!-- ============ Loan modification types ============ -->
    <EnumerationType description="Loan Modification Type" enumTypeId="LOAN_MOD_TYPE" hasTable="N"/>
    <Enumeration description="Interest Rate Change (金利変更)" enumCode="RATE" enumId="MOD_RATE" sequenceId="01" enumTypeId="LOAN_MOD_TYPE"/>
    <Enumeration description="Term Change (期間変更)" enumCode="TERM" enumId="MOD_TERM" sequenceId="02" enumTypeId="LOAN_MOD_TYPE"/>
</entity-engine-xml>
