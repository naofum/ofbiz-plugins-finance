<entity-engine-xml>
    <!-- ============ Collateral types ============ -->
    <CollateralType collateralTypeId="REAL_ESTATE" hasTable="N" description="Real estate (不動産)"/>
    <CollateralType collateralTypeId="VEHICLE" hasTable="N" description="Vehicle (自動車)"/>
    <CollateralType collateralTypeId="DEPOSIT" hasTable="N" description="Deposit (預金)"/>
    <CollateralType collateralTypeId="SECURITIES" hasTable="N" description="Securities (有価証券)"/>

    <!-- ============ Collateral valuation method enumeration ============ -->
    <!-- NOTE: enumTypeId is type "id" (VARCHAR(20)); keep this value <= 20 chars. -->
    <EnumerationType description="Collateral Valuation Method" enumTypeId="COLL_VAL_METHOD" hasTable="N"/>
    <Enumeration description="Appraisal" enumCode="APPRAISAL" enumId="COLL_VAL_APPRAISAL" sequenceId="01" enumTypeId="COLL_VAL_METHOD"/>
    <Enumeration description="Market Value" enumCode="MARKET" enumId="COLL_VAL_MARKET" sequenceId="02" enumTypeId="COLL_VAL_METHOD"/>
    <Enumeration description="Acquisition Cost" enumCode="COST" enumId="COLL_VAL_COST" sequenceId="03" enumTypeId="COLL_VAL_METHOD"/>

    <!-- ============ Collateral status ============ -->
    <StatusType description="Collateral" hasTable="N" statusTypeId="COLLATERAL_STATUS"/>
    <StatusItem description="Registered" sequenceId="01" statusCode="REGISTERED" statusId="COLL_REGISTERED" statusTypeId="COLLATERAL_STATUS"/>
    <StatusItem description="Released" sequenceId="02" statusCode="RELEASED" statusId="COLL_RELEASED" statusTypeId="COLLATERAL_STATUS"/>
    <StatusValidChange statusId="COLL_REGISTERED" statusIdTo="COLL_RELEASED" transitionName="Release"/>
</entity-engine-xml>
