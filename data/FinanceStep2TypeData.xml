<entity-engine-xml>
    <!-- ============ Repayment method enumeration ============ -->
    <!-- NOTE: enumTypeId is type "id" (VARCHAR(20)); keep this value <= 20 chars. -->
    <EnumerationType description="Loan Repayment Method" enumTypeId="LOAN_REPAY_METHOD" hasTable="N"/>
    <Enumeration description="Equal Payment (元利均等)" enumCode="EQUAL_PAYMENT" enumId="LOAN_RPM_EQUAL_PAY" sequenceId="01" enumTypeId="LOAN_REPAY_METHOD"/>
    <Enumeration description="Equal Principal (元金均等)" enumCode="EQUAL_PRINCIPAL" enumId="LOAN_RPM_EQUAL_PRIN" sequenceId="02" enumTypeId="LOAN_REPAY_METHOD"/>

    <!-- ============ FinAccount type for loan accounts ============ -->
    <FinAccountType description="Loan Account" finAccountTypeId="LOAN_ACCOUNT" isRefundable="N"/>

    <!-- ============ Loan quote status ============ -->
    <StatusType description="Loan Quote" hasTable="N" statusTypeId="LOAN_QUOTE_STATUS"/>
    <StatusItem description="Created" sequenceId="01" statusCode="CREATED" statusId="LOANQT_CREATED" statusTypeId="LOAN_QUOTE_STATUS"/>
    <StatusItem description="Presented" sequenceId="02" statusCode="PRESENTED" statusId="LOANQT_PRESENTED" statusTypeId="LOAN_QUOTE_STATUS"/>
    <StatusItem description="Accepted" sequenceId="03" statusCode="ACCEPTED" statusId="LOANQT_ACCEPTED" statusTypeId="LOAN_QUOTE_STATUS"/>
    <StatusItem description="Rejected" sequenceId="04" statusCode="REJECTED" statusId="LOANQT_REJECTED" statusTypeId="LOAN_QUOTE_STATUS"/>
    <StatusValidChange statusId="LOANQT_CREATED" statusIdTo="LOANQT_PRESENTED" transitionName="Present"/>
    <StatusValidChange statusId="LOANQT_PRESENTED" statusIdTo="LOANQT_ACCEPTED" transitionName="Accept"/>
    <StatusValidChange statusId="LOANQT_PRESENTED" statusIdTo="LOANQT_REJECTED" transitionName="Reject"/>

    <!-- ============ Loan underwriting status ============ -->
    <StatusType description="Loan Underwriting" hasTable="N" statusTypeId="LOAN_UW_STATUS"/>
    <StatusItem description="In Review" sequenceId="01" statusCode="IN_REVIEW" statusId="LOANUW_IN_REVIEW" statusTypeId="LOAN_UW_STATUS"/>
    <StatusItem description="Approved" sequenceId="02" statusCode="APPROVED" statusId="LOANUW_APPROVED" statusTypeId="LOAN_UW_STATUS"/>
    <StatusItem description="Rejected" sequenceId="03" statusCode="REJECTED" statusId="LOANUW_REJECTED" statusTypeId="LOAN_UW_STATUS"/>
    <StatusValidChange statusId="LOANUW_IN_REVIEW" statusIdTo="LOANUW_APPROVED" transitionName="Approve"/>
    <StatusValidChange statusId="LOANUW_IN_REVIEW" statusIdTo="LOANUW_REJECTED" transitionName="Reject"/>

    <!-- ============ Loan agreement status ============ -->
    <StatusType description="Loan Agreement" hasTable="N" statusTypeId="LOAN_AGR_STATUS"/>
    <StatusItem description="Draft" sequenceId="01" statusCode="DRAFT" statusId="LOANAGR_DRAFT" statusTypeId="LOAN_AGR_STATUS"/>
    <StatusItem description="Active" sequenceId="02" statusCode="ACTIVE" statusId="LOANAGR_ACTIVE" statusTypeId="LOAN_AGR_STATUS"/>
    <StatusItem description="Closed" sequenceId="03" statusCode="CLOSED" statusId="LOANAGR_CLOSED" statusTypeId="LOAN_AGR_STATUS"/>
    <StatusItem description="Cancelled" sequenceId="04" statusCode="CANCELLED" statusId="LOANAGR_CANCELLED" statusTypeId="LOAN_AGR_STATUS"/>
    <StatusValidChange statusId="LOANAGR_DRAFT" statusIdTo="LOANAGR_ACTIVE" transitionName="Activate"/>
    <StatusValidChange statusId="LOANAGR_DRAFT" statusIdTo="LOANAGR_CANCELLED" transitionName="Cancel"/>
    <StatusValidChange statusId="LOANAGR_ACTIVE" statusIdTo="LOANAGR_CLOSED" transitionName="Close"/>

    <!-- ============ Additional loan application status transitions (STEP 2) ============ -->
    <!-- Allow a submitted application to move into the approval workflow -->
    <StatusItem description="Approved" sequenceId="05" statusCode="APPROVED" statusId="LOANAPP_APPROVED" statusTypeId="LOAN_APP_STATUS"/>
    <StatusItem description="Contracted" sequenceId="06" statusCode="CONTRACTED" statusId="LOANAPP_CONTRACTED" statusTypeId="LOAN_APP_STATUS"/>
    <StatusValidChange statusId="LOANAPP_SUBMITTED" statusIdTo="LOANAPP_APPROVED" transitionName="Approve"/>
    <StatusValidChange statusId="LOANAPP_APPROVED" statusIdTo="LOANAPP_CONTRACTED" transitionName="Contract"/>
    <StatusValidChange statusId="LOANAPP_APPROVED" statusIdTo="LOANAPP_REJECTED" transitionName="Reject"/>
</entity-engine-xml>
