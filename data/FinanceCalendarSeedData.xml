<!--
STEP L15b: business-day calendars (SPEC_COMMON.md 12).

Core TechDataCalendar rows used by the finance due-date adjustment:
- TechDataCalendarWeek: a weekday with capacity 0 (or empty) is closed.
- TechDataCalendarExcDay: capacity 0 = holiday, capacity > 0 = working day.
- A product uses FinancialProductCalendar rows; without rows, finance.properties
  business.calendar.ids (default FIN_JP).

FIN_JP: Japanese bank holidays 2026-2030 (national holidays, substitute and
citizens' holidays, and the year-end / New Year bank holidays Dec 31 - Jan 3).
Dates follow the Cabinet Office list; equinox days from 2027 are provisional
(announced each February for the next year). Update every year and when the
holiday law changes (manufacturing > calendar screens or this file).
-->
<entity-engine-xml>
    <TechDataCalendarWeek calendarWeekId="FIN_WEEK_MON_FRI" description="Finance: Monday to Friday"
            mondayStartTime="09:00:00" mondayCapacity="28800000"
            tuesdayStartTime="09:00:00" tuesdayCapacity="28800000"
            wednesdayStartTime="09:00:00" wednesdayCapacity="28800000"
            thursdayStartTime="09:00:00" thursdayCapacity="28800000"
            fridayStartTime="09:00:00" fridayCapacity="28800000"
            saturdayCapacity="0" sundayCapacity="0"/>
    <TechDataCalendar calendarId="FIN_JP" description="Finance: Japan bank business days" calendarWeekId="FIN_WEEK_MON_FRI"/>

    <SystemProperty systemResourceId="finance" systemPropertyId="business.calendar.ids" systemPropertyValue="FIN_JP"
            description="Default business-day calendars (comma-separated TechDataCalendar ids) for products without FinancialProductCalendar rows"/>

