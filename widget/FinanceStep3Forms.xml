<forms xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Widget-Form" xsi:schemaLocation="http://ofbiz.apache.org/Widget-Form http://ofbiz.apache.org/dtds/widget-form.xsd">

    <!-- Find form for loan agreement list -->
    <form name="FindLoanAgreements" type="single" target="FindLoanAgreement" default-entity-name="LoanAgreement">
        <field name="noConditionFind"><hidden value="Y"/></field>
        <field name="loanAgreementId" title="${uiLabelMap.FinanceLoanAgreementId}"><text-find/></field>
        <field name="borrowerPartyId" title="${uiLabelMap.FinanceApplicantPartyId}"><text-find/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}">
            <drop-down allow-empty="true" current-description="">
                <entity-options key-field-name="statusId" description="${description}" entity-name="StatusItem">
                    <entity-constraint name="statusTypeId" value="LOAN_AGR_STATUS"/>
                    <entity-order-by field-name="sequenceId"/>
                </entity-options>
            </drop-down>
        </field>
        <field name="searchButton"><submit/></field>
    </form>

    <!-- Agreement list -->
    <form name="RunLoanMonthlyAccountingBatch" type="single" target="runLoanMonthlyAccountingBatch">
        <field name="processingDate" title="${uiLabelMap.FinanceProcessingDate}"><date-time type="date"/></field>
        <field name="runButton" title="${uiLabelMap.FinanceRunMonthlyBatch}"><submit button-type="button"/></field>
    </form>

    <grid name="ListLoanAgreements" list-name="listIt" paginate-target="FindLoanAgreement"
            default-entity-name="LoanAgreement" separate-columns="true"
            odd-row-style="alternate-row" header-row-style="header-row-2" default-table-style="basic-table hover-bar">
        <actions>
            <service service-name="performFind" result-map="result" result-map-list="listIt">
                <field-map field-name="inputFields" from-field="parameters"/>
                <field-map field-name="entityName" value="LoanAgreement"/>
                <field-map field-name="orderBy" from-field="parameters.sortField"/>
                <field-map field-name="viewIndex" from-field="viewIndex"/>
                <field-map field-name="viewSize" from-field="viewSize"/>
            </service>
            <set field="sortField" from-field="parameters.sortField"/>
        </actions>
        <field name="loanAgreementId" title="${uiLabelMap.FinanceLoanAgreement}" widget-style="buttontext">
            <hyperlink description="${loanAgreementId}" target="ManageLoanAgreement" also-hidden="false">
                <parameter param-name="loanAgreementId"/>
            </hyperlink>
        </field>
        <field name="borrowerPartyId" title="${uiLabelMap.FinanceApplicantPartyId}" sort-field="true"><display/></field>
        <field name="principalAmount" title="${uiLabelMap.FinanceRequestedPrincipalAmount}"><display type="currency" currency="${currencyUomId}"/></field>
        <field name="annualInterestRate" title="${uiLabelMap.FinanceAnnualInterestRate}">
            <display description="${annualInterestRate * 100}%"/>
        </field>
        <field name="termMonths" title="${uiLabelMap.FinanceRequestedTermMonths}"><display/></field>
        <field name="finAccountId" title="${uiLabelMap.FinanceFinAccountId}"><display/></field>
        <field name="statusId" title="${uiLabelMap.FinanceStatus}" sort-field="true"><display-entity entity-name="StatusItem"/></field>
        <field name="agreementDate" title="${uiLabelMap.FinanceAgreementDate}" sort-field="true"><display/></field>
    </grid>

    <!-- Agreement header -->
    <form name="ViewLoanAgreementHeader" type="single" default-entity-name="LoanAgreement">
        <auto-fields-entity entity-name="LoanAgreement" default-field-type="display"/>
    </form>

    <!-- Confirmed repayment schedule (latest revision) for an agreement.
         The screen must set currentScheduleRevision before including this grid. -->
    <grid name="ListLoanAgreementRepaymentSchedule" list-name="agreementSchedule"
            default-entity-name="LoanAgreementRepaymentSchedule" paginate="false">
        <actions>
            <entity-condition entity-name="LoanAgreementRepaymentSchedule">
                <condition-list combine="and">
                    <condition-expr field-name="loanAgreementId" from-field="loanAgreementId"/>
                    <condition-expr field-name="scheduleRevisionNumber" from-field="currentScheduleRevision"/>
                </condition-list>
                <order-by field-name="installmentNumber"/>
            </entity-condition>
        </actions>
        <field name="installmentNumber" title="${uiLabelMap.FinanceInstallmentNumber}"><display/></field>
        <field name="interestFromDate" title="${uiLabelMap.FinanceInterestFromDate}"><display type="date"/></field>
        <field name="interestThruDate" title="${uiLabelMap.FinanceInterestThruDate}"><display type="date"/></field>
        <field name="dueDate" title="${uiLabelMap.FinanceDueDate}"><display type="date"/></field>
        <field name="paymentAmount" title="${uiLabelMap.FinanceMonthlyPayment}"><display/></field>
        <field name="principalAmount" title="${uiLabelMap.FinancePrincipalPortion}"><display/></field>
        <field name="interestAmount" title="${uiLabelMap.FinanceInterestPortion}"><display/></field>
        <field name="remainingBalance" title="${uiLabelMap.FinanceRemainingBalance}"><display/></field>
    </grid>

    <!-- Run monthly interest accrual -->
    <form name="RunAccrual" type="single" target="runMonthlyInterestAccrual" default-entity-name="LoanAccrual">
        <field name="loanAgreementId"><hidden/></field>
        <field name="accrualDate" title="${uiLabelMap.FinanceApplicationDate}"><date-time type="date"/></field>
        <field name="runButton" title="${uiLabelMap.FinanceRunAccrual}"><submit button-type="button"/></field>
    </form>

    <!-- Create installment invoice -->
    <form name="CreateInstallmentInvoice" type="single" target="createLoanInstallmentInvoice">
        <field name="loanAgreementId"><hidden/></field>
        <field name="installmentNumber" title="${uiLabelMap.FinanceInstallmentNumber}"><text size="6"/></field>
        <field name="createButton" title="${uiLabelMap.FinanceCreateInvoice}"><submit button-type="button"/></field>
    </form>

    <!-- Receive payment -->
    <form name="ReceiveLoanPayment" type="single" target="receiveLoanPayment">
        <field name="loanAgreementId"><hidden/></field>
        <field name="invoiceId" title="${uiLabelMap.FinanceInvoiceId}"><text size="20"/></field>
        <field name="amount" title="${uiLabelMap.FinanceAmount}"><text size="20"/></field>
        <field name="effectiveDate" title="${uiLabelMap.FinanceApplicationDate}"><date-time type="date"/></field>
        <field name="receiveButton" title="${uiLabelMap.FinanceReceivePayment}"><submit button-type="button"/></field>
    </form>

    <!-- Installment invoices for an agreement -->
    <grid name="ListInstallmentInvoices" list-name="installmentInvoices" default-entity-name="LoanInstallmentInvoice" paginate="false">
        <actions>
            <entity-condition entity-name="LoanInstallmentInvoice">
                <condition-expr field-name="loanAgreementId" from-field="loanAgreementId"/>
                <order-by field-name="installmentNumber"/>
            </entity-condition>
        </actions>
        <field name="installmentNumber" title="${uiLabelMap.FinanceInstallmentNumber}"><display/></field>
        <field name="invoiceId" title="${uiLabelMap.FinanceInvoiceId}"><display/></field>
        <field name="dueDate" title="${uiLabelMap.FinanceDueDate}"><display type="date"/></field>
        <field name="principalAmount" title="${uiLabelMap.FinancePrincipalPortion}"><display/></field>
        <field name="interestAmount" title="${uiLabelMap.FinanceInterestPortion}"><display/></field>
        <field name="billedAmount" title="${uiLabelMap.FinanceAmount}"><display/></field>
    </grid>

    <!-- Accruals for an agreement -->
    <grid name="ListLoanAccruals" list-name="accruals" default-entity-name="LoanAccrual" paginate="false">
        <actions>
            <entity-condition entity-name="LoanAccrual">
                <condition-expr field-name="loanAgreementId" from-field="loanAgreementId"/>
                <order-by field-name="accrualDate"/>
            </entity-condition>
        </actions>
        <field name="accrualDate" title="${uiLabelMap.FinanceApplicationDate}"><display type="date"/></field>
        <field name="outstandingPrincipal" title="${uiLabelMap.FinanceRemainingBalance}"><display/></field>
        <field name="interestAmount" title="${uiLabelMap.FinanceInterestPortion}"><display/></field>
        <field name="acctgTransId" title="${uiLabelMap.FinanceAcctgTransId}"><display/></field>
    </grid>

    <!-- Payment receipts for an agreement -->
    <grid name="ListLoanPaymentReceipts" list-name="receipts" default-entity-name="LoanPaymentReceipt" paginate="false">
        <actions>
            <entity-condition entity-name="LoanPaymentReceipt">
                <condition-expr field-name="loanAgreementId" from-field="loanAgreementId"/>
                <order-by field-name="receiptDate"/>
            </entity-condition>
        </actions>
        <field name="receiptDate" title="${uiLabelMap.FinanceApplicationDate}"><display type="date"/></field>
        <field name="paymentId" title="${uiLabelMap.FinanceReceivePayment}"><display/></field>
        <field name="invoiceId" title="${uiLabelMap.FinanceInvoiceId}"><display/></field>
        <field name="amount" title="${uiLabelMap.FinanceAmount}"><display/></field>
    </grid>

</forms>
