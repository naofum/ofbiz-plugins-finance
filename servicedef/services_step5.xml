<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Finance - STEP 5 Services (Business Loans: Credit Line, Guarantor)</description>
    <vendor>OFBiz Finance</vendor>
    <version>1.0</version>

    <!-- ============================================================= -->
    <!-- Credit line CRUD                                              -->
    <!-- ============================================================= -->
    <service name="createCreditLine" default-entity-name="CreditLine" engine="groovy"
            location="component://finance/groovyScripts/CreateCreditLine.groovy" invoke="" auth="true">
        <description>Create a credit line for a business party</description>
        <permission-service service-name="financeGenericPermission" main-action="CREATE"/>
        <auto-attributes include="pk" mode="OUT" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
        <override name="creditLineTypeId" optional="false"/>
        <override name="partyId" optional="false"/>
        <override name="creditLimitAmount" optional="false"/>
    </service>

    <service name="updateCreditLine" default-entity-name="CreditLine" engine="entity-auto" invoke="update" auth="true">
        <description>Update a credit line</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
        <auto-attributes include="nonpk" mode="IN" optional="true"/>
    </service>

    <service name="deleteCreditLine" default-entity-name="CreditLine" engine="entity-auto" invoke="delete" auth="true">
        <description>Delete a credit line</description>
        <permission-service service-name="financeGenericPermission" main-action="DELETE"/>
        <auto-attributes include="pk" mode="IN" optional="false"/>
    </service>

    <!-- ============================================================= -->
    <!-- Loan guarantor (recorded, optional)                           -->
    <!-- ============================================================= -->
    <service name="assignLoanGuarantor" engine="groovy"
            location="component://finance/groovyScripts/AssignLoanGuarantor.groovy" invoke="" auth="true">
        <description>Record a guarantor on a loan application (RECEIVED only)</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="loanApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="guarantorPartyId" type="String" mode="IN" optional="false"/>
        <attribute name="guaranteeTypeEnumId" type="String" mode="IN" optional="true"/>
        <attribute name="guaranteeAmount" type="BigDecimal" mode="IN" optional="true"/>
        <attribute name="currencyUomId" type="String" mode="IN" optional="true"/>
        <attribute name="comments" type="String" mode="IN" optional="true"/>
    </service>

    <service name="removeLoanGuarantor" engine="groovy"
            location="component://finance/groovyScripts/RemoveLoanGuarantor.groovy" invoke="" auth="true">
        <description>Remove a guarantor from a loan application (RECEIVED only)</description>
        <permission-service service-name="financeGenericPermission" main-action="UPDATE"/>
        <attribute name="loanApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="guarantorPartyId" type="String" mode="IN" optional="false"/>
    </service>

    <!-- ============================================================= -->
    <!-- Internal shared credit limit validation                       -->
    <!-- ============================================================= -->
    <service name="financeValidateCreditLimit" engine="groovy" export="false"
            location="component://finance/groovyScripts/ValidateCreditLimit.groovy" invoke="" auth="true">
        <description>Validate that a business applicant's credit line limit is not exceeded</description>
        <attribute name="loanApplicationId" type="String" mode="IN" optional="false"/>
        <attribute name="principalAmount" type="BigDecimal" mode="IN" optional="false"/>
        <attribute name="hasCreditLine" type="Boolean" mode="OUT" optional="true"/>
        <attribute name="creditLimitAmount" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="existingOutstanding" type="BigDecimal" mode="OUT" optional="true"/>
        <attribute name="totalExposure" type="BigDecimal" mode="OUT" optional="true"/>
    </service>

</services>
