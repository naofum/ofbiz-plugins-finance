<entity-engine-xml>
    <!-- Borrower party (person) -->
    <Party partyId="TEST_BORROWER1" partyTypeId="PERSON"/>
    <Person partyId="TEST_BORROWER1" firstName="Test" lastName="Borrower"/>

    <!-- Lender organization reuses the standard demo Company (loaded by base seed/demo). -->

    <!-- A loan product: core Product + FinancialProduct (method B) -->
    <Product productId="TEST_LOANPROD1" productTypeId="SERVICE" internalName="Test Personal Loan" productName="Test Personal Loan"/>
    <FinancialProduct productId="TEST_LOANPROD1" financialProductTypeId="PERSONAL_UNSECURED"
            currencyUomId="USD" minPrincipalAmount="10000" maxPrincipalAmount="1000000"
            minTermMonths="1" maxTermMonths="60" defaultAnnualInterestRate="0.150000" requiresCollateral="N"
            lateFeeAnnualRate="0.146000" prepaymentFeeRate="0.010000"/>

    <!-- Delinquency classification thresholds for the test product -->
    <FinancialProductDelinquency productId="TEST_LOANPROD1" delinquencyLevelEnumId="DELINQ_D1" minDaysPastDue="1" maxDaysPastDue="30" dunningLevelEnumId="DUN_L1" writeoffFlag="N" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="TEST_LOANPROD1" delinquencyLevelEnumId="DELINQ_D2" minDaysPastDue="31" maxDaysPastDue="60" dunningLevelEnumId="DUN_L2" writeoffFlag="N" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="TEST_LOANPROD1" delinquencyLevelEnumId="DELINQ_D3" minDaysPastDue="61" maxDaysPastDue="90" dunningLevelEnumId="DUN_L3" writeoffFlag="Y" legalActionFlag="N"/>
    <FinancialProductDelinquency productId="TEST_LOANPROD1" delinquencyLevelEnumId="DELINQ_D4" minDaysPastDue="91" dunningLevelEnumId="DUN_L4" writeoffFlag="Y" legalActionFlag="Y"/>

    <!-- A received loan application used by the lifecycle tests -->
    <LoanApplication loanApplicationId="TEST_LOANAPP1" productId="TEST_LOANPROD1"
            applicantPartyId="TEST_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="USD"
            requestedPrincipalAmount="120000" requestedTermMonths="12"
            purpose="Quote and underwriting tests"/>
    <LoanApplication loanApplicationId="TEST_LOANAPP_AGR" productId="TEST_LOANPROD1"
            applicantPartyId="TEST_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="USD"
            requestedPrincipalAmount="100000" requestedTermMonths="10"
            purpose="Agreement confirmation test"/>
    <LoanApplication loanApplicationId="TEST_LOANAPP_BILL" productId="TEST_LOANPROD1"
            applicantPartyId="TEST_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="USD"
            requestedPrincipalAmount="60000" requestedTermMonths="6"
            purpose="Billing from confirmed schedule test"/>
    <LoanApplication loanApplicationId="TEST_LOANAPP_ACCRUAL" productId="TEST_LOANPROD1"
            applicantPartyId="TEST_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="USD"
            requestedPrincipalAmount="36000" requestedTermMonths="6"
            purpose="Monthly accrual and recurring billing test"/>

    <!-- Secured loan product (requires collateral, 80% LTV cap) -->
    <Product productId="TEST_SECPROD1" productTypeId="SERVICE" internalName="Test Secured Loan" productName="Test Secured Loan"/>
    <FinancialProduct productId="TEST_SECPROD1" financialProductTypeId="SECURED"
            currencyUomId="USD" minPrincipalAmount="10000" maxPrincipalAmount="1000000"
            minTermMonths="1" maxTermMonths="60" defaultAnnualInterestRate="0.120000"
            requiresCollateral="Y" maxLoanToValueRatio="0.800000"/>

    <!-- A collateral asset (real estate) -->
    <Collateral collateralId="TEST_COLLATERAL1" collateralTypeId="REAL_ESTATE" ownerPartyId="TEST_BORROWER1"
            currencyUomId="USD" description="Test real estate collateral" statusId="COLL_REGISTERED"/>

    <!-- A secured loan application -->
    <LoanApplication loanApplicationId="TEST_LOANAPP_SEC" productId="TEST_SECPROD1"
            applicantPartyId="TEST_BORROWER1" statusId="LOANAPP_RECEIVED" currencyUomId="USD"
            requestedPrincipalAmount="60000" requestedTermMonths="10"
            purpose="Secured loan test"/>

    <!-- Business (organization) borrower, business product and credit line -->
    <Party partyId="TEST_BUSINESS1" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="TEST_BUSINESS1" groupName="Test Business Co."/>

    <Product productId="TEST_BIZPROD1" productTypeId="SERVICE" internalName="Test Business Loan" productName="Test Business Loan"/>
    <FinancialProduct productId="TEST_BIZPROD1" financialProductTypeId="BUSINESS"
            currencyUomId="USD" minPrincipalAmount="10000" maxPrincipalAmount="1000000"
            minTermMonths="1" maxTermMonths="60" defaultAnnualInterestRate="0.100000" requiresCollateral="N"/>

    <CreditLine creditLineId="TEST_CREDLINE1" creditLineTypeId="REVOLVING" partyId="TEST_BUSINESS1"
            currencyUomId="USD" fromDate="2026-01-01 00:00:00.0" creditLimitAmount="100000" description="Test credit line"/>

    <!-- ============ Lease (STEP L1) ============ -->
    <Party partyId="TEST_LESSEE1" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="TEST_LESSEE1" groupName="Test Lessee Co."/>
    <Party partyId="TEST_LS_SUPPLIER1" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="TEST_LS_SUPPLIER1" groupName="Test Equipment Dealer"/>
    <PartyRole partyId="TEST_LS_SUPPLIER1" roleTypeId="SUPPLIER"/>

    <!-- Finance lease (no ownership transfer), equipment only, 12-60 months -->
    <Product productId="TEST_LEASEPROD1" productTypeId="SERVICE" internalName="Test Equipment Lease" productName="Test Equipment Lease"/>
    <FinancialProduct productId="TEST_LEASEPROD1" financialProductTypeId="LEASE_FIN_NONTRANS"
            currencyUomId="JPY" minTermMonths="12" maxTermMonths="60"/>
    <FinancialProductLease productId="TEST_LEASEPROD1" leaseClassEnumId="LEASE_CLS_FIN_NONTR"
            defaultMonthlyRateFactor="0.018000" paymentTimingEnumId="LEASE_PAY_ADVANCE"
            residualValueRate="0" revenueMethodEnumId="LEASE_REV_AT_START" taxable="Y"/>
    <FinancialProductLeaseAssetType productId="TEST_LEASEPROD1" fixedAssetTypeId="EQUIPMENT"/>

    <!-- STEP L3: USD lease product (base currency of Company, no FX conversion in GL)
         and the lease GL accounts of Company (same values as the lease demo data). -->
    <Product productId="TEST_LEASEPROD_USD" productTypeId="SERVICE" internalName="Test Equipment Lease USD" productName="Test Equipment Lease USD"/>
    <FinancialProduct productId="TEST_LEASEPROD_USD" financialProductTypeId="LEASE_FIN_NONTRANS"
            currencyUomId="USD" minTermMonths="12" maxTermMonths="60"/>
    <FinancialProductLease productId="TEST_LEASEPROD_USD" leaseClassEnumId="LEASE_CLS_FIN_NONTR"
            defaultMonthlyRateFactor="0.018000" paymentTimingEnumId="LEASE_PAY_ADVANCE"
            residualValueRate="0" revenueMethodEnumId="LEASE_REV_AT_START" taxable="Y"/>
    <!-- STEP L12: USD operating lease product (residual 20%). -->
    <Product productId="TEST_LEASEPROD_OPER" productTypeId="SERVICE" internalName="Test Operating Lease USD" productName="Test Operating Lease USD"/>
    <FinancialProduct productId="TEST_LEASEPROD_OPER" financialProductTypeId="LEASE_OPERATING"
            currencyUomId="USD" minTermMonths="12" maxTermMonths="60"/>
    <FinancialProductLease productId="TEST_LEASEPROD_OPER" leaseClassEnumId="LEASE_CLS_OPERATING"
            defaultMonthlyRateFactor="0.016000" paymentTimingEnumId="LEASE_PAY_ADVANCE"
            residualValueRate="0.2" revenueMethodEnumId="LEASE_REV_OPERATING" taxable="Y"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_INVESTMENT" glAccountId="128500"/>
    <GlAccountOrganization glAccountId="128500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_RECEIVABLE" glAccountId="128600"/>
    <GlAccountOrganization glAccountId="128600" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_ASSET_SUSPENSE" glAccountId="147500"/>
    <GlAccountOrganization glAccountId="147500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_DEFER_PROFIT" glAccountId="128700"/>
    <GlAccountOrganization glAccountId="128700" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_SALES" glAccountId="403500"/>
    <GlAccountOrganization glAccountId="403500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_COST_OF_SALES" glAccountId="503500"/>
    <GlAccountOrganization glAccountId="503500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_DEFER_PROV" glAccountId="503600"/>
    <GlAccountOrganization glAccountId="503600" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L4: deferred profit release and consumption tax received -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_PROFIT_RELEASE" glAccountId="403600"/>
    <GlAccountOrganization glAccountId="403600" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_TAX_PAYABLE" glAccountId="224500"/>
    <GlAccountOrganization glAccountId="224500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L5: tax receivable (lump sum) and a Japanese consumption tax authority for the tests.
         Rates (TaxAuthorityRateProduct) are created by the tests on a test-only product category. -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_TAX_RECEIVABLE" glAccountId="128800"/>
    <GlAccountOrganization glAccountId="128800" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L7: settlement of the residual value at disposal / transfer -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_DISPOSAL_RECV" glAccountId="128900"/>
    <GlAccountOrganization glAccountId="128900" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_DISPOSAL_GAIN" glAccountId="403700"/>
    <GlAccountOrganization glAccountId="403700" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_DISPOSAL_LOSS" glAccountId="503700"/>
    <GlAccountOrganization glAccountId="503700" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L9: separate component revenue -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_COMP_REVENUE" glAccountId="403800"/>
    <GlAccountOrganization glAccountId="403800" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L10 / L10b: public charge expense (租税公課) and payable (未払租税公課) -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_PCHG_EXPENSE" glAccountId="601500"/>
    <GlAccountOrganization glAccountId="601500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_PCHG_PAYABLE" glAccountId="224600"/>
    <GlAccountOrganization glAccountId="224600" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L11: maintenance revenue (保守料収益) and maintenance cost (保守原価) -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_MAINT_REVENUE" glAccountId="403900"/>
    <GlAccountOrganization glAccountId="403900" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_MAINT_COST" glAccountId="503900"/>
    <GlAccountOrganization glAccountId="503900" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L12: operating lease accounts -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_OPER_ASSET" glAccountId="165500"/>
    <GlAccountOrganization glAccountId="165500" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_OPER_ACCUM_DEP" glAccountId="165900"/>
    <GlAccountOrganization glAccountId="165900" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_OPER_DEPR" glAccountId="503800"/>
    <GlAccountOrganization glAccountId="503800" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_OPER_REVENUE" glAccountId="404000"/>
    <GlAccountOrganization glAccountId="404000" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L13: re-lease -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_RELEASE_UNEARN" glAccountId="224700"/>
    <GlAccountOrganization glAccountId="224700" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_RELEASE_REV" glAccountId="404100"/>
    <GlAccountOrganization glAccountId="404100" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <!-- STEP L14: early termination -->
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_TERM_INCOME" glAccountId="404200"/>
    <GlAccountOrganization glAccountId="404200" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <GlAccountTypeDefault organizationPartyId="Company" glAccountTypeId="LEASE_TERM_LOSS" glAccountId="504200"/>
    <GlAccountOrganization glAccountId="504200" organizationPartyId="Company" fromDate="2001-01-01 00:00:00.0"/>
    <Party partyId="TEST_TAXAUTH_JP" partyTypeId="PARTY_GROUP"/>
    <PartyGroup partyId="TEST_TAXAUTH_JP" groupName="Test Consumption Tax Authority"/>
    <PartyRole partyId="TEST_TAXAUTH_JP" roleTypeId="TAX_AUTHORITY"/>
    <TaxAuthority taxAuthGeoId="JPN" taxAuthPartyId="TEST_TAXAUTH_JP" includeTaxInPrice="N"/>
    <TaxAuthorityGlAccount taxAuthGeoId="JPN" taxAuthPartyId="TEST_TAXAUTH_JP" organizationPartyId="Company" glAccountId="224500"/>
</entity-engine-xml>
