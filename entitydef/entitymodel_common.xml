<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Finance Component Entity Model - Common layer (STEP L0)</title>
    <description>
        Entities shared by the loan and lease layers. FinanceContract is the common
        contract ledger: every loan agreement and lease agreement has exactly one
        FinanceContract row, which carries the customer, the contract type, a
        projected status and the processing lock used to serialize accounting work.
    </description>
    <version>1.0</version>

    <!-- Contract type: LOAN / LEASE -->
    <entity entity-name="FinanceContractType" package-name="org.apache.ofbiz.finance.common"
            title="Finance Contract Type">
        <field name="contractTypeId" type="id"><description>LOAN or LEASE</description></field>
        <field name="description" type="description"></field>
        <prim-key field="contractTypeId"/>
    </entity>

    <!-- Common contract ledger -->
    <entity entity-name="FinanceContract" package-name="org.apache.ofbiz.finance.common"
            title="Finance Contract (common ledger for loan and lease agreements)">
        <field name="financeContractId" type="id"><description>primary sequenced ID</description></field>
        <field name="contractTypeId" type="id"><description>FK to FinanceContractType</description></field>
        <field name="customerPartyId" type="id"><description>borrower (loan) or lessee (lease)</description></field>
        <field name="productId" type="id"><description>financial product of the contract</description></field>
        <field name="statusId" type="id"><description>projected common status (FINANCE_CTR_STATUS); maintained only by the layer status services</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="principalAmount" type="currency-amount"><description>contracted principal (loan) or acquisition cost (lease); used for credit exposure</description></field>
        <field name="contractDate" type="date-time"></field>
        <field name="processingLockVersion" type="numeric"><description>optimistic token used to serialize accrual / billing / payment processing</description></field>
        <field name="parentFinanceContractId" type="id"><description>STEP L10a: parent contract (master agreement: fleet, vendor program, syndication); empty = top level</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="financeContractId"/>
        <relation type="one" fk-name="FINCTR_PARENT" title="Parent" rel-entity-name="FinanceContract">
            <key-map field-name="parentFinanceContractId" rel-field-name="financeContractId"/>
        </relation>
        <relation type="many" title="Child" rel-entity-name="FinanceContract">
            <key-map field-name="financeContractId" rel-field-name="parentFinanceContractId"/>
        </relation>
        <relation type="one" fk-name="FINCTR_TYPE" rel-entity-name="FinanceContractType">
            <key-map field-name="contractTypeId"/>
        </relation>
        <relation type="one" fk-name="FINCTR_PARTY" rel-entity-name="Party">
            <key-map field-name="customerPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="FINCTR_PROD" rel-entity-name="Product">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="FINCTR_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="one" fk-name="FINCTR_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
        <index name="FINCTR_CUST_IDX">
            <index-field name="customerPartyId"/>
        </index>
        <index name="FINCTR_PARENT_IDX">
            <index-field name="parentFinanceContractId"/>
        </index>
    </entity>

    <!-- ========================================================= -->
    <!-- STEP L10a: parties of a contract (contract x party x role -->
    <!-- x share, effective-dated). Additive: the layer agreements -->
    <!-- keep their own party columns, which existing processing   -->
    <!-- still reads. Roles are core RoleType rows under           -->
    <!-- FIN_CTR_ROLE.                                             -->
    <!-- ========================================================= -->
    <entity entity-name="FinanceContractParty" package-name="org.apache.ofbiz.finance.common"
            title="Finance Contract - party in a role (with share)">
        <field name="financeContractId" type="id"></field>
        <field name="partyId" type="id"></field>
        <field name="roleTypeId" type="id"><description>core RoleType under FIN_CTR_ROLE (lessee, lessor, borrower, lender, participant, ...)</description></field>
        <field name="fromDate" type="date-time"></field>
        <field name="thruDate" type="date-time"><description>empty = still effective</description></field>
        <field name="shareRate" type="fixed-point"><description>share of the role (0 &lt; share &lt;= 1, e.g. 1.000000 = 100%); empty = not shared</description></field>
        <field name="isPrimary" type="indicator"><description>Y for the party registered from the layer agreement (borrower / lessee / lender / lessor)</description></field>
        <field name="comments" type="comment"></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="financeContractId"/>
        <prim-key field="partyId"/>
        <prim-key field="roleTypeId"/>
        <prim-key field="fromDate"/>
        <relation type="one" fk-name="FINCTRPTY_CTR" rel-entity-name="FinanceContract">
            <key-map field-name="financeContractId"/>
        </relation>
        <relation type="one" fk-name="FINCTRPTY_PARTY" rel-entity-name="Party">
            <key-map field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="FINCTRPTY_ROLE" rel-entity-name="RoleType">
            <key-map field-name="roleTypeId"/>
        </relation>
        <index name="FINCTRPTY_PARTY_IDX">
            <index-field name="partyId"/>
            <index-field name="roleTypeId"/>
        </index>
    </entity>

    <!-- Product list for the shared product screen (STEP L1): financial product,
         its type and parent type (LOAN / LEASE root) and the core product name. -->
    <view-entity entity-name="FinancialProductAndType" package-name="org.apache.ofbiz.finance.common"
            title="Financial Product with type and product name">
        <member-entity entity-alias="FP" entity-name="FinancialProduct"/>
        <member-entity entity-alias="FPT" entity-name="FinancialProductType"/>
        <member-entity entity-alias="PR" entity-name="Product"/>
        <alias-all entity-alias="FP"/>
        <alias entity-alias="FPT" name="parentTypeId"/>
        <alias entity-alias="FPT" name="typeDescription" field="description"/>
        <alias entity-alias="PR" name="productName"/>
        <view-link entity-alias="FP" rel-entity-alias="FPT">
            <key-map field-name="financialProductTypeId"/>
        </view-link>
        <view-link entity-alias="FP" rel-entity-alias="PR">
            <key-map field-name="productId"/>
        </view-link>
    </view-entity>

    <!-- ========================================================= -->
    <!-- STEP L7: work management (core WorkEffort tasks per contract) -->
    <!-- ========================================================= -->
    <entity entity-name="FinanceContractWorkEffort" package-name="org.apache.ofbiz.finance.common"
            title="Finance Contract - work effort (task)">
        <field name="financeContractId" type="id"></field>
        <field name="workEffortId" type="id"><description>core WorkEffort (TASK)</description></field>
        <field name="financeWorkTypeEnumId" type="id"><description>FINANCE_WORK_TYPE (FINWE_*)</description></field>
        <field name="triggerKey" type="short-varchar"><description>what created the task (e.g. lease end date, asset seq id); one task per contract x work type x trigger</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="financeContractId"/>
        <prim-key field="workEffortId"/>
        <relation type="one" fk-name="FINCTRWE_CTR" rel-entity-name="FinanceContract">
            <key-map field-name="financeContractId"/>
        </relation>
        <relation type="one" fk-name="FINCTRWE_WE" rel-entity-name="WorkEffort">
            <key-map field-name="workEffortId"/>
        </relation>
        <relation type="one" fk-name="FINCTRWE_TYPE" rel-entity-name="Enumeration">
            <key-map field-name="financeWorkTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <index name="FINCTRWE_TRIGGER_UQ" unique="true">
            <index-field name="financeContractId"/>
            <index-field name="financeWorkTypeEnumId"/>
            <index-field name="triggerKey"/>
        </index>
    </entity>
    <!-- ========================================================= -->
    <!-- STEP L15a: reversal of a mistaken operation (取消). One row -->
    <!-- per reversal: what was reversed, why, by whom, and the      -->
    <!-- reversing GL transactions. The original records stay (or a  -->
    <!-- snapshot is kept here when the row had to be removed).      -->
    <!-- ========================================================= -->
    <entity entity-name="FinanceReversal" package-name="org.apache.ofbiz.finance.common"
            title="Finance reversal (取消)">
        <field name="financeReversalId" type="id"><description>primary sequenced ID</description></field>
        <field name="financeContractId" type="id"></field>
        <field name="reversalTypeEnumId" type="id"><description>FINANCE_REV_TYPE (FINREV_*)</description></field>
        <field name="referenceId" type="id"><description>id of the reversed record (agreement, LeaseModification, LoanPrepayment, LoanModification)</description></field>
        <field name="operationDate" type="date-time"><description>date of the reversed operation (acceptance, termination, ...)</description></field>
        <field name="reason" type="description"><description>required reason</description></field>
        <field name="reversalDate" type="date-time"></field>
        <field name="reversedByUserLogin" type="id-vlong"></field>
        <field name="reversingAcctgTransIds" type="very-long"><description>comma-separated reversing AcctgTrans ids (finance entries)</description></field>
        <field name="snapshot" type="very-long"><description>key=value lines of the removed record (e.g. LeaseAcceptance, LeaseTermination)</description></field>
        <field name="createdDate" type="date-time"></field>
        <prim-key field="financeReversalId"/>
        <relation type="one" fk-name="FINREV_CTR" rel-entity-name="FinanceContract">
            <key-map field-name="financeContractId"/>
        </relation>
        <relation type="one" fk-name="FINREV_TYPE" rel-entity-name="Enumeration">
            <key-map field-name="reversalTypeEnumId" rel-field-name="enumId"/>
        </relation>
        <index name="FINREV_CTR_IDX">
            <index-field name="financeContractId"/>
        </index>
    </entity>
    <!-- ========================================================= -->
    <!-- STEP L15b: business-day calendars of a financial product. -->
    <!-- A product may use several core TechDataCalendar rows; a   -->
    <!-- day is a business day only when every calendar is open.   -->
    <!-- No row = the default (finance.properties                  -->
    <!-- business.calendar.ids), else Saturday/Sunday only.        -->
    <!-- ========================================================= -->
    <entity entity-name="FinancialProductCalendar" package-name="org.apache.ofbiz.finance.common"
            title="Business-day calendar of a financial product">
        <field name="productId" type="id"></field>
        <field name="calendarId" type="id"><description>core TechDataCalendar</description></field>
        <prim-key field="productId"/>
        <prim-key field="calendarId"/>
        <relation type="one" fk-name="FINPRODCAL_PROD" rel-entity-name="FinancialProduct">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="FINPRODCAL_CAL" rel-entity-name="TechDataCalendar">
            <key-map field-name="calendarId"/>
        </relation>
    </entity>
</entitymodel>
