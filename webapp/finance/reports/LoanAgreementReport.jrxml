    Loan agreement (契約書) report.  Rendered by the generic jasperreports view
    handler.  Data is supplied at run time from the OFBiz entity engine:
      - header values via report parameters (request attribute "jrParameters")
      - confirmed repayment schedule rows (latest revision) via
        JRMapCollectionDataSource (request attribute "jrDataSource")
    JasperReports 7.x native JRXML syntax.
-->
<jasperReport name="LoanAgreementReport"
              pageWidth="842" pageHeight="595"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              orientation="Landscape"
              whenNoDataType="AllSectionsNoDetail"
              uuid="a1b2c3d4-1e2f-4a3b-8c4d-2e3f4a5b6c7d">

    <!-- CJK font (Japanese) via OpenPDF built-in; requires openpdf-fonts-extra. -->
    <style name="base" default="true" pdfFontName="HeiseiKakuGo-W5" pdfEncoding="UniJIS-UCS2-H" pdfEmbedded="true"/>

    <!-- ===== Header parameters ===== -->
    <parameter name="lenderName"           class="java.lang.String"/>
    <parameter name="lenderAddress"        class="java.lang.String"/>
    <parameter name="borrowerName"         class="java.lang.String"/>
    <parameter name="loanAgreementId"      class="java.lang.String"/>
    <parameter name="loanApplicationId"    class="java.lang.String"/>
    <parameter name="loanQuoteId"          class="java.lang.String"/>
    <parameter name="currencyUomId"        class="java.lang.String"/>
    <parameter name="principalAmount"      class="java.math.BigDecimal"/>
    <parameter name="annualInterestRate"   class="java.math.BigDecimal"/>
    <parameter name="termMonths"           class="java.math.BigDecimal"/>
    <parameter name="repaymentMethod"      class="java.lang.String"/>
    <parameter name="agreementDate"        class="java.sql.Timestamp"/>
    <parameter name="firstPaymentDate"     class="java.sql.Timestamp"/>
    <parameter name="logoPath"             class="java.lang.String"/>
    <parameter name="scheduleRevision"     class="java.lang.Long"/>

    <!-- Localized label parameters -->
    <parameter name="FinanceAgreementPdfTitle"            class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfAgreementNo"      class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfAgreementDate"    class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfFirstPaymentDate" class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfLender"           class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfBorrower"         class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfPrincipal"        class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfAnnualRate"       class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfTermMonths"       class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfRepaymentMethod"  class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfCurrency"         class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfScheduleTitle"    class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColInstallment"   class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColFromDate"      class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColThruDate"      class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColDueDate"       class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColPayment"       class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColPrincipal"     class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColInterest"      class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfColBalance"       class="java.lang.String"/>
    <parameter name="FinanceAgreementPdfPage"             class="java.lang.String"/>

    <!-- ===== Fields (one per schedule row Map key) ===== -->
    <field name="installmentNumber" class="java.math.BigDecimal"/>
    <field name="interestFromDate"  class="java.sql.Timestamp"/>
    <field name="interestThruDate"  class="java.sql.Timestamp"/>
    <field name="dueDate"           class="java.sql.Timestamp"/>
    <field name="paymentAmount"     class="java.math.BigDecimal"/>
    <field name="principalAmount"   class="java.math.BigDecimal"/>
    <field name="interestAmount"    class="java.math.BigDecimal"/>
    <field name="remainingBalance"  class="java.math.BigDecimal"/>

    <!-- ===== Title band: logo + heading + agreement header block ===== -->
    <title height="280">
        <!-- Logo -->
        <element kind="image" x="0" y="0" width="140" height="40"
                 scaleImage="RetainShape" hImageAlign="Left" vImageAlign="Middle">
            <expression><![CDATA[$P{logoPath}]]></expression>
            <printWhenExpression><![CDATA[$P{logoPath} != null]]></printWhenExpression>
        </element>

        <!-- Title -->
        <element kind="textField" x="150" y="0" width="652" height="40"
                 fontSize="24.0" bold="true" hTextAlign="Right" vTextAlign="Middle">
            <expression><![CDATA[$P{FinanceAgreementPdfTitle}]]></expression>
        </element>

        <element kind="line" x="0" y="46" width="802" height="1"/>

        <!-- Agreement No + Date -->
        <element kind="textField" x="0" y="54" width="120" height="18" fontSize="11.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfAgreementNo}]]></expression>
        </element>
        <element kind="textField" x="125" y="54" width="200" height="18" fontSize="11.0">
            <expression><![CDATA[$P{loanAgreementId}]]></expression>
        </element>
        <element kind="textField" x="400" y="54" width="150" height="18" fontSize="11.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfAgreementDate}]]></expression>
        </element>
        <element kind="textField" x="555" y="54" width="247" height="18" fontSize="11.0" pattern="yyyy-MM-dd">
            <expression><![CDATA[$P{agreementDate}]]></expression>
        </element>

        <!-- Lender -->
        <element kind="textField" x="0" y="80" width="120" height="18" fontSize="11.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfLender}]]></expression>
        </element>
        <element kind="textField" x="125" y="80" width="677" height="18" fontSize="11.0">
            <expression><![CDATA[$P{lenderName}]]></expression>
        </element>
        <element kind="textField" x="125" y="98" width="677" height="16" fontSize="9.0">
            <expression><![CDATA[$P{lenderAddress}]]></expression>
            <printWhenExpression><![CDATA[$P{lenderAddress} != null]]></printWhenExpression>
        </element>

        <!-- Borrower -->
        <element kind="textField" x="0" y="120" width="120" height="18" fontSize="11.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfBorrower}]]></expression>
        </element>
        <element kind="textField" x="125" y="120" width="677" height="18" fontSize="11.0">
            <expression><![CDATA[$P{borrowerName}]]></expression>
        </element>

        <element kind="line" x="0" y="146" width="802" height="1"/>

        <!-- Terms: row 1 — Principal / Annual Rate -->
        <element kind="textField" x="0" y="154" width="150" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfPrincipal}]]></expression>
        </element>
        <element kind="textField" x="150" y="154" width="180" height="16" fontSize="10.0" hTextAlign="Right" pattern="#,##0">
            <expression><![CDATA[$P{principalAmount}]]></expression>
        </element>
        <element kind="textField" x="360" y="154" width="150" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfAnnualRate}]]></expression>
        </element>
        <element kind="textField" x="510" y="154" width="100" height="16" fontSize="10.0" hTextAlign="Right" pattern="#0.000%">
            <expression><![CDATA[$P{annualInterestRate}]]></expression>
        </element>
        <element kind="textField" x="620" y="154" width="100" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfCurrency}]]></expression>
        </element>
        <element kind="textField" x="720" y="154" width="82" height="16" fontSize="10.0" hTextAlign="Right">
            <expression><![CDATA[$P{currencyUomId}]]></expression>
        </element>

        <!-- Terms: row 2 — Term / Repayment Method -->
        <element kind="textField" x="0" y="172" width="150" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfTermMonths}]]></expression>
        </element>
        <element kind="textField" x="150" y="172" width="180" height="16" fontSize="10.0" hTextAlign="Right" pattern="#,##0">
            <expression><![CDATA[$P{termMonths}]]></expression>
        </element>
        <element kind="textField" x="360" y="172" width="150" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfRepaymentMethod}]]></expression>
        </element>
        <element kind="textField" x="510" y="172" width="292" height="16" fontSize="10.0" hTextAlign="Right">
            <expression><![CDATA[$P{repaymentMethod}]]></expression>
        </element>

        <!-- Terms: row 3 — First Payment Date -->
        <element kind="textField" x="0" y="190" width="150" height="16" fontSize="10.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfFirstPaymentDate}]]></expression>
        </element>
        <element kind="textField" x="150" y="190" width="180" height="16" fontSize="10.0" pattern="yyyy-MM-dd">
            <expression><![CDATA[$P{firstPaymentDate}]]></expression>
        </element>

        <element kind="line" x="0" y="214" width="802" height="1"/>

        <!-- Schedule section title -->
        <element kind="textField" x="0" y="220" width="802" height="20" fontSize="12.0" bold="true">
            <expression><![CDATA[$P{FinanceAgreementPdfScheduleTitle}]]></expression>
        </element>
    </title>

    <!-- ===== Column headers for the confirmed repayment schedule ===== -->
    <columnHeader height="22">
        <!-- No. -->
        <element kind="textField" x="0" y="2" width="40" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColInstallment}]]></expression>
        </element>
        <!-- Interest From -->
        <element kind="textField" x="40" y="2" width="100" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColFromDate}]]></expression>
        </element>
        <!-- Interest Thru -->
        <element kind="textField" x="140" y="2" width="100" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColThruDate}]]></expression>
        </element>
        <!-- Due Date -->
        <element kind="textField" x="240" y="2" width="100" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColDueDate}]]></expression>
        </element>
        <!-- Payment -->
        <element kind="textField" x="340" y="2" width="116" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColPayment}]]></expression>
        </element>
        <!-- Principal -->
        <element kind="textField" x="456" y="2" width="116" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColPrincipal}]]></expression>
        </element>
        <!-- Interest -->
        <element kind="textField" x="572" y="2" width="115" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColInterest}]]></expression>
        </element>
        <!-- Balance -->
        <element kind="textField" x="687" y="2" width="115" height="18"
                 fontSize="9.0" bold="true" hTextAlign="Center" vTextAlign="Middle"
                 mode="Opaque" backcolor="#E6E6E6">
            <expression><![CDATA[$P{FinanceAgreementPdfColBalance}]]></expression>
        </element>
    </columnHeader>

    <!-- ===== Detail: one row per confirmed repayment installment ===== -->
    <detail>
        <band height="18">
            <element kind="textField" x="0" y="0" width="40" height="16"
                     fontSize="9.0" hTextAlign="Center" pattern="#,##0">
                <expression><![CDATA[$F{installmentNumber}]]></expression>
            </element>
            <element kind="textField" x="40" y="0" width="100" height="16"
                     fontSize="9.0" hTextAlign="Center" pattern="yyyy-MM-dd">
                <expression><![CDATA[$F{interestFromDate}]]></expression>
            </element>
            <element kind="textField" x="140" y="0" width="100" height="16"
                     fontSize="9.0" hTextAlign="Center" pattern="yyyy-MM-dd">
                <expression><![CDATA[$F{interestThruDate}]]></expression>
            </element>
            <element kind="textField" x="240" y="0" width="100" height="16"
                     fontSize="9.0" hTextAlign="Center" pattern="yyyy-MM-dd">
                <expression><![CDATA[$F{dueDate}]]></expression>
            </element>
            <element kind="textField" x="340" y="0" width="116" height="16"
                     fontSize="9.0" hTextAlign="Right" pattern="#,##0">
                <expression><![CDATA[$F{paymentAmount}]]></expression>
            </element>
            <element kind="textField" x="456" y="0" width="116" height="16"
                     fontSize="9.0" hTextAlign="Right" pattern="#,##0">
                <expression><![CDATA[$F{principalAmount}]]></expression>
            </element>
            <element kind="textField" x="572" y="0" width="115" height="16"
                     fontSize="9.0" hTextAlign="Right" pattern="#,##0">
                <expression><![CDATA[$F{interestAmount}]]></expression>
            </element>
            <element kind="textField" x="687" y="0" width="115" height="16"
                     fontSize="9.0" hTextAlign="Right" pattern="#,##0">
                <expression><![CDATA[$F{remainingBalance}]]></expression>
            </element>
            <element kind="line" x="0" y="17" width="802" height="1" forecolor="#CCCCCC"/>
        </band>
    </detail>

    <!-- ===== Page footer ===== -->
    <pageFooter height="20">
        <element kind="textField" x="702" y="0" width="100" height="15"
                 fontSize="9.0" hTextAlign="Right">
            <expression><![CDATA[$V{PAGE_NUMBER} + " " + $P{FinanceAgreementPdfPage}]]></expression>
        </element>
    </pageFooter>

</jasperReport>
