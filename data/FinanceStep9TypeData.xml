<entity-engine-xml>
    <!-- ============================================================ -->
    <!-- Interest period endpoint convention (利息計算期間の端算入)     -->
    <!-- NOTE: enumTypeId is type "id" (VARCHAR(20)); <= 20 chars.    -->
    <!-- ============================================================ -->
    <EnumerationType description="Loan Interest Period Endpoint Convention" enumTypeId="LOAN_PERIOD_ENDPT" hasTable="N"/>
    <!-- 両端算入 [from, to]: days = to - from + 1 -->
    <Enumeration description="Both ends inclusive [from, to] (両端算入)" enumCode="BOTH"
                 enumId="PERIOD_BOTH" sequenceId="01" enumTypeId="LOAN_PERIOD_ENDPT"/>
    <!-- 後落とし [from, to): days = to - from (期末日を含まない。日本の銀行慣行) -->
    <Enumeration description="Back-end exclusive [from, to) / 後落とし (日本標準)" enumCode="BACK_EXCL"
                 enumId="PERIOD_BACK_EXCL" sequenceId="02" enumTypeId="LOAN_PERIOD_ENDPT"/>
    <!-- 前落とし (from, to]: days = to - from (期首日を含まない) -->
    <Enumeration description="Front-end exclusive (from, to] / 前落とし" enumCode="FRONT_EXCL"
                 enumId="PERIOD_FRONT_EXCL" sequenceId="03" enumTypeId="LOAN_PERIOD_ENDPT"/>

    <!-- ============================================================ -->
    <!-- Due-date business-day adjustment convention (営業日調整方式)  -->
    <!-- ============================================================ -->
    <EnumerationType description="Loan Due-Date Business-Day Adjustment Convention" enumTypeId="LOAN_DUEDATE_CONV" hasTable="N"/>
    <!-- 調整なし (現行挙動) -->
    <Enumeration description="No adjustment (調整なし)" enumCode="NONE"
                 enumId="DUEDATE_NONE" sequenceId="01" enumTypeId="LOAN_DUEDATE_CONV"/>
    <!-- 翌営業日 (Following) -->
    <Enumeration description="Following business day (翌営業日)" enumCode="FOLLOWING"
                 enumId="DUEDATE_FOLLOWING" sequenceId="02" enumTypeId="LOAN_DUEDATE_CONV"/>
    <!-- 前営業日 (Preceding) -->
    <Enumeration description="Preceding business day (前営業日)" enumCode="PRECEDING"
                 enumId="DUEDATE_PRECEDING" sequenceId="03" enumTypeId="LOAN_DUEDATE_CONV"/>
    <!-- Modified Following: 翌営業日が翌月になる場合は前営業日 -->
    <Enumeration description="Modified Following - preceding if month changes (月末は前営業日)" enumCode="MOD_FOLLOW"
                 enumId="DUEDATE_MOD_FOLLOW" sequenceId="04" enumTypeId="LOAN_DUEDATE_CONV"/>

    <!-- ============================================================ -->
    <!-- SystemProperty defaults                                       -->
    <!-- ============================================================ -->
    <!-- System-wide default period endpoint: 両端算入 (backward-compatible) -->
    <SystemProperty systemResourceId="finance" systemPropertyId="interest.period.endpoint"
                    systemPropertyValue="PERIOD_BOTH"
                    description="Default interest period endpoint convention (enumId from LOAN_PERIOD_ENDPT)"/>
    <!-- System-wide default due-date adjustment: 調整なし (backward-compatible) -->
    <SystemProperty systemResourceId="finance" systemPropertyId="duedate.convention"
                    systemPropertyValue="DUEDATE_NONE"
                    description="Default due-date business-day adjustment convention (enumId from LOAN_DUEDATE_CONV)"/>
</entity-engine-xml>
