<entity-engine-xml>
    <!-- Finance security permissions -->
    <SecurityPermission description="View operations in the Finance Management Screens." permissionId="FINANCE_VIEW"/>
    <SecurityPermission description="Create operations in the Finance Management Screens." permissionId="FINANCE_CREATE"/>
    <SecurityPermission description="Update operations in the Finance Management Screens." permissionId="FINANCE_UPDATE"/>
    <SecurityPermission description="Delete operations in the Finance Management Screens." permissionId="FINANCE_DELETE"/>
    <SecurityPermission description="ALL operations in the Finance Management Screens." permissionId="FINANCE_ADMIN"/>
    <SecurityPermission description="Post loan accrual accounting transactions." permissionId="FINANCE_ACCOUNTING_CREATE"/>
    <SecurityPermission description="Create loan installment invoices." permissionId="FINANCE_BILLING_CREATE"/>
    <SecurityPermission description="Receive and apply loan payments." permissionId="FINANCE_PAYMENT_CREATE"/>

    <SecurityGroup description="Finance loan accounting operators" groupId="FINANCE_ACCOUNTING"/>
    <SecurityGroup description="Finance loan billing operators" groupId="FINANCE_BILLING"/>
    <SecurityGroup description="Finance loan payment operators" groupId="FINANCE_PAYMENT"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_ACCOUNTING" permissionId="FINANCE_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_ACCOUNTING" permissionId="FINANCE_ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_ACCOUNTING" permissionId="ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_ACCOUNTING" permissionId="ACCTG_ATX_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_BILLING" permissionId="FINANCE_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_BILLING" permissionId="FINANCE_BILLING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_BILLING" permissionId="ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_BILLING" permissionId="ACCTG_ATX_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_PAYMENT" permissionId="FINANCE_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_PAYMENT" permissionId="FINANCE_PAYMENT_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_PAYMENT" permissionId="ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FINANCE_PAYMENT" permissionId="ACCTG_ATX_CREATE"/>

    <!-- super user -->
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="SUPER" permissionId="FINANCE_ADMIN"/>

    <!-- Stock administrative groups (the demo "admin" user belongs to FULLADMIN,
         not SUPER), so grant them FINANCE_ADMIN too. Without this, admin cannot
         pass the finance webapp base-permission "OFBTOOLS,FINANCE". -->
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FULLADMIN" permissionId="FINANCE_ADMIN"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="FINANCE_ADMIN"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="SUPER" permissionId="FINANCE_ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="SUPER" permissionId="FINANCE_BILLING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="SUPER" permissionId="FINANCE_PAYMENT_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FULLADMIN" permissionId="FINANCE_ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FULLADMIN" permissionId="FINANCE_BILLING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FULLADMIN" permissionId="FINANCE_PAYMENT_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="FINANCE_ACCOUNTING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="FINANCE_BILLING_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="FINANCE_PAYMENT_CREATE"/>
</entity-engine-xml>
