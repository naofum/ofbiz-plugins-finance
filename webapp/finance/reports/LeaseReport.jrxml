    Lease quote / lease agreement report (STEP L2), rendered by the generic
    jasperreports view handler. Header values come from report parameters
    (request attribute "jrParameters"), payment schedule rows from a
    JRMapCollectionDataSource (request attribute "jrDataSource"), both prepared by
    groovyScripts/lease/PrepareLeaseReport.groovy. JasperReports 7.x native JRXML.
-->
<jasperReport name="LeaseReport" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" uuid="c3d4e5f6-1a2b-4c3d-8e4f-2b3c4d5e6f70">

    <style name="base" default="true" pdfFontName="HeiseiKakuGo-W5" pdfEncoding="UniJIS-UCS2-H" pdfEmbedded="true"/>

