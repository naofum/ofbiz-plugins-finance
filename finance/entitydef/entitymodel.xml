<entitymodel xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/entitymodel.xsd">
    <title>Finance Component Entity Model - STEP 1 (Loan products and applications)</title>
    <description>
        Based on The Data Model Resource Book - Financial Services.
        Method B: FinancialProduct references the core Product entity (1:1) instead of
        modifying Product. Targets personal unsecured loans first, with a type-based
        structure that extends to secured and business loans later.
    </description>
    <version>1.0</version>

    <!-- ========================================================= -->
    <!-- Loan product type (unsecured / secured / business)        -->
    <!-- ========================================================= -->
    <entity entity-name="FinancialProductType" package-name="org.apache.ofbiz.finance.product"
            title="Financial Product Type">
        <field name="financialProductTypeId" type="id"><description>e.g. PERSONAL_UNSECURED, SECURED, BUSINESS</description></field>
        <field name="parentTypeId" type="id"><description>for hierarchical types</description></field>
        <field name="hasTable" type="indicator"></field>
        <field name="description" type="description"></field>
        <prim-key field="financialProductTypeId"/>
        <relation type="one" title="Parent" fk-name="FINPRODTYP_PAR" rel-entity-name="FinancialProductType">
            <key-map field-name="parentTypeId" rel-field-name="financialProductTypeId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- FinancialProduct: 1:1 extension of core Product (Method B) -->
    <!-- ========================================================= -->
    <entity entity-name="FinancialProduct" package-name="org.apache.ofbiz.finance.product"
            title="Financial Product (references core Product 1:1)">
        <field name="productId" type="id"><description>FK to core Product.productId (1:1)</description></field>
        <field name="financialProductTypeId" type="id"></field>
        <field name="currencyUomId" type="id"><description>FK to Uom (currency)</description></field>
        <field name="minPrincipalAmount" type="currency-amount"><description>minimum loan principal</description></field>
        <field name="maxPrincipalAmount" type="currency-amount"><description>maximum loan principal</description></field>
        <field name="minTermMonths" type="numeric"><description>minimum repayment term in months</description></field>
        <field name="maxTermMonths" type="numeric"><description>maximum repayment term in months</description></field>
        <field name="defaultAnnualInterestRate" type="fixed-point"><description>annual nominal interest rate (e.g. 0.150000 = 15%)</description></field>
        <field name="requiresCollateral" type="indicator"><description>Y for secured loans</description></field>
        <prim-key field="productId"/>
        <relation type="one" fk-name="FINPROD_PROD" rel-entity-name="Product">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="FINPROD_TYP" rel-entity-name="FinancialProductType">
            <key-map field-name="financialProductTypeId"/>
        </relation>
        <relation type="one" fk-name="FINPROD_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
    </entity>

    <!-- ========================================================= -->
    <!-- LoanApplication: a loan application received from a party  -->
    <!-- ========================================================= -->
    <entity entity-name="LoanApplication" package-name="org.apache.ofbiz.finance.application"
            title="Loan Application">
        <field name="loanApplicationId" type="id"><description>primary sequenced ID</description></field>
        <field name="productId" type="id"><description>applied-for financial product (FK to FinancialProduct/Product)</description></field>
        <field name="applicantPartyId" type="id"><description>FK to Party (applicant: person or organization)</description></field>
        <field name="statusId" type="id"><description>FK to StatusItem (LoanApplication status)</description></field>
        <field name="currencyUomId" type="id"></field>
        <field name="requestedPrincipalAmount" type="currency-amount"></field>
        <field name="requestedTermMonths" type="numeric"></field>
        <field name="applicationDate" type="date-time"></field>
        <field name="purpose" type="description"><description>purpose of the loan</description></field>
        <field name="comments" type="comment"></field>
        <prim-key field="loanApplicationId"/>
        <relation type="one" fk-name="LOANAPP_PROD" rel-entity-name="FinancialProduct">
            <key-map field-name="productId"/>
        </relation>
        <relation type="one" fk-name="LOANAPP_PARTY" rel-entity-name="Party">
            <key-map field-name="applicantPartyId" rel-field-name="partyId"/>
        </relation>
        <relation type="one" fk-name="LOANAPP_STTS" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
        <relation type="one" fk-name="LOANAPP_UOM" rel-entity-name="Uom">
            <key-map field-name="currencyUomId" rel-field-name="uomId"/>
        </relation>
    </entity>

    <!-- Status history for a loan application (audit of status transitions) -->
    <entity entity-name="LoanApplicationStatus" package-name="org.apache.ofbiz.finance.application"
            title="Loan Application Status History">
        <field name="loanApplicationId" type="id"></field>
        <field name="statusId" type="id"></field>
        <field name="statusDate" type="date-time"></field>
        <field name="changeByUserLoginId" type="id-vlong"></field>
        <prim-key field="loanApplicationId"/>
        <prim-key field="statusId"/>
        <prim-key field="statusDate"/>
        <relation type="one" fk-name="LOANAPPST_APP" rel-entity-name="LoanApplication">
            <key-map field-name="loanApplicationId"/>
        </relation>
        <relation type="one" fk-name="LOANAPPST_ST" rel-entity-name="StatusItem">
            <key-map field-name="statusId"/>
        </relation>
    </entity>

</entitymodel>
